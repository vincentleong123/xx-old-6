:8120 {
    # Global Security & Obfuscation Headers
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options SAMEORIGIN
        X-XSS-Protection "1; mode=block"
        Referrer-Policy no-referrer-when-downgrade
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        -Server # Removes the "Server: Caddy" header
    }

    # 2. Static File Serving ONLY for Thumbnails
    # This strips "/thumbnails" from the request path and looks inside C:/thumbnails
    handle_path /thumbnails/* {
        root * C:/thumbnails
        file_server
        
        # Optimized for heavy lazy-loading/scrolling (Cache for 7 days)
        header Cache-Control "public, max-age=604800, must-revalidate"
    }

    # 3. Main Application Reverse Proxy (Handles all other static files, views, and API routes via Express)
    handle {
        reverse_proxy localhost:7004 {
            transport http {
                keepalive 30s
                keepalive_idle_conns 100
            }
        }
    }
}