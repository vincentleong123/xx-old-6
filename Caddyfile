:8123 {
    # 1. Handle the www redirect at the application layer
    @www header_regexp host Host ^www\.(.+)
    redir @www https://{re.host.1}{uri} permanent

    # 2. Static File Serving for Thumbnails
    handle_path /thumbnails/* {
        root * C:/thumbnails
        file_server
        header Cache-Control "public, max-age=86400, stale-while-revalidate=604800"
    }

    # 3. Static File Serving for Videos (Caddy DIRECT — no Express cache)
    handle_path /videos/* {
        root * E:/videos
        file_server
    }

    # 4. Main Application Reverse Proxy
    handle {
        reverse_proxy localhost:7004
    }

    # 4. Global Directives & Security Headers
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options SAMEORIGIN
        X-XSS-Protection "1; mode=block"
        Referrer-Policy no-referrer-when-downgrade
        
        # Permissions & Security Opportunities
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        
        -Server
    }

    log {
        output file C:/Users/User/Desktop/xx/logs/caddy-xmelayu.log
    }
}
