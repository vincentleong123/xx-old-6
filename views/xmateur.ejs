<script>
const POOL = <%= JSON.stringify(videos) %>;
const st = { page: 1, loading: false, hasMore: true, limit: 36, query: '', sort: 'newest' };
function card(v) {
  return '<a href="/'+v.id+'" class="card-43"><div class="thumb"><div class="img-shimmer"></div><img src="'+v.thumbnail+'" alt="'+v.title+' - xMateur" loading="lazy" decoding="async" width="320" height="240"><div class="overlay"></div><span class="views">👁️ '+v.views+'</span></div><div class="card-body"><div class="ctitle">'+v.title+'</div><div class="cmeta">'+v.category+'</div></div></a>';
}
function filter() {
  let list = [...POOL];
  const q = st.query.toLowerCase();
  if (q) { const t = q.split(/\s+/).filter(x=>x.length>1); list = list.filter(v => (v.title+' '+v.keywords.join(' ')).toLowerCase().split(/\s+/).some(w => t.some(x=>w.includes(x)))); }
  if (st.sort === 'views') list.sort((a,b)=>b.views-a.views);
  else list.sort((a,b)=>new Date(b.uploaded)-new Date(a.uploaded));
  return list;
}
function load() {
  if (st.loading || !st.hasMore) return;
  st.loading = true;
  const list = filter();
  const start = (st.page-1)*st.limit;
  const batch = list.slice(start, start+st.limit);
  if (!batch.length) { st.hasMore=false; document.getElementById('loadingIndicator').style.display='none'; st.loading=false; return; }
  const grid = document.getElementById('videoGrid');
  batch.forEach(v => grid.insertAdjacentHTML('beforeend', card(v)));
  document.getElementById('loadingIndicator').style.display = st.hasMore ? 'block' : 'none';
  document.getElementById('resultInfo').textContent = Math.min(start+st.limit,list.length)+'/'+list.length;
  if (list.length <= start+st.limit) st.hasMore = false;
  st.page++; st.loading = false;
}
function reload() { st.page=1; st.hasMore=true; st.sort=document.getElementById('sortSelect').value; document.getElementById('videoGrid').innerHTML=''; load(); }
const obs = new IntersectionObserver(e => { if(e[0].isIntersecting) load(); }, {rootMargin:'400px'});
obs.observe(document.getElementById('scrollTrigger'));
document.getElementById('searchBtn')?.addEventListener('click', ()=>{ st.query=document.getElementById('searchInput').value; reload(); });
document.getElementById('searchInput')?.addEventListener('keydown', e => { if(e.key==='Enter'){ st.query=document.getElementById('searchInput').value; reload(); }});
function toggleMobileMenu() { const n=document.getElementById('navLinks'); n.style.display=n.style.display==='flex'?'none':'flex'; }
setTimeout(load, 150);
</script>
