<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <meta name="description" content="<%= metaDescription %>">
  <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1">
  <meta name="keywords" content="<%= keywords %>">
  <meta name="juicyads-site-verification" content="46572b6e9c3f0cd05fa280411328c8ff">
  <link rel="canonical" href="<%= canonicalUrl %>">
  <meta property="og:title" content="<%= title %>">
  <meta property="og:description" content="<%= metaDescription %>">
  <meta property="og:type" content="website">
  <meta property="og:url" content="<%= canonicalUrl %>">
  <meta property="og:image" content="https://xmelayu.site/og-default.jpg">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= title %>">
  <meta name="twitter:description" content="<%= metaDescription %>">
  <%- typeof structuredData !== 'undefined' ? structuredData.map(function(sd) { return '<script type="application/ld+json">' + JSON.stringify(sd) + '</script>'; }).join('\n  ') : '' %>
  <style>
    * { margin:0; padding:0; box-sizing:border-box; }
    :root { --bg:#0a0a0b; --bg2:#111114; --bg3:#18181c; --text:#fff; --text2:#a0a0a8; --text3:#6b6b75; --accent:#ff2d55; --gold:#ffd700; --border:#2a2a30; }
    body { font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif; background:var(--bg); color:var(--text); line-height:1.6; }
    .header { background:var(--bg2); border-bottom:1px solid var(--border); padding:14px 0; position:sticky; top:0; z-index:100; }
    .header-inner { max-width:1200px; margin:0 auto; padding:0 20px; display:flex; align-items:center; justify-content:space-between; }
    .logo { color:var(--accent); font-weight:800; font-size:20px; text-decoration:none; }
    .logo span { color:var(--text); }
    .container { max-width:1200px; margin:0 auto; padding:20px; }
    h1 { font-size:28px; font-weight:800; margin-bottom:8px; }
    .subtitle { color:var(--text2); font-size:14px; margin-bottom:24px; }
    .seo-content { color:var(--text2); font-size:14px; line-height:1.7; max-width:800px; margin-bottom:32px; }
    .seo-content h2 { font-size:20px; font-weight:700; color:var(--text); margin:24px 0 12px; }
    .seo-content p { margin-bottom:14px; }
    .seo-content strong { color:var(--text); }
    .section-title { font-size:18px; font-weight:700; margin:0 0 16px; display:flex; align-items:center; gap:10px; }
    .section-title .badge { font-size:10px; font-weight:700; text-transform:uppercase; padding:3px 8px; border-radius:4px; letter-spacing:0.5px; }
    .badge-hot { background:var(--accent); color:#fff; }
    .badge-new { background:#00e676; color:#000; }
    .grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(200px,1fr)); gap:14px; }
    .card { display:block; background:var(--bg2); border:1px solid var(--border); border-radius:10px; overflow:hidden; text-decoration:none; transition:transform 0.25s,border-color 0.25s,box-shadow 0.25s; }
    .card:hover { transform:translateY(-4px); border-color:var(--accent); box-shadow:0 8px 30px rgba(255,45,85,0.15); }
    .card .thumb { aspect-ratio:16/11; background:var(--bg3); position:relative; overflow:hidden; display:flex; align-items:center; justify-content:center; }
    .card .thumb img { width:100%; height:100%; object-fit:cover; transition:transform 0.4s; }
    .card:hover .thumb img { transform:scale(1.08); }
    .card .overlay { position:absolute; inset:0; background:linear-gradient(transparent 50%,rgba(0,0,0,0.85)); }
    .card .views { position:absolute; bottom:6px; right:6px; background:rgba(0,0,0,0.8); color:var(--text); font-size:11px; padding:2px 7px; border-radius:4px; font-weight:600; }
    .card .card-body { padding:10px 12px; }
    .card .ctitle { font-size:13px; font-weight:600; color:var(--text); line-height:1.3; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
    .meta-row { display:flex; gap:8px; margin-bottom:24px; flex-wrap:wrap; }
    .meta-tag { padding:4px 12px; border-radius:20px; font-size:12px; background:var(--bg3); border:1px solid var(--border); color:var(--text2); text-decoration:none; transition:all .2s; }
    .meta-tag:hover { background:var(--accent); border-color:var(--accent); color:#fff; }
    .ad-holder { display:flex; align-items:center; justify-content:center; padding:12px 0; margin:4px 0; }
    .ad-holder--strip { gap:16px; flex-wrap:wrap; padding:20px 0; margin-top:8px; border-top:1px solid rgba(255,255,255,0.05); }
    .footer { margin-top:40px; text-align:center; color:var(--text3); font-size:12px; padding:20px 0; border-top:1px solid var(--border); }
    @media (max-width:640px) {
      .container { padding:12px; }
      h1 { font-size:22px; }
      .grid { grid-template-columns:repeat(2,1fr); gap:10px; }
      .card .card-body { padding:7px 9px; }
      .card .ctitle { font-size:11px; }
    }
  </style>
</head>
<body>
  <div class="header">
    <div class="header-inner">
      <a href="/" class="logo">x<span>Melayu</span></a>
      <a href="/" style="color:var(--text2);text-decoration:none;font-size:14px;">Home</a>
    </div>
  </div>
  <div class="container">
    <h1><%= heading %></h1>
    <div class="subtitle"><%= videos.length %> videos — updated daily</div>

    <div class="meta-row">
      <% if (typeof relatedKeywords !== 'undefined') { relatedKeywords.forEach(function(kw) { %>
        <a href="/k/<%= encodeURIComponent(kw) %>" class="meta-tag"><%= kw %></a>
      <% }); } %>
    </div>

    <div class="ad-holder">
      <ins id="kw-a1" data-width="300" data-height="250"></ins>
      <script>(adsbyjuicy = window.adsbyjuicy || []).push({'adzone':1118844});</script>
    </div>

    <div class="seo-content"><%- content %></div>

    <div class="section-title">
      <%= heading %> Videos <span class="badge badge-hot"><%= videos.length %> VIDEOS</span>
    </div>
    <div class="grid">
      <% videos.forEach(function(v) { %>
        <a href="/<%= v.id %>" class="card">
          <div class="thumb">
            <img src="<%= typeof v.thumbnail !== 'undefined' ? v.thumbnail : '' %>" alt="<%= v.title %>" loading="lazy" onerror="this.style.display='none'">
            <div class="overlay"></div>
            <span class="views"><%= (v.views || 0).toLocaleString() %></span>
          </div>
          <div class="card-body">
            <div class="ctitle"><%= v.title %></div>
          </div>
        </a>
      <% }); %>
    </div>

    <div class="ad-holder ad-holder--strip">
      <ins id="kw-f1" data-width="300" data-height="250"></ins>
      <script>(adsbyjuicy = window.adsbyjuicy || []).push({'adzone':1118840});</script>
      <ins id="kw-f2" data-width="300" data-height="250"></ins>
      <script>(adsbyjuicy = window.adsbyjuicy || []).push({'adzone':1118846});</script>
    </div>

    <div class="footer">
      <p>&copy; 2026 xMelayu &middot; All models 18+</p>
    </div>
  </div>
<!-- JuicyAds v3.2P -->
<script>var juicy_tags=['a','img'];</script>
<script src="https://js.juicyads.com/jp.php?c=4464v213p224u4r2p2a443b444&u=https%3A%2F%2Fwww.juicyads.rocks"></script>
</body>
</html>