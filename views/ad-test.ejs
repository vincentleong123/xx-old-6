<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: #1a1a2e;
            color: #fff;
            padding: 20px;
        }
        
        h1 {
            text-align: center;
            color: #e94560;
            margin-bottom: 10px;
        }
        
        .subtitle {
            text-align: center;
            color: #888;
            margin-bottom: 30px;
        }
        
        .ad-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
            gap: 20px;
            max-width: 1600px;
            margin: 0 auto;
        }
        
        .ad-box {
            background: rgba(255,255,255,0.05);
            border-radius: 12px;
            padding: 20px;
            border: 1px solid rgba(233, 69, 96, 0.2);
        }
        
        .ad-box h3 {
            color: #e94560;
            margin-bottom: 10px;
            font-size: 0.9rem;
            text-transform: uppercase;
        }
        
        .ad-box .meta {
            color: #666;
            font-size: 0.8rem;
            margin-bottom: 15px;
        }
        
        .ad-box .content {
            background: rgba(0,0,0,0.2);
            border-radius: 8px;
            padding: 15px;
            min-height: 100px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        
        .section-title {
            grid-column: 1 / -1;
            color: #e94560;
            font-size: 1.5rem;
            margin-top: 20px;
            padding-bottom: 10px;
            border-bottom: 2px solid #e94560;
        }
    </style>
</head>
<body>
    <h1>🧪 Raw Ad Test</h1>
    <p class="subtitle">All available ad units displayed for testing</p>
    
    <div class="ad-grid">
        <h2 class="section-title">Traffic Stars Banners</h2>
        <% trafficStars.forEach(ad => { %>
        <div class="ad-box">
            <h3><%= ad.id %> (<%= ad.format %>)</h3>
            <p class="meta"><%= ad.width || 'var' %>x<%= ad.height || 'var' %> | Type: <%= ad.type %></p>
            <div class="content">
                <%- ad.script %>
            </div>
        </div>
        <% }); %>
        
        <h2 class="section-title">ExoClick Banners</h2>
        <% exoClick.forEach(ad => { %>
        <div class="ad-box">
            <h3><%= ad.id %> (<%= ad.format %>)</h3>
            <p class="meta">Type: <%= ad.type %></p>
            <div class="content">
                <%- ad.script %>
            </div>
        </div>
        <% }); %>
        
        <h2 class="section-title">Native Ads</h2>
        <% nativeAds.forEach(ad => { %>
        <div class="ad-box">
            <h3><%= ad.id %> (<%= ad.format %>)</h3>
            <p class="meta">Type: <%= ad.type %></p>
            <div class="content">
                <%- ad.script %>
            </div>
        </div>
        <% }); %>
    </div>
</body>
</html>
