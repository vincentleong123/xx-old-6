    "description": "<%= metaDescription.replace(/"/g, '&quot;') %>",
    "url": "https://xmelayu.site/xamateur"
  }
  </script>
  <style>
    .ad-holder { display: flex; align-items: center; justify-content: center; padding: 12px 0; margin: 4px 0; }
    .ad-holder ins { display: block; }
    .ad-holder--strip { gap: 16px; flex-wrap: wrap; padding: 20px 0; margin-top: 8px; border-top: 1px solid rgba(255,255,255,0.05); }

    * { margin: 0; padding: 0; box-sizing: border-box; }
    :root {
      --bg: #0a0a0b; --bg2: #111114; --bg3: #18181c; --bg4: #1f1f24;
      --text: #ffffff; --text2: #a0a0a8; --text3: #6b6b75;
      --accent: #ff2d55; --gold: #ffd700; --border: #2a2a30;
    }
    body {
      font-family: 'Inter', -apple-system, sans-serif;
      background: var(--bg); color: var(--text); line-height: 1.6;
    }
    .header {
      background: var(--bg2); border-bottom: 1px solid var(--border); padding: 14px 0;
      position: sticky; top: 0; z-index: 100;
    }
    .header-inner {
      max-width: 1200px; margin: 0 auto; padding: 0 20px;
      display: flex; align-items: center; justify-content: space-between;
    }
    .logo { color: var(--accent); font-weight: 800; font-size: 20px; text-decoration: none; }
    .logo span { color: var(--text); }
    .container { max-width: 1200px; margin: 0 auto; padding: 20px; }
    h1 { font-size: 28px; font-weight: 800; margin-bottom: 8px; }
    .subtitle { color: var(--text2); font-size: 14px; margin-bottom: 24px; }
    .article { color: var(--text2); font-size: 14px; line-height: 1.7; }
    .article h2 { font-size: 20px; font-weight: 700; color: var(--text); margin: 28px 0 12px; }
    .article h3 { font-size: 17px; font-weight: 600; color: var(--text); margin: 22px 0 10px; }
    .article p { margin-bottom: 14px; }
    .article ul { margin: 10px 0 14px 20px; }
    .article ul li { margin-bottom: 6px; }
    .article strong { color: var(--text); }
    .article a { color: var(--accent); text-decoration: none; }
    .article a:hover { text-decoration: underline; }
    .highlight-box {
      background: var(--bg3); border: 1px solid var(--border);
      border-radius: 8px; padding: 20px; margin: 20px 0;
    }
    .highlight-box h3 { font-size: 16px; font-weight: 700; color: var(--gold); margin-bottom: 8px; }
    .highlight-box p { margin-bottom: 10px; color: var(--text2); font-size: 13px; }
    .btn {
      display: inline-block; background: var(--accent); color: white;
      padding: 10px 20px; border-radius: 6px; font-weight: 600;
      font-size: 13px; text-decoration: none; transition: background 0.2s;
    }
    .btn:hover { background: #ff4d6f; }
    .section-title {
      font-size: 18px; font-weight: 700; margin: 36px 0 16px;
      display: flex; align-items: center; gap: 10px;
    }
    .section-title .badge {
      font-size: 10px; font-weight: 700; text-transform: uppercase;
      padding: 3px 8px; border-radius: 4px; letter-spacing: 0.5px;
    }
    .badge-hot { background: #ff2d55; color: #fff; }
    .badge-new { background: #00e676; color: #000; }
    .badge-top { background: #ffd700; color: #000; }

    /* Carousel */
    .carousel-wrap { position: relative; margin-bottom: 32px; }
    .carousel {
      display: flex; gap: 12px; overflow-x: auto; scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch; padding-bottom: 8px;
      scrollbar-width: thin; scrollbar-color: var(--accent) var(--bg3);
    }
    .carousel::-webkit-scrollbar { height: 6px; }
    .carousel::-webkit-scrollbar-track { background: var(--bg3); border-radius: 3px; }
    .carousel::-webkit-scrollbar-thumb { background: var(--accent); border-radius: 3px; }
    .carousel-card {
      flex: 0 0 280px; scroll-snap-align: start;
      background: var(--bg2); border: 1px solid var(--border);
      border-radius: 10px; overflow: hidden; text-decoration: none;
      transition: transform 0.2s, border-color 0.2s;
    }
    .carousel-card:hover { transform: translateY(-3px); border-color: var(--accent); }
    .carousel-card .thumb {
      aspect-ratio: 16/11; background: var(--bg3); position: relative; overflow: hidden;
      display: flex; align-items: center; justify-content: center;
      color: var(--text3); font-size: 36px;
    }
    .carousel-card .thumb .overlay {
      position: absolute; inset: 0;
      background: linear-gradient(transparent 60%, rgba(0,0,0,0.8));
    }
    .carousel-card .views {
      position: absolute; bottom: 6px; right: 6px;
      background: rgba(0,0,0,0.8); color: var(--text);
      font-size: 11px; padding: 2px 7px; border-radius: 4px; font-weight: 600;
    }
    .carousel-card .card-body { padding: 10px 12px; }
    .carousel-card .ctitle {
      font-size: 13px; font-weight: 600; color: var(--text);
      line-height: 1.3; display: -webkit-box; -webkit-line-clamp: 2;
      -webkit-box-orient: vertical; overflow: hidden;
    }
    .carousel-arrow {
      position: absolute; top: 50%; transform: translateY(-50%);
      width: 36px; height: 36px; border-radius: 50%;
      background: rgba(0,0,0,0.7); border: 1px solid var(--border);
      color: #fff; font-size: 18px; cursor: pointer;
      display: flex; align-items: center; justify-content: center;
      z-index: 10; transition: background 0.2s;
    }
    .carousel-arrow:hover { background: var(--accent); }
    .carousel-arrow.left { left: -14px; }
    .carousel-arrow.right { right: -14px; }

    /* 4:3 Gallery */
    .grid-43 {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: 14px;
    }
    .card-43 {
      display: block; background: var(--bg2); border: 1px solid var(--border);
      border-radius: 10px; overflow: hidden; text-decoration: none;
      transition: transform 0.25s, border-color 0.25s, box-shadow 0.25s;
    }
    .card-43:hover {
      transform: translateY(-4px); border-color: var(--accent);
      box-shadow: 0 8px 30px rgba(255,45,85,0.15);
    }
    .card-43 .thumb {
      aspect-ratio: 4/3; background: var(--bg3); position: relative; overflow: hidden;
      display: flex; align-items: center; justify-content: center;
      color: var(--text3); font-size: 38px;
    }
    .card-43 .thumb img {
      width: 100%; height: 100%; object-fit: cover;
      transition: transform 0.4s;
    }
    .card-43:hover .thumb img { transform: scale(1.08); }
    .card-43 .thumb .overlay {
      position: absolute; inset: 0;
      background: linear-gradient(transparent 50%, rgba(0,0,0,0.85));
    }
    .card-43 .views {
      position: absolute; bottom: 6px; right: 6px;
      background: rgba(0,0,0,0.8); color: var(--text);
      font-size: 11px; padding: 2px 7px; border-radius: 4px; font-weight: 600;
    }
    .card-43 .card-body { padding: 10px 12px; }
    .card-43 .ctitle {
      font-size: 13px; font-weight: 600; color: var(--text);
      line-height: 1.3; display: -webkit-box; -webkit-line-clamp: 2;
      -webkit-box-orient: vertical; overflow: hidden;
    }

    /* 16:9 Gallery */
    .grid-169 {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
      gap: 14px;
    }
    .card-169 {
      display: block; background: var(--bg2); border: 1px solid var(--border);
      border-radius: 10px; overflow: hidden; text-decoration: none;
      transition: transform 0.25s, border-color 0.25s, box-shadow 0.25s;
    }
    .card-169:hover {
      transform: translateY(-4px); border-color: var(--accent);
      box-shadow: 0 8px 30px rgba(255,45,85,0.15);
    }
    .card-169 .thumb {
      aspect-ratio: 16/11; background: var(--bg3); position: relative; overflow: hidden;
      display: flex; align-items: center; justify-content: center;
      color: var(--text3); font-size: 36px;
    }
    .card-169 .thumb img {
      width: 100%; height: 100%; object-fit: cover;
      transition: transform 0.4s;
    }
    .card-169:hover .thumb img { transform: scale(1.08); }
    .card-169 .thumb .overlay {
      position: absolute; inset: 0;
      background: linear-gradient(transparent 50%, rgba(0,0,0,0.85));
    }
    .card-169 .views {
      position: absolute; bottom: 6px; right: 6px;
      background: rgba(0,0,0,0.8); color: var(--text);
      font-size: 11px; padding: 2px 7px; border-radius: 4px; font-weight: 600;
    }
    .card-169 .card-body { padding: 10px 12px; }
    .card-169 .ctitle {
      font-size: 13px; font-weight: 600; color: var(--text);
      line-height: 1.3; display: -webkit-box; -webkit-line-clamp: 2;
      -webkit-box-orient: vertical; overflow: hidden;
    }
    .card-169 .meta {
      display: flex; align-items: center; gap: 8px;
      font-size: 11px; color: var(--text3); margin-top: 4px;
    }

    .footer { margin-top: 40px; text-align: center; color: var(--text3); font-size: 12px; padding: 20px 0; border-top: 1px solid var(--border); }
    @media (max-width: 640px) {
      .container { padding: 12px; }
      h1 { font-size: 22px; }
      .carousel-card { flex: 0 0 220px; }
      .grid-43 { grid-template-columns: repeat(2, 1fr); gap: 10px; }
      .grid-169 { grid-template-columns: repeat(2, 1fr); gap: 10px; }
      .card-43 .card-body { padding: 7px 9px; }
      .card-169 .card-body { padding: 7px 9px; }
      .card-43 .ctitle { font-size: 11px; }
      .card-169 .ctitle { font-size: 11px; }
      .carousel-arrow { display: none; }
    }
  </style>
</head>
<body>
  <div class="header">
    <div class="header-inner">
      <a href="/xamateur" class="logo">x<span>Amateur</span></a>
      <a href="/xamateur" class="back-link" style="color:var(--text2);text-decoration:none;font-size:14px;">American Amateur Videos</a>
    </div>
  </div>
  <div class="container">
    <h1><%= heading %></h1>
