    <div class="carousel-wrap">
      <button class="carousel-arrow left" onclick="document.querySelector('.carousel').scrollBy({left:-300,behavior:'smooth'})">&#10094;</button>
      <div class="carousel">
        <% videos.slice(0, 20).forEach(function(v) { %>
          <a href="/xamateur/<%= v.id %>" class="carousel-card">
            <div class="thumb">
              <img src="<%= v.thumbnail || '' %>" alt="<%= v.title %>" loading="lazy" onerror="this.style.display='none'" style="width:100%;height:100%;object-fit:cover;position:absolute;inset:0">
              <div class="overlay"></div>
              <span class="views"><%= (v.views || 0).toLocaleString() %></span>
            </div>
            <div class="card-body">
              <div class="ctitle"><%= v.title %></div>
            </div>
          </a>
        <% }); %>
      </div>
      <button class="carousel-arrow right" onclick="document.querySelector('.carousel').scrollBy({left:300,behavior:'smooth'})">&#10095;</button>
    </div>

    <!-- Cornerstone SEO Article -->
    <div class="article">
      <%- content %>
    </div>

    <div class="ad-holder" style="gap:16px;flex-wrap:wrap;padding:16px 0">
      <ins id="cs-a1" data-width="300" data-height="250"></ins>
