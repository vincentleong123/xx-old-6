      <ins id="cs-a2" data-width="300" data-height="250"></ins>
      <script>(adsbyjuicy = window.adsbyjuicy || []).push({'adzone':1118846});</script>
    </div>

    <!-- 4:3 Gallery Section -->
    <div class="section-title">
      4:3 Gallery <span class="badge badge-new">POPULAR</span>
    </div>
    <div class="grid-43">
      <% videos.slice(0, 40).forEach(function(v) { %>
        <a href="/xamateur/<%= v.id %>" class="card-43">
          <div class="thumb">
            <img src="<%= v.thumbnail || '' %>" alt="<%= v.title %>" loading="lazy" onerror="this.style.display='none'">
            <div class="overlay"></div>
            <span class="views"><%= (v.views || 0).toLocaleString() %></span>
          </div>
          <div class="card-body">
            <div class="ctitle"><%= v.title %></div>
          </div>
        </a>
      <% }); %>
    </div>

    <!-- 16:9 Gallery Section -->
    <div class="section-title">
      16:9 Widescreen <span class="badge badge-top">ALL VIDEOS</span>
    </div>
    <div class="grid-169">
      <% videos.forEach(function(v) { %>
        <a href="/xamateur/<%= v.id %>" class="card-169">
          <div class="thumb">
            <img src="<%= v.thumbnail || '' %>" alt="<%= v.title %>" loading="lazy" onerror="this.style.display='none'">
            <div class="overlay"></div>
            <span class="views"><%= (v.views || 0).toLocaleString() %></span>
          </div>
          <div class="card-body">
            <div class="ctitle"><%= v.title %></div>
          </div>
        </a>
      <% }); %>
    </div>

    <div class="ad-holder ad-holder--strip">
      <ins id="cs-f1" data-width="300" data-height="250"></ins>
      <script>(adsbyjuicy = window.adsbyjuicy || []).push({'adzone':1118840});</script>
      <ins id="cs-f2" data-width="300" data-height="250"></ins>
      <script>(adsbyjuicy = window.adsbyjuicy || []).push({'adzone':1118844});</script>
    </div>

    <%- include('_about') %>
    <div class="footer">
      <p>&copy; 2026 xAmateur &middot; USA Amateur Content &middot; All models 18+</p>
    </div>
  </div>
