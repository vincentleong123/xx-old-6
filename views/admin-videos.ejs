<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Bulk Video Editor</title>
  <meta name="robots" content="noindex, nofollow">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      background: #0a0a0b; color: #e0e0e0; padding: 20px;
    }
    .admin-nav { display: flex; gap: 4px; margin-bottom: 24px; background: #1a1a1e; border-radius: 12px; padding: 4px; }
    .admin-nav a {
      padding: 10px 20px; border-radius: 8px; text-decoration: none;
      color: #6b6b75; font-size: 13px; font-weight: 500; transition: all .2s;
    }
    .admin-nav a:hover { color: #fff; background: #2a2a30; }
    .admin-nav a.active { color: #fff; background: #ff2d55; }
    h1 { color: #ff2d55; margin-bottom: 20px; font-size: 24px; }
    .back-link { color: #ff2d55; text-decoration: none; font-size: 13px; display: inline-block; margin-bottom: 16px; }
    .back-link:hover { text-decoration: underline; }

    .controls { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 16px; align-items: end; }
    .controls label { display: block; color: #a0a0a8; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 4px; }
    .controls input, .controls select {
      padding: 8px 12px; background: #1a1a1e; border: 1px solid #2a2a30; border-radius: 8px;
      color: #fff; font-size: 13px;
    }
    .controls input:focus, .controls select:focus { outline: none; border-color: #ff2d55; }

    .bulk-bar {
      background: #1a1a1e; border: 1px solid #2a2a30; border-radius: 12px; padding: 20px;
      margin-bottom: 16px; display: none;
    }
    .bulk-bar.active { display: block; }
    .bulk-bar .count { color: #ff2d55; font-weight: 600; margin-bottom: 12px; }
    .bulk-ops { display: flex; gap: 12px; flex-wrap: wrap; align-items: end; }
    .bulk-ops label { display: block; color: #a0a0a8; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 4px; }
    .bulk-ops input, .bulk-ops select {
      padding: 8px 12px; background: #0a0a0b; border: 1px solid #2a2a30; border-radius: 8px;
      color: #fff; font-size: 13px;
    }
    .bulk-ops input:focus, .bulk-ops select:focus { outline: none; border-color: #ff2d55; }

    .btn {
      padding: 8px 20px; border-radius: 8px; border: none; font-size: 13px;
      font-weight: 600; cursor: pointer; transition: all .2s;
    }
    .btn-primary { background: #ff2d55; color: #fff; }
    .btn-primary:hover { background: #ff4d6f; }
    .btn-secondary { background: #2a2a30; color: #a0a0a8; }
    .btn-secondary:hover { background: #3a3a40; color: #fff; }
    .btn-warning { background: #ffd700; color: #000; }
    .btn-warning:hover { background: #ffe44d; }

    .table-wrap { overflow-x: auto; }
    table { width: 100%; border-collapse: collapse; font-size: 12px; }
    th { text-align: left; padding: 10px 12px; color: #6b6b75; font-weight: 600; border-bottom: 1px solid #2a2a30; font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px; position: sticky; top: 0; background: #0a0a0b; }
    td { padding: 8px 12px; border-bottom: 1px solid #1a1a1e; }
    td.title-col { max-width: 300px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    tr:hover td { background: #1a1a1e; }
    input[type="checkbox"] { accent-color: #ff2d55; width: 16px; height: 16px; cursor: pointer; }
    .pagination { display: flex; gap: 8px; justify-content: center; margin-top: 20px; }
    .pagination button {
      padding: 6px 14px; background: #1a1a1e; border: 1px solid #2a2a30; border-radius: 6px;
      color: #a0a0a8; cursor: pointer; font-size: 12px;
    }
    .pagination button:hover { border-color: #ff2d55; color: #fff; }
    .pagination button.active { background: #ff2d55; color: #fff; border-color: #ff2d55; }
    .select-all { color: #ff2d55; cursor: pointer; font-size: 12px; margin-left: 8px; }
    .tag { display: inline-block; padding: 2px 8px; border-radius: 4px; font-size: 10px; background: #1f1f24; color: #a0a0a8; margin-right: 4px; }
    .tag.cat { background: rgba(255,45,85,0.15); color: #ff2d55; }
    .status { padding: 8px 16px; border-radius: 8px; font-size: 13px; margin-bottom: 16px; display: none; }
    .status.success { display: block; background: rgba(52,199,89,0.15); color: #34c759; border: 1px solid rgba(52,199,89,0.3); }
    .status.error { display: block; background: rgba(255,45,85,0.15); color: #ff2d55; border: 1px solid rgba(255,45,85,0.3); }

    .pattern-preview { color: #6b6b75; font-size: 12px; margin-top: 4px; font-style: italic; }
  </style>
</head>
<body>
  <a href="/admin" class="back-link">← Back to Dashboard</a>
  <h1>Bulk Video Title Editor</h1>

  <div class="admin-nav">
    <a href="/admin">Dashboard</a>
    <a href="/admin/pages">Pages</a>
    <a href="/admin/videos" class="active">Videos</a>
    <a href="/admin/ads">Ads</a>
    <a href="/admin/keywords">Keywords</a>
    <a href="/admin/super-x">Super X</a>
  </div>

  <div class="status" id="status"></div>

  <div class="controls">
    <div>
      <label>Search</label>
      <input type="text" id="search" placeholder="Filter by ID or title" oninput="loadVideos()">
    </div>
    <div>
      <label>Per page</label>
      <select id="perPage" onchange="loadVideos()">
        <option value="50">50</option>
        <option value="100">100</option>
        <option value="200">200</option>
      </select>
    </div>
    <button class="btn btn-secondary" onclick="selectAll()">Select All</button>
    <button class="btn btn-secondary" onclick="deselectAll()">Deselect All</button>
  </div>

  <div class="bulk-bar" id="bulkBar">
    <div class="count"><span id="selectedCount">0</span> video(s) selected</div>
    <div class="bulk-ops">
      <div>
        <label>Operation</label>
        <select id="bulkOp">
          <option value="prepend">Prepend text</option>
          <option value="append">Append text</option>
          <option value="replace">Replace entire title</option>
          <option value="renumber">Renumber with pattern</option>
        </select>
      </div>
      <div>
        <label>Value</label>
        <input type="text" id="bulkValue" placeholder="Text to apply" oninput="updatePreview()">
      </div>
      <div id="renumberOpts" style="display:none">
        <div style="display:flex;gap:8px">
          <div>
            <label>Prefix</label>
            <input type="text" id="rnPrefix" placeholder="prefix-" value="" oninput="updatePreview()">
          </div>
          <div>
            <label>Start #</label>
            <input type="number" id="rnStart" value="1" min="1" style="width:70px" oninput="updatePreview()">
          </div>
          <div>
            <label>Padding</label>
            <select id="rnPad" onchange="updatePreview()">
              <option value="3">001</option>
              <option value="4">0001</option>
              <option value="2">01</option>
            </select>
          </div>
          <div>
            <label>Suffix</label>
            <input type="text" id="rnSuffix" placeholder="-keyword" value="" oninput="updatePreview()">
          </div>
        </div>
        <div class="pattern-preview" id="patternPreview">Preview: prefix-001-suffix, prefix-002-suffix, ...</div>
      </div>
      <button class="btn btn-primary" onclick="applyBulk()">Apply</button>
    </div>
  </div>

  <div class="table-wrap">
    <table>
      <thead>
        <tr><th style="width:30px">#</th><th>Thumb</th><th>ID</th><th>Title</th><th>Description</th><th>Category</th><th>Views</th></tr>
      </thead>
      <tbody id="videoList"></tbody>
    </table>
  </div>
  <div class="pagination" id="pagination"></div>

  <script>
    let currentPage = 1, totalPages = 1, allVideos = [];

    document.getElementById('bulkOp').addEventListener('change', function() {
      document.getElementById('renumberOpts').style.display = this.value === 'renumber' ? 'block' : 'none';
      document.getElementById('bulkValue').style.display = this.value === 'renumber' ? 'none' : '';
      updatePreview();
    });

    function updatePreview() {
      const op = document.getElementById('bulkOp').value;
      if (op === 'renumber') {
        const prefix = document.getElementById('rnPrefix').value || 'video';
        const pad = parseInt(document.getElementById('rnPad').value);
        const suffix = document.getElementById('rnSuffix').value || '';
        const start = parseInt(document.getElementById('rnStart').value);
        document.getElementById('patternPreview').textContent =
          `Preview: ${prefix}${String(start).padStart(pad,'0')}${suffix}, ${prefix}${String(start+1).padStart(pad,'0')}${suffix}, ...`;
      }
    }

    async function loadVideos() {
      const q = document.getElementById('search').value;
      const limit = document.getElementById('perPage').value;
      const res = await fetch(`/api/admin/videos?q=${encodeURIComponent(q)}&page=${currentPage}&limit=${limit}`);
      const d = await res.json();
      allVideos = d.videos;
      totalPages = d.totalPages;
      renderTable();
      renderPagination(d.total);
    }

    function renderTable() {
      const tbody = document.getElementById('videoList');
      tbody.innerHTML = allVideos.map((v, i) => `
        <tr>
          <td><input type="checkbox" class="video-cb" value="${v.id}" onchange="updateBulkBar()"></td>
          <td><img src="${v.thumbnail}" alt="" style="width:48px;height:27px;object-fit:cover;border-radius:4px;display:block" loading="lazy" onerror="this.style.display='none'"></td>
          <td style="color:#6b6b75;font-size:11px;max-width:150px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="${v.id}">${v.id}</td>
          <td><input type="text" class="title-input" value="${v.title.replace(/"/g,'&quot;')}" data-id="${v.id}" style="width:100%;background:transparent;border:1px solid transparent;border-radius:4px;color:#fff;font-size:12px;padding:2px 6px;outline:none" onfocus="this.style.borderColor='#ff2d55'" onblur="saveTitle(this)" onkeydown="if(event.key==='Enter')this.blur()"></td>
          <td style="max-width:250px;min-width:180px"><textarea class="desc-input" data-id="${v.id}" rows="2" style="width:100%;background:transparent;border:1px solid transparent;border-radius:4px;color:#9a9aa0;font-size:11px;padding:2px 6px;outline:none;resize:vertical;font-family:inherit" onfocus="this.style.borderColor='#ff2d55'" onblur="saveDesc(this)" onkeydown="if(event.key==='Enter'&&!event.shiftKey)this.blur()">${((v.description||'').replace(/"/g,'&quot;'))}</textarea></td>
          <td><span class="tag cat">${v.category || 'N/A'}</span></td>
          <td style="color:#6b6b75">${(v.views || 0).toLocaleString()}</td>
        </tr>
      `).join('');
    }

    async function saveTitle(input) {
      input.style.borderColor = 'transparent';
      const id = input.dataset.id;
      const title = input.value.trim();
      const orig = allVideos.find(v => v.id === id)?.title;
      if (title === orig) return;
      try {
        const res = await fetch('/api/admin/videos/' + encodeURIComponent(id), {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ title })
        });
        if (res.ok) {
          input.style.borderColor = '#34c759';
          allVideos.forEach(v => { if (v.id === id) v.title = title; });
        } else {
          input.style.borderColor = '#ff2d55';
          input.value = orig;
        }
      } catch {
        input.style.borderColor = '#ff2d55';
        input.value = orig;
      }
      setTimeout(() => { input.style.borderColor = 'transparent'; }, 1500);
    }

    async function saveDesc(textarea) {
      textarea.style.borderColor = 'transparent';
      const id = textarea.dataset.id;
      const description = textarea.value;
      const video = allVideos.find(v => v.id === id);
      const orig = video?.description || '';
      if (description === orig) return;
      try {
        const res = await fetch('/api/admin/videos/' + encodeURIComponent(id), {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ title: video?.title || id, description })
        });
        if (res.ok) {
          textarea.style.borderColor = '#34c759';
          if (video) video.description = description;
        } else {
          textarea.style.borderColor = '#ff2d55';
          textarea.value = orig;
        }
      } catch {
        textarea.style.borderColor = '#ff2d55';
        textarea.value = orig;
      }
      setTimeout(() => { textarea.style.borderColor = 'transparent'; }, 1500);
    }

    function renderPagination(total) {
      const el = document.getElementById('pagination');
      let html = `<span style="color:#6b6b75;font-size:12px;margin-right:12px">${total} videos</span>`;
      for (let i = 1; i <= totalPages; i++) {
        html += `<button class="${i === currentPage ? 'active' : ''}" onclick="goToPage(${i})">${i}</button>`;
      }
      el.innerHTML = html;
    }

    function goToPage(p) { currentPage = p; loadVideos(); }

    function selectAll() {
      document.querySelectorAll('.video-cb').forEach(cb => cb.checked = true);
      updateBulkBar();
    }
    function deselectAll() {
      document.querySelectorAll('.video-cb').forEach(cb => cb.checked = false);
      updateBulkBar();
    }
    function updateBulkBar() {
      const checked = document.querySelectorAll('.video-cb:checked').length;
      document.getElementById('selectedCount').textContent = checked;
      document.getElementById('bulkBar').classList.toggle('active', checked > 0);
    }

    async function applyBulk() {
      const checked = document.querySelectorAll('.video-cb:checked');
      const ids = Array.from(checked).map(cb => cb.value);
      const op = document.getElementById('bulkOp').value;
      const status = document.getElementById('status');

      let data;
      if (op === 'renumber') {
        const prefix = document.getElementById('rnPrefix').value;
        const suffix = document.getElementById('rnSuffix').value;
        const start = parseInt(document.getElementById('rnStart').value);
        const pad = parseInt(document.getElementById('rnPad').value);
        data = { ids, operation: 'renumber', prefix, suffix, start, pad };
      } else {
        data = { ids, operation: op, text: document.getElementById('bulkValue').value };
      }

      try {
        const res = await fetch('/api/admin/videos/bulk', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });
        const result = await res.json();
        if (result.success) {
          status.className = 'status success';
          status.textContent = `${result.count} video(s) updated successfully.`;
          loadVideos();
          deselectAll();
        } else {
          status.className = 'status error';
          status.textContent = result.error || 'Failed.';
        }
      } catch {
        status.className = 'status error';
        status.textContent = 'Network error.';
      }
      status.style.display = 'block';
      setTimeout(() => status.style.display = 'none', 5000);
    }

    loadVideos();
  </script>
</body>
</html>
