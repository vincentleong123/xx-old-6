          <div class="carousel-header">
            <div class="carousel-title">&#127752; Explore Something New</div>
            <div class="carousel-nav">
              <button onclick="scrollCarousel('explore1Track',-1)">&lsaquo;</button>
              <button onclick="scrollCarousel('explore1Track',1)">&rsaquo;</button>
