  <style>
    /* Carousel styles for player page */
    .player-carousels {
      max-width: 1400px;
      margin: 0 auto;
      padding: 24px 20px 8px;
    }
    .player-carousels .carousel-section {
      margin-bottom: 28px;
    }
    .player-carousels .carousel-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 0 12px;
    }
    .player-carousels .section-title {
      font-size: 16px;
      font-weight: 700;
      margin: 0;
    }
    .player-carousels .section-subtitle {
      font-size: 12px;
      color: var(--text-muted);
    }
    .player-carousels .carousel-container {
      overflow: hidden;
      position: relative;
    }
    .player-carousels .carousel-track {
      display: flex;
      gap: 12px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      padding-bottom: 8px;
      scrollbar-width: thin;
      scrollbar-color: var(--accent) var(--bg-tertiary);
    }
    .player-carousels .carousel-track::-webkit-scrollbar {
      height: 6px;
    }
    .player-carousels .carousel-track::-webkit-scrollbar-track {
      background: var(--bg-tertiary);
      border-radius: 3px;
    }
    .player-carousels .carousel-track::-webkit-scrollbar-thumb {
      background: var(--accent);
      border-radius: 3px;
    }
    .player-carousels .carousel-card {
      flex: 0 0 260px;
      scroll-snap-align: start;
      border-radius: 12px;
      overflow: hidden;
    }
    .player-carousels .carousel-card .video-card {
      border: none;
      border-radius: 0;
    }
    .player-carousels .carousel-card .video-card:hover {
      transform: none;
      box-shadow: none;
    }
    .player-carousels .carousel-dots {
      display: flex;
      justify-content: center;
      gap: 6px;
      padding: 8px 0 0;
    }
    .player-carousels .carousel-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--border);
      cursor: pointer;
      transition: background 0.2s;
    }
    .player-carousels .carousel-dot.active {
      background: var(--accent);
    }
    .player-carousels .video-card {
      display: block;
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 12px;
      overflow: hidden;
      text-decoration: none;
      cursor: pointer;
      transition: transform 0.3s cubic-bezier(0.33,1,0.68,1), border-color 0.3s, box-shadow 0.3s;
      will-change: transform;
    }
    .player-carousels .video-card:hover {
      transform: translateY(-4px);
      border-color: var(--accent);
      box-shadow: 0 12px 40px rgba(255,45,85,0.15), 0 0 0 1px rgba(255,45,85,0.3);
    }
    .player-carousels .video-thumb {
      position: relative;
      aspect-ratio: 16/11;
      overflow: hidden;
      background: var(--bg-tertiary);
    }
    .player-carousels .video-thumb img {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      z-index: 1;
      transition: transform 0.5s cubic-bezier(0.33,1,0.68,1);
      filter: contrast(1.08) saturate(1.15);
    }
    .player-carousels .video-card:hover .video-thumb img {
      transform: scale(1.05);
    }
    .player-carousels .video-thumb video {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      pointer-events: none;
