<!-- Floating Player — sticky mini-player that follows scroll, ads stay visible -->
<style>
#floatingPlayer { position:fixed; bottom:20px; right:20px; width:320px; z-index:9999; background:#0d0d12; border:1px solid #2a2a30; border-radius:12px; overflow:hidden; box-shadow:0 8px 40px rgba(0,0,0,0.8); transform:translateY(120%); opacity:0; transition:transform 0.4s cubic-bezier(0.33,1,0.68,1),opacity 0.3s; }
#floatingPlayer.show { transform:translateY(0); opacity:1; }
#floatingPlayer .fp-header { display:flex; align-items:center; justify-content:space-between; padding:8px 12px; background:#18181c; border-bottom:1px solid #2a2a30; }
#floatingPlayer .fp-title { font-size:12px; font-weight:600; color:#fff; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; max-width:200px; }
#floatingPlayer .fp-controls { display:flex; gap:6px; }
#floatingPlayer .fp-btn { background:none; border:none; color:#a0a0a8; font-size:16px; cursor:pointer; padding:2px 6px; border-radius:4px; transition:all .2s; line-height:1; }
#floatingPlayer .fp-btn:hover { color:#fff; background:rgba(255,255,255,0.1); }
#floatingPlayer .fp-video { position:relative; aspect-ratio:16/9; background:#000; }
#floatingPlayer .fp-video video { width:100%; height:100%; object-fit:contain; }
#floatingPlayer .fp-close { color:#ff4d4d; }
#floatingPlayer .fp-close:hover { color:#ff6b6b; background:rgba(255,77,77,0.15); }
@media (max-width:640px) { #floatingPlayer { width:280px; bottom:12px; right:12px; } }
</style>
<div id="floatingPlayer">
  <div class="fp-header">
    <span class="fp-title" id="fpTitle">Now Playing</span>
    <div class="fp-controls">
      <button class="fp-btn" id="fpPlayPause" onclick="fpTogglePlay()" title="Play/Pause">⏸️</button>
      <button class="fp-btn fp-close" onclick="fpClose()" title="Close">✕</button>
    </div>
  </div>
  <div class="fp-video">
    <video id="fpVideo" muted loop playsinline preload="auto"></video>
  </div>
</div>
<script>
(function(){
  var mainVideo = document.getElementById('videoPlayer');
  var fp = document.getElementById('floatingPlayer');
  var fpVideo = document.getElementById('fpVideo');
  var fpTitle = document.getElementById('fpTitle');
  var fpPlayBtn = document.getElementById('fpPlayPause');
  var mainContainer = document.getElementById('videoContainer');
  if (!mainVideo || !fp || !mainContainer) return;

  var observer = new IntersectionObserver(function(entries) {
    entries.forEach(function(entry) {
      if (!entry.isIntersecting && mainVideo.src) {
        fpVideo.src = mainVideo.src;
        fpVideo.currentTime = mainVideo.currentTime;
        fpTitle.textContent = document.title.replace(' | xMelayu', '');
        fp.classList.add('show');
        if (!mainVideo.paused) fpVideo.play().catch(function(){});
      } else {
        fp.classList.remove('show');
        fpVideo.pause();
      }
    });
  }, { threshold: 0, rootMargin: '-80px 0px 0px 0px' });
  observer.observe(mainContainer);

  window.fpTogglePlay = function() {
    if (fpVideo.paused) { fpVideo.play(); fpPlayBtn.textContent = '\u23F8\uFE0F'; }
    else { fpVideo.pause(); fpPlayBtn.textContent = '\u25B6\uFE0F'; }
  };
  window.fpClose = function() {
    fp.classList.remove('show');
    fpVideo.pause();
    fpVideo.src = '';
  };
  fpVideo.addEventListener('play', function(){ fpPlayBtn.textContent = '\u23F8\uFE0F'; });
  fpVideo.addEventListener('pause', function(){ fpPlayBtn.textContent = '\u25B6\uFE0F'; });
})();
</script>

