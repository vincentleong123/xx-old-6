      pipActive = true;
      enteringPiP = false;
      showPipSkyscrapers();
    }

    function exitPip() {
      if (!pipActive || !vp) return;
      hidePipSkyscrapers();
      pipActive = false;
      /* move video back to its original container */
      vc.insertBefore(vp, vc.firstChild);
      /* animate out then destroy */
      pipEl.style.animation = 'pipExit 0.2s ease forwards';
      setTimeout(function() {
        destroyPipEl();
        endDrag();
      }, 200);
    }

    /* ---- scroll detection ---- */
    function checkScroll() {
      if (!vc || !vp) return;
      var rect = vc.getBoundingClientRect();
      var scrolledPast = rect.bottom < 0;
      var mostlyHidden = rect.top < -rect.height * 0.6;

      if (!pipActive && !enteringPiP && (scrolledPast || mostlyHidden)) {
        enterPip();
      }

      if (pipActive) {
        var backInView = rect.top > -rect.height * 0.15 && rect.top < window.innerHeight * 0.5;
        if (backInView) exitPip();
      }
    }

    window.addEventListener('scroll', function() {
      if (scrollCheckTimer) clearTimeout(scrollCheckTimer);
      scrollCheckTimer = setTimeout(checkScroll, 100);
    }, { passive: true });

    window.addEventListener('resize', function() {
      if (!pipActive) { hidePipSkyscrapers(); return; }
      if (window.innerWidth < 768) exitPip();
      if (window.innerWidth < 1480) hidePipSkyscrapers();
      else showPipSkyscrapers();
      /* clamp position on resize */
      if (pipEl) {
        var r = pipEl.getBoundingClientRect();
        if (r.right > window.innerWidth - 8 || r.bottom > window.innerHeight - 8) {
          pipEl.style.right = '28px';
          pipEl.style.bottom = '28px';
          pipEl.style.left = 'auto';
          pipEl.style.top = 'auto';
        }
      }
    });
  })();

</script>

