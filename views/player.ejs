<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title><%= displayTitle %></title>
  <meta name="description" content="<%= seoMetaDesc %>">
  <meta name="robots" content="max-video-preview:large, index, follow, max-snippet:-1, max-image-preview:large">
  <meta name="keywords" content="<%= video.keywords.join(', ') %>, <%= video.category %>, xmelayu, amateur, malay, HD streaming, 18+">
  <meta name="theme-color" content="#0a0a0a">

  <link rel="canonical" href="<%= canonicalUrl %>">
  <meta property="article:published_time" content="<%= video.uploaded || new Date().toISOString() %>">

  <link rel="preconnect" href="<%= siteBase %>">
  <link rel="dns-prefetch" href="<%= siteBase %>">
  <link rel="preconnect" href="https://www.googletagmanager.com">

  <meta property="og:title" content="<%= displayTitle %>">
  <meta property="og:description" content="<%= ogDesc %>">
  <meta property="og:type" content="video.other">
  <meta property="og:url" content="<%= canonicalUrl %>">
  <meta property="og:site_name" content="xMelayu">
  <meta property="og:image" content="<%= video.thumbnail.startsWith('http') ? video.thumbnail : siteBase + video.thumbnail %>">
  <meta property="og:image:width" content="1280">
  <meta property="og:image:height" content="720">
  <meta property="og:image:alt" content="<%= displayTitle %>">
  <meta property="og:locale" content="en_US">
  <meta property="og:locale:alternate" content="ms_MY">
  <meta property="article:section" content="<%= video.category %>">
  <meta property="article:tag" content="<%= video.subTags.slice(0,5).join(', ') %>">

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:site" content="@xmelayu">
  <meta name="twitter:title" content="<%= displayTitle %>">
  <meta name="twitter:description" content="<%= ogDesc.substring(0, 120) %>">
  <meta name="twitter:image" content="<%= video.thumbnail.startsWith('http') ? video.thumbnail : siteBase + video.thumbnail %>">
  <meta name="twitter:player" content="<%= canonicalUrl %>">
  <meta name="twitter:player:width" content="1920">
  <meta name="twitter:player:height" content="1080">

  <link rel="image_src" href="<%= video.thumbnail.startsWith('http') ? video.thumbnail : siteBase + video.thumbnail %>">

<% if (typeof structuredData !== 'undefined' && structuredData) { %>
<% structuredData.forEach(function(sd) { %>
  <script type="application/ld+json"><%- JSON.stringify(sd) %></script>
<% }); %>
<% } %>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "<%= siteBase %>" },
      { "@type": "ListItem", "position": 2, "name": "<%= video.category %>", "item": "<%= siteBase %>?q=<%= encodeURIComponent(video.category) %>" },
      { "@type": "ListItem", "position": 3, "name": "<%= displayTitle %>", "item": "<%= canonicalUrl %>" }
    ]
  }
  </script>

  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <link rel="manifest" href="/site.webmanifest">

  <link rel="preload" href="<%= video.thumbnail %>" as="image" fetchpriority="high">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <style>
:root {
  --accent: #ff2d55;
  --accent-hover: #e62048;
  --accent-glow: rgba(255,45,85,0.3);
  --bg-primary: #0a0a0b;
  --bg-secondary: #111114;
  --bg-tertiary: #18181c;
  --bg-card: #141418;
  --bg-card-hover: #1c1c22;
  --text-primary: #ffffff;
  --text-secondary: #a0a0a8;
  --text-muted: #6b6b75;
  --border: #2a2a30;
  --border-light: rgba(255,255,255,0.06);
  --transition: 0.25s cubic-bezier(0.33,1,0.68,1);
  --carousel-gap: 12px;
}
* { margin:0; padding:0; box-sizing:border-box; }
html { scroll-behavior:smooth; }
body {
  font-family: 'Inter', -apple-system, sans-serif;
  background: var(--bg-primary);
  color: var(--text-primary);
  line-height: 1.5;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* ── HEADER ── */
.header {
  position: sticky; top:0; z-index:1000;
  background: rgba(10,10,11,0.96);
  backdrop-filter: blur(16px);
  border-bottom: 1px solid var(--border-light);
  padding: 0 20px;
  height: 64px;
  display: flex;
  align-items: center;
  gap: 16px;
}
.logo { font-weight:900; font-size:20px; color:var(--accent); text-decoration:none; flex-shrink:0; letter-spacing:-0.5px; }
.logo span { color:var(--text-primary); }
.search-box {
  flex:1; max-width:480px; position:relative; margin:0 auto;
  display:flex; align-items:center;
}
.search-box input {
  width:100%; padding:10px 14px; padding-right:44px;
  background:var(--bg-tertiary); border:1px solid var(--border); border-radius:10px;
  color:var(--text-primary); font-size:14px; outline:none; font-family:inherit;
}
.search-box input:focus { border-color:var(--accent); box-shadow:0 0 0 3px var(--accent-glow); }
.search-box button {
  position:absolute; right:4px; top:50%; transform:translateY(-50%);
  background:var(--accent); color:#fff; border:none; border-radius:8px;
  padding:6px 14px; font-size:12px; font-weight:600; cursor:pointer; font-family:inherit;
}
.search-box button:hover { background:var(--accent-hover); }
.header-actions { display:flex; align-items:center; gap:8px; flex-shrink:0; }
.icon-btn {
  background:var(--bg-tertiary); border:1px solid var(--border); border-radius:8px;
  color:var(--text-secondary); cursor:pointer; padding:6px 12px; font-size:16px;
  transition:all 0.2s; font-family:inherit;
}
.icon-btn:hover { border-color:var(--accent); color:var(--text-primary); }
.back-to-gallery {
  display:inline-flex; align-items:center; gap:6px;
  background:rgba(255,255,255,0.15); border:1px solid rgba(255,255,255,0.3); border-radius:8px;
  color:#fff; cursor:pointer; padding:8px 16px; font-size:14px; font-weight:600;
  text-decoration:none; transition:all 0.2s; white-space:nowrap;
  backdrop-filter:blur(4px);
}
.back-to-gallery:hover { background:rgba(255,255,255,0.25); border-color:rgba(255,255,255,0.5); color:#fff; }
.back-to-gallery svg { width:18px; height:18px; flex-shrink:0; }

/* ── LAYOUT ── */
.player-page { flex:1; display:flex; flex-direction:column; }
.player-container {
  max-width:1600px; margin:0 auto; padding:24px 20px;
  width:100%;
  display:grid;
  grid-template-columns:1fr minmax(0,380px);
  gap:32px;
}
.player-main { min-width:0; display:flex; flex-direction:column; gap:20px; }
.player-sidebar { display:flex; flex-direction:column; gap:16px; position:sticky; top:88px; align-self:start; max-height:calc(100vh - 100px); overflow-y:auto; }
.player-sidebar::-webkit-scrollbar { width:4px; }
.player-sidebar::-webkit-scrollbar-thumb { background:var(--border); border-radius:4px; }

/* ── VIDEO PLAYER ── */
.video-wrapper {
  position:relative; background:#000; border-radius:16px;
  overflow:hidden; aspect-ratio:16/9; width:100%;
  box-shadow:0 20px 60px rgba(0,0,0,0.8), 0 0 0 1px rgba(255,255,255,0.05);
}
.video-wrapper video { width:100%; height:100%; display:block; object-fit:contain; background:#000; }

/* ── FLOATING NAV BUTTONS — left/right of player ── */
.nav-btn {
  position:absolute; top:50%; transform:translateY(-50%); z-index:10;
  display:flex; align-items:center; gap:4px;
  background:rgba(0,0,0,0.55); backdrop-filter:blur(8px);
  border:1px solid rgba(255,255,255,0.1); border-radius:50px;
  color:rgba(255,255,255,0.8); text-decoration:none;
  padding:12px 10px; cursor:pointer;
  transition:all 0.25s ease; opacity:0;
}
.video-wrapper:hover .nav-btn { opacity:1; }
.nav-btn:hover { background:var(--accent); border-color:var(--accent); color:#fff; transform:translateY(-50%) scale(1.08); }
.nav-btn:active { transform:translateY(-50%) scale(0.95); }
.nav-prev { left:10px; flex-direction:row; }
.nav-next { right:10px; flex-direction:row; }
.nav-label { font-size:11px; font-weight:700; letter-spacing:0.3px; text-transform:uppercase; }
.nav-btn svg { flex-shrink:0; }

/* ── VIDEO INFO ── */
.video-info { display:flex; flex-direction:column; gap:6px; }
.video-info h1 {
  font-size:clamp(22px,3vw,30px); font-weight:800; line-height:1.3;
  color:var(--text-primary); margin:0;
}
.video-info h2 {
  font-size:clamp(15px,2.2vw,20px); font-weight:600; line-height:1.3;
  color:var(--text-secondary); margin:0;
}
.video-meta {
  display:flex; flex-wrap:wrap; align-items:center; gap:8px 16px;
  font-size:13px; color:var(--text-secondary);
}
.video-meta .stat { display:flex; align-items:center; gap:4px; }
.video-meta .cat-badge {
  padding:3px 12px; background:var(--accent); color:#fff;
  border-radius:6px; font-size:11px; font-weight:700; text-transform:uppercase;
  letter-spacing:0.5px;
}
.video-actions { display:flex; flex-wrap:wrap; gap:8px; }
.video-actions .action-btn {
  display:inline-flex; align-items:center; gap:6px;
  padding:8px 16px; background:var(--bg-tertiary); border:1px solid var(--border);
  border-radius:10px; color:var(--text-secondary); font-size:13px; font-weight:600;
  cursor:pointer; transition:all 0.2s; font-family:inherit;
}
.video-actions .action-btn:hover { border-color:var(--accent); color:var(--text-primary); background:var(--bg-card); }
.video-actions .action-btn.liked { border-color:var(--accent); color:var(--accent); background:rgba(255,45,85,0.1); }

.video-description {
  padding:16px 20px; background:var(--bg-secondary); border:1px solid var(--border);
  border-radius:14px; font-size:14px; line-height:1.7; color:var(--text-secondary);
}
.video-description p { margin-bottom:8px; }
.video-description p:last-child { margin-bottom:0; }

.keywords-row {
  display:flex; flex-wrap:wrap; gap:6px; margin-top:12px; padding-top:12px;
  border-top:1px solid var(--border);
}
.kw-tag {
  padding:3px 10px; border-radius:12px; font-size:11px; font-weight:600;
  text-decoration:none; border:1px solid var(--border); color:var(--text-muted);
  transition:all 0.2s;
}
.kw-tag:hover { border-color:var(--accent); color:var(--text-primary); background:rgba(255,45,85,0.1); }

.video-tags { display:flex; flex-wrap:wrap; gap:6px; }
.video-tags .tag-item {
  padding:4px 12px; background:var(--bg-tertiary); border:1px solid var(--border);
  border-radius:20px; font-size:12px; font-weight:500; color:var(--text-secondary);
}
.video-tags .tag-item.category { background:var(--accent); border-color:var(--accent); color:#fff; }

/* ══════════════════════════════════════════════════════════════
   CAROUSEL — Netflix-style horizontal scroll
   ══════════════════════════════════════════════════════════════ */
.carousel-section { display:flex; flex-direction:column; gap:14px; }
.carousel-header {
  display:flex; align-items:center; justify-content:space-between;
  padding:0 4px;
}
.carousel-title {
  font-size:18px; font-weight:800; color:var(--text-primary);
  display:flex; align-items:center; gap:10px;
}
.carousel-title .count {
  font-size:12px; font-weight:600; color:var(--text-muted);
  background:var(--bg-tertiary); padding:2px 8px; border-radius:10px;
}
.carousel-nav { display:flex; gap:6px; }
.carousel-nav button {
  width:36px; height:36px; border-radius:50%; border:1px solid var(--border);
  background:var(--bg-secondary); color:var(--text-secondary); cursor:pointer;
  display:flex; align-items:center; justify-content:center; font-size:16px;
  transition:all 0.2s;
}
.carousel-nav button:hover { border-color:var(--accent); color:var(--text-primary); background:var(--bg-tertiary); }
.carousel-track {
  display:flex; gap:var(--carousel-gap);
  overflow-x:auto; scroll-snap-type:x mandatory;
  scroll-behavior:smooth; padding:4px 0 16px;
  -ms-overflow-style:none; scrollbar-width:none;
}
.carousel-track::-webkit-scrollbar { display:none; }

/* ── VIDEO CARDS ── */
.v-card {
  flex:0 0 240px; scroll-snap-align:start;
  display:block; text-decoration:none;
  background:var(--bg-card); border:1px solid var(--border);
  border-radius:12px; overflow:hidden;
  transition:all var(--transition); position:relative;
}
.v-card:hover {
  transform:translateY(-4px) scale(1.02);
  border-color:var(--accent);
  box-shadow:0 12px 40px rgba(255,45,85,0.15);
  z-index:2;
}
.v-card .thumb {
  position:relative; padding-top:56.25%; background:#000; overflow:hidden;
}
.v-card .thumb img {
  position:absolute; inset:0; width:100%; height:100%;
  object-fit:cover; transition:transform 0.5s;
}
.v-card:hover .thumb img { transform:scale(1.08); }
.v-card .thumb .play-overlay {
  position:absolute; inset:0; display:flex; align-items:center; justify-content:center;
  background:rgba(0,0,0,0.4); opacity:0; transition:opacity 0.3s;
}
.v-card:hover .thumb .play-overlay { opacity:1; }
.v-card .thumb .play-overlay span {
  width:48px; height:48px; border-radius:50%; background:var(--accent);
  display:flex; align-items:center; justify-content:center;
  font-size:20px; color:#fff; box-shadow:0 4px 20px rgba(255,45,85,0.5);
}

.v-card .card-body { padding:10px 12px 12px; }
.v-card .card-title {
  font-size:13px; font-weight:600; color:var(--text-primary);
  line-height:1.3; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical;
  overflow:hidden; margin-bottom:4px;
}
.v-card .card-meta {
  font-size:11px; color:var(--text-muted);
  display:flex; align-items:center; gap:6px;
}
.v-card .card-meta .cat-dot {
  width:6px; height:6px; border-radius:50%; background:var(--accent); flex-shrink:0;
}

/* ── FEATURED CARD (larger, in hero carousel) ── */
.v-card.featured { flex:0 0 340px; }
.v-card.featured .card-title { font-size:15px; font-weight:700; -webkit-line-clamp:3; }

/* ── COMPACT CARD (small, for trending) ── */
.v-card.compact { flex:0 0 180px; }
.v-card.compact .card-title { font-size:12px; -webkit-line-clamp:1; }
.v-card.compact .card-body { padding:8px 10px 10px; }

/* ── MINI CARD (tiny, for sidebar) ── */
.v-card.mini { flex:0 0 160px; }
.v-card.mini .thumb { padding-top:62%; }
.v-card.mini .card-title { font-size:11px; -webkit-line-clamp:2; }
.v-card.mini .card-body { padding:6px 8px 8px; }

/* ══════════════════════════════════════════════════════════════
   CATEGORY SECTION — grouped horizontal scroll per category
   ══════════════════════════════════════════════════════════════ */
.cat-section { display:flex; flex-direction:column; gap:14px; padding-top:8px; }
.cat-section-header {
  display:flex; align-items:center; gap:12px; padding:0 4px;
}
.cat-section-header h3 {
  font-size:16px; font-weight:800; color:var(--text-primary);
  display:flex; align-items:center; gap:8px;
}
.cat-section-header h3 .cat-icon {
  width:8px; height:8px; border-radius:50%; background:var(--accent);
}
.cat-section-header .see-all {
  font-size:12px; font-weight:600; color:var(--accent); text-decoration:none;
  margin-left:auto; transition:color 0.2s;
}
.cat-section-header .see-all:hover { color:var(--accent-hover); }

/* ══════════════════════════════════════════════════════════════
   GRID SECTION — for "More Like This" / "Recently Added"
   ══════════════════════════════════════════════════════════════ */
.grid-section { display:flex; flex-direction:column; gap:14px; }
.grid-section .section-head {
  display:flex; align-items:center; justify-content:space-between; padding:0 4px;
}
.grid-section .section-head h2 { font-size:18px; font-weight:800; }
.grid-section .section-head .see-all {
  font-size:12px; font-weight:600; color:var(--accent); text-decoration:none;
}
.video-grid {
  display:grid;
  grid-template-columns:repeat(auto-fill, minmax(200px, 1fr));
  gap:12px;
}

/* ── LOAD MORE ── */
.load-more-wrap { text-align:center; padding:24px 0; }
.load-more-btn {
  padding:12px 32px; background:var(--bg-tertiary); border:1px solid var(--border);
  border-radius:12px; color:var(--text-secondary); font-size:14px; font-weight:700;
  cursor:pointer; transition:all 0.2s; font-family:inherit;
}
.load-more-btn:hover { border-color:var(--accent); color:var(--text-primary); background:var(--bg-card); }

/* ══════════════════════════════════════════════════════════════
   SIDEBAR
   ══════════════════════════════════════════════════════════════ */
.sidebar-card {
  background:var(--bg-secondary); border:1px solid var(--border);
  border-radius:14px; padding:16px;
}
.sidebar-card-title {
  font-size:11px; font-weight:800; text-transform:uppercase;
  letter-spacing:1px; color:var(--text-muted); margin-bottom:12px;
  display:flex; align-items:center; gap:8px;
}
.sidebar-card-title::before {
  content:''; width:3px; height:14px; background:var(--accent); border-radius:2px;
}
.stats-grid { display:grid; grid-template-columns:1fr 1fr; gap:8px; }
.stat-item {
  display:flex; flex-direction:column; align-items:center; gap:4px;
  padding:12px 8px; background:rgba(255,255,255,0.04); border-radius:10px;
  text-align:center;
}
.stat-label { font-size:9px; color:var(--text-muted); text-transform:uppercase; letter-spacing:0.5px; font-weight:600; }
.stat-value { font-size:14px; font-weight:700; color:var(--accent); }

/* ── UP NEXT QUEUE ── */
.up-next-list { display:flex; flex-direction:column; gap:8px; }
.up-next-item {
  display:flex; gap:10px; padding:8px; border-radius:10px;
  text-decoration:none; color:var(--text-secondary);
  transition:all 0.2s; position:relative;
}
.up-next-item:hover { background:rgba(255,255,255,0.06); }
.up-next-item.active { background:rgba(255,45,85,0.1); border:1px solid rgba(255,45,85,0.2); }
.up-next-thumb {
  width:110px; height:62px; border-radius:8px; overflow:hidden; flex-shrink:0;
  background:#000; position:relative;
}
.up-next-thumb img { width:100%; height:100%; object-fit:cover; }
.up-next-thumb .queue-num {
  position:absolute; top:4px; left:4px;
  background:rgba(0,0,0,0.8); color:var(--text-muted); font-size:9px; font-weight:700;
  width:18px; height:18px; border-radius:4px; display:flex; align-items:center; justify-content:center;
}
.up-next-info { flex:1; min-width:0; display:flex; flex-direction:column; justify-content:center; gap:3px; }
.up-next-title {
  font-size:12px; font-weight:600; color:var(--text-primary); line-height:1.3;
  overflow:hidden; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical;
}
.up-next-meta { font-size:10px; color:var(--text-muted); }

/* ── SIDEBAR CATEGORY PILLS ── */
.sidebar-pills { display:flex; flex-wrap:wrap; gap:6px; }
.sidebar-pills a {
  padding:4px 10px; border-radius:8px; font-size:11px; font-weight:600;
  text-decoration:none; background:var(--bg-tertiary); border:1px solid var(--border);
  color:var(--text-muted); transition:all 0.2s;
}
.sidebar-pills a:hover { border-color:var(--accent); color:var(--text-primary); }
.sidebar-pills a.active { background:var(--accent); border-color:var(--accent); color:#fff; }

/* ══════════════════════════════════════════════════════════════
   HERO BANNER — above-the-fold visual teaser
   ══════════════════════════════════════════════════════════════ */
.hero-banner {
  position:relative; border-radius:16px; overflow:hidden;
  height:200px; margin-bottom:8px;
  background:linear-gradient(135deg, rgba(255,45,85,0.15), rgba(10,10,11,0.9)),
             url('<%= video.thumbnail %>') center/cover;
}
.hero-banner .hero-overlay {
  position:absolute; inset:0;
  background:linear-gradient(to right, rgba(10,10,11,0.95) 0%, rgba(10,10,11,0.6) 50%, rgba(10,10,11,0.2) 100%);
  display:flex; flex-direction:column; justify-content:center; padding:32px;
}
.hero-banner .hero-label {
  font-size:11px; font-weight:800; text-transform:uppercase; letter-spacing:2px;
  color:var(--accent); margin-bottom:8px;
}
.hero-banner .hero-title {
  font-size:clamp(22px,3vw,32px); font-weight:900; color:var(--text-primary);
  line-height:1.2; max-width:500px; margin-bottom:8px;
}
.hero-banner .hero-sub {
  font-size:14px; color:var(--text-secondary); max-width:400px;
}
.hero-banner .hero-cta {
  margin-top:16px; display:flex; gap:10px;
}
.hero-banner .hero-cta a {
  padding:10px 24px; border-radius:10px; font-size:13px; font-weight:700;
  text-decoration:none; transition:all 0.2s;
}
.hero-banner .hero-cta .primary { background:var(--accent); color:#fff; }
.hero-banner .hero-cta .primary:hover { background:var(--accent-hover); }
.hero-banner .hero-cta .secondary { background:var(--bg-tertiary); border:1px solid var(--border); color:var(--text-secondary); }
.hero-banner .hero-cta .secondary:hover { border-color:var(--accent); color:var(--text-primary); }

/* ══════════════════════════════════════════════════════════════
   VIEW ALL OVERLAY
   ══════════════════════════════════════════════════════════════ */
.view-all-card {
  flex:0 0 120px; scroll-snap-align:start;
  display:flex; flex-direction:column; align-items:center; justify-content:center;
  background:var(--bg-tertiary); border:1px dashed var(--border); border-radius:12px;
  color:var(--text-muted); font-size:12px; font-weight:700; text-decoration:none;
  transition:all 0.2s; min-height:180px; gap:8px;
}
.view-all-card:hover { border-color:var(--accent); color:var(--accent); background:rgba(255,45,85,0.05); }
.view-all-card .arrow { font-size:24px; }

/* ══════════════════════════════════════════════════════════════
   DIVIDER
   ══════════════════════════════════════════════════════════════ */
.section-divider {
  height:1px; background:var(--border); margin:8px 0;
}

/* ══════════════════════════════════════════════════════════════
   RESPONSIVE
   ══════════════════════════════════════════════════════════════ */
@media (max-width:1200px) {
  .player-container { grid-template-columns:1fr 340px; gap:24px; }
}
@media (max-width:1000px) {
  .player-container { grid-template-columns:1fr; gap:20px; padding:16px 12px; }
  .player-sidebar { position:static; max-height:none; display:grid; grid-template-columns:1fr 1fr; gap:12px; }
  .sidebar-card:first-child { grid-column:1/-1; }
  .v-card { flex:0 0 200px; }
  .v-card.featured { flex:0 0 280px; }
}
@media (max-width:768px) {
  .header { padding:0 12px; height:56px; gap:10px; }
  .search-box { max-width:100%; }
  .player-container { padding:10px 8px; gap:14px; }
  .player-sidebar { grid-template-columns:1fr; }
  .video-wrapper { border-radius:10px; }
  .video-info h1 { font-size:18px; }
  .video-info h2 { font-size:14px; }
  .hero-banner { height:160px; border-radius:12px; }
  .hero-banner .hero-overlay { padding:20px; }
  .hero-banner .hero-title { font-size:20px; }
  .v-card { flex:0 0 160px; }
  .v-card.featured { flex:0 0 240px; }
  .v-card.compact { flex:0 0 140px; }
  .video-grid { grid-template-columns:repeat(auto-fill, minmax(150px, 1fr)); gap:8px; }
  .up-next-thumb { width:90px; height:50px; }
  .carousel-title { font-size:15px; }
}

/* ══════════════════════════════════════════════════════════════
   THUMBNAIL ENHANCEMENT — brightness, skin tone, sharpness
   ══════════════════════════════════════════════════════════════ */
.v-card .thumb img,
.up-next-thumb img {
  filter:brightness(1.06) contrast(1.08) saturate(1.12);
}
.v-card:hover .thumb img {
  filter:brightness(1.08) contrast(1.10) saturate(1.15);
}
.hero-banner {
  filter: none;
}
.hero-banner .hero-overlay + img,
.v-card .thumb img::after {
  content:'';
}

/* ══════════════════════════════════════════════════════════════
   MULTI-PREVIEW PANEL — 3 thumbnail strip on hover
   ══════════════════════════════════════════════════════════════ */
.v-card .preview-strip {
  position:absolute; bottom:0; left:0; right:0;
  display:flex; gap:2px; padding:0;
  opacity:0; transform:translateY(4px);
  transition:opacity 0.25s ease, transform 0.25s ease;
  z-index:3;
}
.v-card:hover .preview-strip {
  opacity:1; transform:translateY(0);
}
.preview-strip .preview-frame {
  flex:1; position:relative;
  padding-top:30%; background:#111; overflow:hidden;
}
.preview-strip .preview-frame canvas {
  position:absolute; inset:0; width:100%; height:100%;
  object-fit:cover;
}
.preview-strip .preview-frame .preview-time {
  position:absolute; bottom:1px; right:2px;
  background:rgba(0,0,0,0.85); color:#fff;
  font-size:8px; font-weight:700; padding:1px 3px; border-radius:2px;
  font-family:monospace;
}
.preview-strip .preview-frame.preview-loading {
  display:flex; align-items:center; justify-content:center;
}
.preview-strip .preview-frame.preview-loading::after {
  content:''; width:12px; height:12px;
  border:2px solid rgba(255,255,255,0.2); border-top-color:var(--accent);
  border-radius:50%; animation:spin 0.6s linear infinite;
}
@keyframes spin { to { transform:rotate(360deg); } }

/* Hide card body when preview visible */
.v-card:hover .thumb .preview-strip ~ .play-overlay { opacity:0; }
.thumb.preview-active img { opacity:0; transition:opacity 0.2s; }
  </style>
</head>
<body>
  <header class="header">
    <a href="/" class="logo">x<span>Melayu</span></a>
    <div class="search-box">
      <input type="text" id="searchInput" placeholder="Search videos..." autocomplete="off">
      <button id="searchBtn">Search</button>
    </div>
    <div class="header-actions">
      <a href="/" class="back-to-gallery" title="Back to videos">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
        <span>Back</span>
      </a>
    </div>
  </header>

  <main class="player-page">
    <div class="player-container">
      <div class="player-main">
        <div class="video-wrapper" id="videoWrapper">
          <video id="videoPlayer" controls playsinline muted autoplay preload="metadata" poster="<%= video.thumbnail %>">
            <source src="/raw/videos/<%= encodeURIComponent(video.id) %>.mp4" type="video/mp4">
          </video>
          <% if (typeof prevVideo !== 'undefined' && prevVideo) { %>
          <a href="/<%= prevVideo.id %>" class="nav-btn nav-prev" title="<%= prevVideo.title %>" id="navPrev">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
            <span class="nav-label">Prev</span>
          </a>
          <% } %>
          <% if (typeof nextVideo !== 'undefined' && nextVideo) { %>
          <a href="/<%= nextVideo.id %>" class="nav-btn nav-next" title="<%= nextVideo.title %>" id="navNext">
            <span class="nav-label">Next</span>
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
          </a>
          <% } %>
        </div>

        <div class="video-info">

        <%# FIX: remove broken thumbCard helper usage (runtime EJS error) — keep inline markup %>
          <% if (oldId) { %>
            <h1><%= oldId.replace(/-/g, ' ') %></h1>
          <% } %>
          <h2><%= displayTitle %></h2>

          <div class="video-meta">
            <span class="stat" id="viewCount"><%= (video.views || 0).toLocaleString() %> views</span>
            <span class="stat"><%= new Date(video.uploaded).toLocaleDateString('en-US', { month:'short', day:'numeric', year:'numeric' }) %></span>
            <% if (video.category && video.category !== 'Uncategorized') { %>
              <span class="cat-badge"><%= video.category %></span>
            <% } %>
          </div>

          <div class="video-actions">
            <button class="action-btn like-btn" data-id="<%= video.id %>" onclick="toggleLike('<%= video.id %>', this)">
              &#9825; <span class="like-count">--</span>
            </button>
            <button class="action-btn" onclick="shareVideo()">Share</button>
            <button class="action-btn" onclick="copyLink()">Copy Link</button>
          </div>

          <% if (videoDescription && videoDescription.text) { %>
          <div class="video-description">
            <p><%- videoDescription.text.replace(/\n/g, '<br>') %></p>
            <div class="keywords-row">
              <% var kwList = (videoDescription && videoDescription.keywords) ? videoDescription.keywords : video.keywords; %>
              <% kwList.slice(0,15).forEach(function(kw) { %>
                <span class="kw-tag"><%= kw %></span>
              <% }); %>
            </div>
          </div>
          <% } else { %>
          <div class="video-description">
            <p><%= video.title %> - <%= video.category %> video. Watch and stream HD Malay videos at xMelayu.</p>
            <div class="keywords-row">
              <% video.keywords.slice(0,15).forEach(function(kw) { %>
                <span class="kw-tag"><%= kw %></span>
              <% }); %>
            </div>
          </div>
          <% } %>

          <div class="video-tags">
            <% if (video.category && video.category !== 'Uncategorized') { %>
              <span class="tag-item category"><%= video.category %></span>
            <% } %>
            <% video.subTags.slice(0,8).forEach(function(tag) { %>
              <span class="tag-item">#<%= tag %></span>
            <% }) %>
          </div>
        </div>

        <div class="section-divider"></div>


        <%# ═══ HERO CAROUSEL — Top Relevant to this video ═══ %>
        <% if (typeof heroRelated !== 'undefined' && heroRelated.length > 0) { %>
        <div class="carousel-section" id="heroCarousel">
          <div class="carousel-header">
            <div class="carousel-title">
              Related Videos <span class="count"><%= heroRelated.length %></span>
            </div>
            <div class="carousel-nav">
              <button onclick="scrollCarousel('heroTrack',-1)">&lsaquo;</button>
              <button onclick="scrollCarousel('heroTrack',1)">&rsaquo;</button>
            </div>
          </div>
          <div class="carousel-track" id="heroTrack">
            <% heroRelated.slice(0,24).forEach(function(v,i) { %>
              <a href="/<%= v.id %>" class="v-card featured">
                <div class="thumb">
                  <img src="<%= v.thumbnail %>" alt="<%= v.title %>" loading="lazy" onerror="this.onerror=null;this.src='data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAzMjAgMTgwIj48cmVjdCBmaWxsPSIjMWExYTFlIiB3aWR0aD0iMzIwIiBoZWlnaHQ9IjE4MCIvPjwvc3ZnPg=='">
                  <div class="play-overlay"><span>&#9654;</span></div>
                </div>
                <div class="card-body">
                  <div class="card-title"><%= v.title %></div>
                  <div class="card-meta">
                    <span class="cat-dot"></span>
                    <%= v.category %>
                  </div>
                </div>
              </a>
            <% }); %>
          </div>
        </div>
        <% } %>

        <%# ═══ TRENDING NOW — top by views ═══ %>
        <% if (typeof trending !== 'undefined' && trending.length > 0) { %>
        <div class="carousel-section">
          <div class="carousel-header">
            <div class="carousel-title">&#128293; Trending Now</div>
            <div class="carousel-nav">
              <button onclick="scrollCarousel('trendingTrack',-1)">&lsaquo;</button>
              <button onclick="scrollCarousel('trendingTrack',1)">&rsaquo;</button>
            </div>
          </div>
          <div class="carousel-track" id="trendingTrack">
            <% trending.forEach(function(v) { %>
              <a href="/<%= v.id %>" class="v-card compact">
                <div class="thumb">
                  <img src="<%= v.thumbnail %>" alt="<%= v.title %>" loading="lazy" onerror="this.onerror=null;this.src='data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAzMjAgMTgwIj48cmVjdCBmaWxsPSIjMWExYTFlIiB3aWR0aD0iMzIwIiBoZWlnaHQ9IjE4MCIvPjwvc3ZnPg=='">
                  <div class="play-overlay"><span>&#9654;</span></div>
                </div>
                <div class="card-body">
                  <div class="card-title"><%= v.title %></div>
                  <div class="card-meta"><%= v.category %></div>
                </div>
              </a>
            <% }); %>
          </div>
        </div>
        <% } %>

        <%# ═══ MOST VIEWED — another batch of top-viewed (no repeats) ═══ %>
        <% if (typeof mostViewed !== 'undefined' && mostViewed.length > 0) { %>
        <div class="carousel-section">
          <div class="carousel-header">
            <div class="carousel-title">&#128065; Most Viewed</div>
            <div class="carousel-nav">
              <button onclick="scrollCarousel('mostViewedTrack',-1)">&lsaquo;</button>
              <button onclick="scrollCarousel('mostViewedTrack',1)">&rsaquo;</button>
            </div>
          </div>
          <div class="carousel-track" id="mostViewedTrack">
            <% mostViewed.forEach(function(v) { %>
              <a href="/<%= v.id %>" class="v-card compact">
                <div class="thumb">
                  <img src="<%= v.thumbnail %>" alt="<%= v.title %>" loading="lazy" onerror="this.onerror=null;this.src='data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAzMjAgMTgwIj48cmVjdCBmaWxsPSIjMWExYTFlIiB3aWR0aD0iMzIwIiBoZWlnaHQ9IjE4MCIvPjwvc3ZnPg=='">
                  <div class="play-overlay"><span>&#9654;</span></div>
                </div>
                <div class="card-body">
                  <div class="card-title"><%= v.title %></div>
                  <div class="card-meta"><%= v.category %></div>
                </div>
              </a>
            <% }); %>
          </div>
        </div>
        <% } %>

        <div class="section-divider"></div>

        <%# ═══ EDITOR'S PICKS / MARK GOOD — curated top quality ═══ %>
        <% if (typeof editorsPicks !== 'undefined' && editorsPicks.length > 0) { %>
        <div class="carousel-section">
          <div class="carousel-header">
            <div class="carousel-title">&#11088; Editor's Picks</div>
            <div class="carousel-nav">
              <button onclick="scrollCarousel('picksTrack',-1)">&lsaquo;</button>
              <button onclick="scrollCarousel('picksTrack',1)">&rsaquo;</button>
            </div>
          </div>
          <div class="carousel-track" id="picksTrack">
            <% editorsPicks.forEach(function(v) { %>
              <a href="/<%= v.id %>" class="v-card">
                <div class="thumb">
                  <img src="<%= v.thumbnail %>" alt="<%= v.title %>" loading="lazy" onerror="this.onerror=null;this.src='data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAzMjAgMTgwIj48cmVjdCBmaWxsPSIjMWExYTFlIiB3aWR0aD0iMzIwIiBoZWlnaHQ9IjE4MCIvPjwvc3ZnPg=='">
                  <div class="play-overlay"><span>&#9654;</span></div>
                </div>
                <div class="card-body">
                  <div class="card-title"><%= v.title %></div>
                  <div class="card-meta">
                    <span class="cat-dot"></span>
                    <%= v.category %>
                  </div>
                </div>
              </a>
            <% }); %>
          </div>
        </div>
        <% } %>

        <%# ═══ CATEGORY GROUPS — from full library (not from related) ═══ %>
        <% if (typeof categoryGroups !== 'undefined' && categoryGroups.length > 0) { %>
          <% categoryGroups.forEach(function(pair) { var catName = pair[0]; var catVideos = pair[1]; %>
          <div class="cat-section">
            <div class="cat-section-header">
              <h3><span class="cat-icon"></span><%= catName %></h3>
              <a href="/?q=<%= encodeURIComponent(catName) %>" class="see-all">See All &rarr;</a>
            </div>
            <div class="carousel-track">
              <% catVideos.forEach(function(v) { %>
                <a href="/<%= v.id %>" class="v-card">
                  <div class="thumb">
                    <img src="<%= v.thumbnail %>" alt="<%= v.title %>" loading="lazy" onerror="this.onerror=null;this.src='data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAzMjAgMTgwIj48cmVjdCBmaWxsPSIjMWExYTFlIiB3aWR0aD0iMzIwIiBoZWlnaHQ9IjE4MCIvPjwvc3ZnPg=='">
                    <div class="play-overlay"><span>&#9654;</span></div>
                  </div>
                  <div class="card-body">
                    <div class="card-title"><%= v.title %></div>
                    <div class="card-meta"><%= v.category %></div>
