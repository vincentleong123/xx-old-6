      opacity: 0;
      transition: opacity 0.35s ease;
    }
    .player-carousels .video-card:hover .video-thumb video { opacity: 1; }
    .player-carousels .v-title {
      font-size: 13px;
      font-weight: 600;
      color: var(--text-primary);
      margin: 8px 12px 4px;
      line-height: 1.35;
