<% var seoJsonDesc = (typeof videoDescription !== 'undefined' && videoDescription && videoDescription.text) ? videoDescription.text.replace(/<[^>]+>/g,'').trim().substring(0,300) : (video.title + ' - Watch in HD quality on Lucahman. Premium adult content featuring ' + video.category + '.'); %>
