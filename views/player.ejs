        <% if (typeof exploreSlice3 !== 'undefined' && exploreSlice3.length > 0) { %>
        <div class="carousel-section">
          <div class="carousel-header">
            <div class="carousel-title">&#128161; Hidden Gems</div>
            <div class="carousel-nav">
              <button onclick="scrollCarousel('explore3Track',-1)">&lsaquo;</button>
              <button onclick="scrollCarousel('explore3Track',1)">&rsaquo;</button>
            </div>
          </div>
          <div class="carousel-track" id="explore3Track">
            <% exploreSlice3.forEach(function(v) { %>
              <a href="/<%= v.id %>" class="v-card">
                <div class="thumb">
                  <img src="<%= v.thumbnail %>" alt="<%= v.title %>" loading="lazy" onerror="this.onerror=null;this.src='data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAzMjAgMTgwIj48cmVjdCBmaWxsPSIjMWExYTFlIiB3aWR0aD0iMzIwIiBoZWlnaHQ9IjE4MCIvPjwvc3ZnPg=='">
                  <div class="play-overlay"><span>&#9654;</span></div>
                </div>
                <div class="card-body">
                  <div class="card-title"><%= v.title %></div>
                  <div class="card-meta"><%= v.category %></div>
                </div>
              </a>
            <% }); %>
          </div>
        </div>
        <% } %>

        <div class="section-divider"></div>

        <%# ═══ RECENTLY ADDED ═══ %>
        <% if (typeof recent !== 'undefined' && recent.length > 0) { %>
        <div class="carousel-section">
          <div class="carousel-header">
            <div class="carousel-title">&#128337; Recently Added</div>
            <div class="carousel-nav">
              <button onclick="scrollCarousel('recentTrack',-1)">&lsaquo;</button>
              <button onclick="scrollCarousel('recentTrack',1)">&rsaquo;</button>
            </div>
          </div>
          <div class="carousel-track" id="recentTrack">
            <% recent.forEach(function(v) { %>
              <a href="/<%= v.id %>" class="v-card">
                <div class="thumb">
                  <img src="<%= v.thumbnail %>" alt="<%= v.title %>" loading="lazy" onerror="this.onerror=null;this.src='data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAzMjAgMTgwIj48cmVjdCBmaWxsPSIjMWExYTFlIiB3aWR0aD0iMzIwIiBoZWlnaHQ9IjE4MCIvPjwvc3ZnPg=='">
                  <div class="play-overlay"><span>&#9654;</span></div>
                </div>
                <div class="card-body">
                  <div class="card-title"><%= v.title %></div>
                  <div class="card-meta">
                    <%= new Date(v.uploaded).toLocaleDateString('en-US', { month:'short', day:'numeric' }) %>
                  </div>
                </div>
              </a>
            <% }); %>
          </div>
        </div>
        <% } %>

        <div class="section-divider"></div>

      </div>

      <%# ═══ SIDEBAR ═══ %>
      <aside class="player-sidebar">
        <div class="sidebar-card">
          <div class="sidebar-card-title">Video Stats</div>
          <div class="stats-grid">
            <div class="stat-item">
              <span class="stat-label">Duration</span>
              <span class="stat-value" id="duration-display">--:--</span>
            </div>
            <div class="stat-item">
              <span class="stat-label">Quality</span>
              <span class="stat-value">HD</span>
            </div>
            <div class="stat-item">
              <span class="stat-label">Category</span>
              <span class="stat-value" style="font-size:11px"><%= video.category || 'General' %></span>
            </div>
            <div class="stat-item">
              <span class="stat-label">Added</span>
              <span class="stat-value" style="font-size:11px"><%= new Date(video.uploaded).toLocaleDateString('en-US', { month:'short', day:'numeric', year:'numeric' }) %></span>
            </div>
          </div>
        </div>

        <%# UP NEXT QUEUE %>
        <% if (related.length > 0) { %>
        <div class="sidebar-card">
          <div class="sidebar-card-title"><%= ['▶ Senarai Main Xxx','▶ Up Next Xx','▶ Tonton Seterusnya Xxx','▶ Watch Next Xx','▶ Seterusnya Xxx'][Math.floor(Math.random()*5)] %></div>
          <div class="up-next-list">
            <% related.slice(0,15).forEach(function(v,i) { %>
              <a href="/<%= v.id %>" class="up-next-item<%= i === 0 ? ' active' : '' %>">
                <div class="up-next-thumb">
                  <img src="<%= v.thumbnail %>" alt="<%= v.title %> video" loading="lazy">
                  <span class="queue-num"><%= i + 1 %></span>
                </div>
                <div class="up-next-info">
                  <div class="up-next-title"><%= v.title.length > 50 ? v.title.substring(0,50)+'...' : v.title %></div>
                  <div class="up-next-meta"><%= v.category %></div>
                </div>
              </a>
            <% }); %>
          </div>
        </div>
        <% } %>

        <%# BROWSE BY CATEGORY %>
        <% if (typeof categoryGroups !== 'undefined' && categoryGroups.length > 0) { %>
        <div class="sidebar-card">
          <div class="sidebar-card-title">Browse Categories</div>
          <div class="sidebar-pills">
            <% categoryGroups.forEach(function(pair) { %>
              <a href="/?q=<%= encodeURIComponent(pair[0]) %>" class="<%= pair[0] === video.category ? 'active' : '' %>"><%= pair[0] %> <span style="opacity:0.5">(<%= pair[1].length %>)</span></a>
            <% }); %>
          </div>
        </div>
        <% } %>

        <%# TRENDING MINI %>
        <% if (typeof trending !== 'undefined' && trending.length > 0) { %>
        <div class="sidebar-card">
          <div class="sidebar-card-title">Trending</div>
          <div class="up-next-list">
            <% trending.slice(0,8).forEach(function(v,i) { %>
              <a href="/<%= v.id %>" class="up-next-item">
                <div class="up-next-thumb">
                  <img src="<%= v.thumbnail %>" alt="<%= v.title %> video" loading="lazy">
                </div>
                <div class="up-next-info">
                  <div class="up-next-title"><%= v.title.length > 40 ? v.title.substring(0,40)+'...' : v.title %></div>
                  <div class="up-next-meta"><%= v.category %></div>
                </div>
              </a>
            <% }); %>
          </div>
        </div>
        <% } %>

      </aside>
    </div>
  </main>

  <%- include('footer-component') %>

  <script>
    function esc(s) { return String(s).replace(/[&<>"']/g,function(m){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m];}); }

    var videoPlayer = document.getElementById('videoPlayer');
    if (videoPlayer) {
      videoPlayer.addEventListener('loadedmetadata', function() {
        var m = Math.floor(videoPlayer.duration / 60);
        var s = Math.floor(videoPlayer.duration % 60).toString().padStart(2, '0');
        document.getElementById('duration-display').textContent = m + ':' + s;
      });
      videoPlayer.addEventListener('play', function() {
        if (window.trackVideoPlay) window.trackVideoPlay('<%= video.id %>', '<%= displayTitle %>');
      });
    }

    fetch('/api/likes/<%= video.id %>').then(function(r){return r.json()}).then(function(d){var el=document.querySelector('.like-count');if(el)el.textContent=d.likes;}).catch(function(){});
    fetch('/api/view/<%= video.id %>', {method:'POST'}).then(function(r){return r.json()}).then(function(d){if(d.views!==undefined){var el=document.getElementById('viewCount');if(el)el.textContent=d.views.toLocaleString()+' views';}}).catch(function(){});

    function toggleLike(videoId, btn) {
      if (btn._liking) return;
      btn._liking = true;
      fetch('/api/likes/' + videoId, { method: 'POST' })
        .then(function(r) { return r.json(); })
        .then(function(data) {
          btn.querySelector('.like-count').textContent = data.likes;
          btn.classList.toggle('liked', data.liked);
        })
        .catch(function() {})
        .finally(function() { btn._liking = false; });
    }

    function copyLink() {
      navigator.clipboard.writeText(window.location.href);
      var btn = event && event.target ? event.target.closest('.action-btn') : null;
      if (btn) { var orig = btn.textContent; btn.textContent = 'Copied!'; setTimeout(function(){ btn.textContent = orig; }, 2000); }
    }

    function shareVideo() {
      if (navigator.share) {
        navigator.share({ title: '<%= displayTitle %>', url: window.location.href });
      } else { copyLink(); }
    }

    document.getElementById('searchBtn').addEventListener('click', function() {
      var q = document.getElementById('searchInput').value.trim();
      if (q) location.href = '/?q=' + encodeURIComponent(q);
    });
    document.getElementById('searchInput').addEventListener('keypress', function(e) {
      if (e.key === 'Enter') {
        var q = e.target.value.trim();
        if (q) location.href = '/?q=' + encodeURIComponent(q);
      }
    });

    /* ══════════════════════════════════════════════════════════════
       CAROUSEL SCROLL
       ══════════════════════════════════════════════════════════════ */
    function scrollCarousel(trackId, dir) {
      var track = document.getElementById(trackId);
      if (!track) return;
      var scrollAmt = track.clientWidth * 0.75;
      track.scrollBy({ left: dir * scrollAmt, behavior: 'smooth' });
    }

    /* ══════════════════════════════════════════════════════════════
       CARD REVEAL — staggered animation when sections enter view
       ══════════════════════════════════════════════════════════════ */
    (function() {
      var sections = document.querySelectorAll('.carousel-section, .cat-section');
      var allCards = document.querySelectorAll('.v-card');
      allCards.forEach(function(card) { card.style.opacity = '0'; });

      if ('IntersectionObserver' in window && sections.length) {
        var obs = new IntersectionObserver(function(entries) {
          entries.forEach(function(entry) {
            if (entry.isIntersecting) {
              var cards = entry.target.querySelectorAll('.v-card');
              cards.forEach(function(card, i) {
                card.style.transition = 'opacity 0.35s ease ' + (i % 8) * 0.05 + 's';
                card.style.opacity = '1';
              });
              obs.unobserve(entry.target);
            }
          });
        }, { rootMargin: '200px' });

        sections.forEach(function(sec) { obs.observe(sec); });
      } else {
        allCards.forEach(function(card) { card.style.opacity = '1'; });
      }
    })();

    /* ══════════════════════════════════════════════════════════════
       KEYBOARD SHORTCUTS + NAV PREFETCH + TOOLTIPS + SWIPE
       ══════════════════════════════════════════════════════════════ */
    (function() {
      var navPrev = document.getElementById('navPrev');
      var navNext = document.getElementById('navNext');

      /* Prefetch adjacent video HTML for instant navigation */
      function prefetchUrl(url) {
        if (!url || document.querySelector('link[rel="prefetch"][href="' + url + '"]')) return;
        var link = document.createElement('link');
        link.rel = 'prefetch';
        link.href = url;
        document.head.appendChild(link);
      }
      if (navPrev) prefetchUrl(navPrev.getAttribute('href'));
      if (navNext) prefetchUrl(navNext.getAttribute('href'));

      /* Keyboard: left/right = prev/next, space = play/pause, f = fullscreen */
      document.addEventListener('keydown', function(e) {
        if (e.target.tagName === 'INPUT') return;
        if (e.key === 'ArrowLeft' && navPrev) { navPrev.click(); e.preventDefault(); }
        else if (e.key === 'ArrowRight' && navNext) { navNext.click(); e.preventDefault(); }
        else if (e.key === ' ' && videoPlayer) { videoPlayer.paused ? videoPlayer.play() : videoPlayer.pause(); e.preventDefault(); }
        else if (e.key === 'f' && videoPlayer) { videoPlayer.requestFullscreen ? videoPlayer.requestFullscreen() : void(0); }
      });

      /* Touch swipe — swipe left = next, swipe right = prev */
      var touchStartX = 0;
      var touchStartY = 0;
      var wrapper = document.getElementById('videoWrapper');
      if (wrapper) {
        wrapper.addEventListener('touchstart', function(e) {
          touchStartX = e.touches[0].clientX;
          touchStartY = e.touches[0].clientY;
        }, { passive: true });
        wrapper.addEventListener('touchend', function(e) {
          var dx = e.changedTouches[0].clientX - touchStartX;
          var dy = e.changedTouches[0].clientY - touchStartY;
          if (Math.abs(dx) > 60 && Math.abs(dx) > Math.abs(dy) * 1.5) {
            if (dx < 0 && navNext) navNext.click();
            else if (dx > 0 && navPrev) navPrev.click();
          }
        }, { passive: true });
      }
    })();

    /* ══════════════════════════════════════════════════════════════
       MULTI-PREVIEW — smart 3-frame hover preview on video cards
       Start at 12s, smart timing for short/long videos
       ══════════════════════════════════════════════════════════════ */
    (function() {
      var previewVideo = document.createElement('video');
      previewVideo.preload = 'metadata';
      previewVideo.muted = true;
      previewVideo.playsInline = true;
      previewVideo.style.cssText = 'display:none;position:fixed;top:0;left:0;width:1px;height:1px;pointer-events:none;z-index:-1;';
      document.body.appendChild(previewVideo);

      var previewCanvas = document.createElement('canvas');
      previewCanvas.width = 320;
      previewCanvas.height = 180;
      var ctx = previewCanvas.getContext('2d');

      var hoverTimer = null;
      var activeCard = null;
      var isLoading = false;

      /* 3 previews starting at 12s */
      function getPreviewTimes(duration) {
        if (!duration || duration < 12) return [Math.max(0, Math.floor(duration * 0.3))];
        var step = Math.floor((duration - 12) / 3);
        if (step < 2) step = 2;
        return [12, Math.min(12 + step, duration - 1), Math.min(12 + step * 2, duration - 1)].filter(function(t, i, a) { return a.indexOf(t) === i && t < duration; });
      }

      function formatTime(sec) {
        var m = Math.floor(sec / 60);
        var s = Math.floor(sec % 60);
        return m + ':' + (s < 10 ? '0' : '') + s;
      }

      function buildPreviewStrip(card, times) {
        var existing = card.querySelector('.preview-strip');
        if (existing) existing.remove();
        var strip = document.createElement('div');
        strip.className = 'preview-strip';
        times.forEach(function(t) {
          var frame = document.createElement('div');
          frame.className = 'preview-frame';
          var cvs = document.createElement('canvas');
          cvs.width = 320;
          cvs.height = 180;
          cvs.dataset.time = t;
          var label = document.createElement('span');
          label.className = 'preview-time';
          label.textContent = formatTime(t);
          frame.appendChild(cvs);
          frame.appendChild(label);
          strip.appendChild(frame);
        });
        var thumb = card.querySelector('.thumb');
        if (thumb) {
          thumb.appendChild(strip);
          thumb.classList.add('preview-active');
        }
      }

      function captureFrame(video, canvas, time) {
        return new Promise(function(resolve) {
          var onSeeked = function() {
            video.removeEventListener('seeked', onSeeked);
            try {
              ctx.drawImage(video, 0, 0, canvas.width, canvas.height);
              var targetCtx = canvas.getContext('2d');
              targetCtx.drawImage(ctx.canvas, 0, 0, canvas.width, canvas.height);
              /* Apply brightness + warmth boost to the captured frame */
              try {
                var imgData = targetCtx.getImageData(0, 0, canvas.width, canvas.height);
                var d = imgData.data;
                for (var i = 0; i < d.length; i += 4) {
                  /* brightness +12% */
                  d[i]   = Math.min(255, d[i]   * 1.12);
                  d[i+1] = Math.min(255, d[i+1] * 1.10);
                  d[i+2] = Math.min(255, d[i+2] * 1.06);
                  /* warm skin tone shift: push reds up, blues down slightly */
                  if (d[i] > d[i+1] && d[i] > d[i+2]) {
                    d[i]   = Math.min(255, d[i] + 8);
                    d[i+1] = Math.min(255, d[i+1] + 2);
                  }
                }
                targetCtx.putImageData(imgData, 0, 0);
              } catch(e) {}
              resolve(true);
            } catch(e) { resolve(false); }
          };
          video.addEventListener('seeked', onSeeked);
          video.currentTime = time;
        });
      }

      async function generatePreviews(card, videoSrc, times) {
        if (isLoading) return;
        isLoading = true;
        activeCard = card;

        try {
          previewVideo.src = videoSrc;
          previewVideo.load();
          await new Promise(function(resolve, reject) {
            previewVideo.onloadedmetadata = resolve;
            previewVideo.onerror = reject;
            setTimeout(resolve, 3000);
          });

          var duration = previewVideo.duration;
          if (!duration || !isFinite(duration)) {
            isLoading = false;
            return;
          }

          var actualTimes = getPreviewTimes(duration);
          buildPreviewStrip(card, actualTimes);

          for (var i = 0; i < actualTimes.length; i++) {
            if (activeCard !== card) { isLoading = false; return; }
            await captureFrame(previewVideo, previewCanvas, actualTimes[i]);
            var cvs = card.querySelectorAll('.preview-strip canvas')[i];
            if (cvs) {
              cvs.getContext('2d').drawImage(previewCanvas, 0, 0, cvs.width, cvs.height);
              cvs.parentElement.classList.remove('preview-loading');
            }
          }
        } catch(e) {}
        isLoading = false;
      }

      function cleanPreview(card) {
        if (activeCard === card) {
          activeCard = null;
          isLoading = false;
        }
        var strip = card.querySelector('.preview-strip');
        if (strip) strip.remove();
        var thumb = card.querySelector('.thumb');
        if (thumb) thumb.classList.remove('preview-active');
        previewVideo.removeAttribute('src');
        previewVideo.load();
      }

      /* Attach hover events to all video cards */
      function attachPreviewListeners() {
        document.querySelectorAll('.v-card[href]').forEach(function(card) {
          if (card._previewBound) return;
          card._previewBound = true;
          var hoverDelay = null;
          var href = card.getAttribute('href');
          if (!href || href.indexOf('/') !== 0) return;
          var videoId = href.replace(/^\//, '');
          var videoSrc = '/raw/videos/' + videoId + '.mp4';

          card.addEventListener('mouseenter', function() {
            if (videoPlayer && videoId === '<%= video.id %>') return;
            hoverDelay = setTimeout(function() {
              generatePreviews(card, videoSrc);
            }, 400);
          });

          card.addEventListener('mouseleave', function() {
            if (hoverDelay) { clearTimeout(hoverDelay); hoverDelay = null; }
            cleanPreview(card);
          });
        });
      }

      attachPreviewListeners();

      /* Re-attach after dynamic content loads */
      var mainContent = document.querySelector('.player-main');
      if (mainContent) {
        new MutationObserver(function() { attachPreviewListeners(); }).observe(mainContent, { childList: true, subtree: true });
      }
    })();
  </script>

