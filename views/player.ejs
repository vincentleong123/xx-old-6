  <script>
  var carouselDotInit = function(id) {
    var track = document.getElementById('track-' + id);
    var dotsEl = document.getElementById('dots-' + id);
    if (!track || !dotsEl) return;
    var cards = track.querySelectorAll('.carousel-card');
    if (cards.length < 4) { dotsEl.style.display = 'none'; return; }
    var pages = Math.ceil(cards.length / 3);
    dotsEl.innerHTML = Array.from({ length: pages }, function(_, i) {
      return '<div class="carousel-dot' + (i === 0 ? ' active' : '') + '" data-page="' + i + '"></div>';
    }).join('');
    dotsEl.querySelectorAll('.carousel-dot').forEach(function(dot) {
      dot.addEventListener('click', function() {
        var pg = parseInt(this.dataset.page);
        var cw = cards[0].offsetWidth || 260;
        track.scrollTo({ left: pg * (cw + 12) * 3, behavior: 'smooth' });
      });
    });
    track.addEventListener('scroll', function() {
      var cw = cards[0].offsetWidth || 260;
      var totalW = cards.length * (cw + 12) - 12;
      var pct = track.scrollLeft / totalW;
      var activePage = Math.round(pct * pages);
      dotsEl.querySelectorAll('.carousel-dot').forEach(function(d, i) {
        d.classList.toggle('active', i === Math.min(activePage, pages - 1));
      });
    });
  };
  (function() {
    carouselDotInit('related');
    carouselDotInit('explore');
  })();
  </script>




  <!-- Sister site clickbait button removed -->

  <script>
    function esc(s) { return String(s).replace(/[&<>"']/g,function(m){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m];}); }

    function navigateTo(id) {
      location.href = '/' + id;
    }

    // Mobile nav
    function toggleMobileMenu() {
      var panel = document.getElementById('mobileNavPanel');
      var overlay = document.getElementById('navOverlay');
      if (!panel || !overlay) return;
      var isOpen = panel.classList.toggle('show');
      overlay.classList.toggle('show', isOpen);
      document.body.classList.toggle('sidebar-open', isOpen);
    }
    function closeMobileNav() {
      var panel = document.getElementById('mobileNavPanel');
      var overlay = document.getElementById('navOverlay');
      if (panel) panel.classList.remove('show');
      if (overlay) overlay.classList.remove('show');
      document.body.classList.remove('sidebar-open');
    }
    document.addEventListener('keydown', function(e) { if (e.key === 'Escape') closeMobileNav(); });
    document.addEventListener('click', function(e) {
      var btn = document.getElementById('mobileMenuBtn');
      if (btn && !btn.contains(e.target) && !e.target.closest('#mobileNavPanel') && !e.target.closest('.filter-overlay')) closeMobileNav();
    });





    const videoPlayer = document.getElementById('videoPlayer');

    if (videoPlayer) {
      videoPlayer.addEventListener('play', () => {
        if (window.trackVideoPlay) window.trackVideoPlay('<%= video.id %>', '<%= video.title %>');
      });

      videoPlayer.addEventListener('pause', () => {
        if (typeof gtag !== 'undefined') {
          gtag('event', 'video_pause', { content_id: '<%= video.id %>' });
        }
      });

      let progressMarkers = { 25: false, 50: false, 75: false, 100: false };
      videoPlayer.addEventListener('timeupdate', () => {
        if (!videoPlayer.duration) return;
        const percent = Math.round((videoPlayer.currentTime / videoPlayer.duration) * 100);
        [25, 50, 75, 100].forEach(marker => {
          if (!progressMarkers[marker] && percent >= marker) {
            progressMarkers[marker] = true;
            if (typeof gtag !== 'undefined') {
              gtag('event', 'video_progress', {
                content_id: '<%= video.id %>',
                percent_watched: marker,
                seconds_watched: Math.round(videoPlayer.currentTime)
              });
            }
          }
        });
      });

      videoPlayer.addEventListener('ended', () => {
        if (typeof gtag !== 'undefined') {
          gtag('event', 'video_ended', { content_id: '<%= video.id %>' });
        }
      });
    }

    document.getElementById('likeBtn').addEventListener('click', function() {
      this.classList.toggle('liked');
      const icon = this.querySelector('.action-icon');
      icon.textContent = this.classList.contains('liked') ? '❤️' : '🤍';
      if (typeof gtag !== 'undefined') {
        gtag('event', 'video_like', { content_id: '<%= video.id %>', liked: this.classList.contains('liked') });
      }
    });

    document.getElementById('subscribeBtn').addEventListener('click', function() {
      this.classList.toggle('subscribed');
      this.textContent = this.classList.contains('subscribed') ? 'Subscribed' : 'Subscribe';
      if (typeof gtag !== 'undefined') {
        gtag('event', 'subscribe', { content_id: '<%= video.id %>', subscribed: this.classList.contains('subscribed') });
      }
    });

    function copyLink() {
      navigator.clipboard.writeText(window.location.href);
      if (typeof gtag !== 'undefined') {
        gtag('event', 'share', { method: 'copy', content_id: '<%= video.id %>' });
      }
      alert('Link copied!');
    }

    function shareVideo() {
      if (navigator.share) {
        navigator.share({ title: '<%= video.title %>', url: window.location.href });
        if (typeof gtag !== 'undefined') {
          gtag('event', 'share', { method: 'native', content_id: '<%= video.id %>' });
        }
      } else {
        copyLink();
      }
    }

    // Track related video clicks
    document.addEventListener('click', (e) => {
      const relatedLink = e.target.closest('.related-card');
      if (relatedLink && typeof gtag !== 'undefined') {
        gtag('event', 'related_video_click', {
          content_id: '<%= video.id %>',
          clicked_title: relatedLink.querySelector('h4')?.textContent || ''
        });
      }
    });
    document.getElementById('searchBtn').addEventListener('click', () => {
      const q = document.getElementById('searchInput').value.trim();
      if (q) location.href = '/?q=' + encodeURIComponent(q);
    });

    document.getElementById('searchInput').addEventListener('keypress', (e) => {
      if (e.key === 'Enter') {
        const q = e.target.value.trim();
        if (q) location.href = '/?q=' + encodeURIComponent(q);
      }
    });

    let relatedPage = 2;
    async function loadMoreRelated() {
      const btn = document.querySelector('#loadMoreRelated button');
      const container = document.getElementById('relatedGrid');
      btn.textContent = 'Loading...';
      btn.disabled = true;

      try {
        const res = await fetch(`/api/search?limit=8&page=${relatedPage}`);
        const data = await res.json();

        data.videos.forEach(v => {
          container.insertAdjacentHTML('beforeend', `
            <div class="related-card" data-preview="${v.video}" data-id="${v.id}" onclick="navigateTo('${v.id}')">
              <div class="related-thumb">
                <img src="${v.thumbnail}" alt="${v.title}" loading="lazy" onerror="this.onerror=null;this.src='data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAzMjAgMTgwIj48cmVjdCBmaWxsPSIjMWExYTFlIiB3aWR0aD0iMzIwIiBoZWlnaHQ9IjE4MCIvPjwvc3ZnPg=='">
                <video class="related-preview" muted loop preload="none" playsinline></video>
                <span class="duration-badge">--:--</span>
              </div>
              <div class="related-info">
                <h4>${v.title}</h4>
                <span class="meta-row">${v.views.toLocaleString()} views</span>
              </div>
            </div>
          `);
        });

        relatedPage++;
        if (!data.hasMore) {
          document.getElementById('loadMoreRelated').style.display = 'none';
        }
      } catch (e) {
        console.error(e);
      } finally {
        btn.textContent = 'Load More';
        btn.disabled = false;
      }
    }





</script>

