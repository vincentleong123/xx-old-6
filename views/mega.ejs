<style>
/* Mega X Melayu — bigger, bolder, crunchier. In your face. */
:root {
  --mega-card-min: 320px;
  --mega-gap: 18px;
  --mega-border: rgba(255,215,0,0.15);
  --mega-shadow: 0 4px 24px rgba(255,45,85,0.08);
  --mega-shadow-hover: 0 12px 48px rgba(255,45,85,0.25), 0 0 0 2px rgba(255,215,0,0.2);
  --mega-gold: #ffd700;
  --mega-accent: #ff2d55;
}
/* Hero */
.mega-hero { text-align:center; padding:56px 20px 36px; position:relative; overflow:hidden; border-radius:20px; margin:0 0 24px; background:linear-gradient(135deg,#0d0d12 0%,#1a0a14 50%,#0d0d12 100%); border:2px solid var(--mega-border); }
.mega-hero::before { content:''; position:absolute; inset:0; background:radial-gradient(ellipse at 30% 50%,rgba(255,45,85,0.15),transparent 60%),radial-gradient(ellipse at 70% 50%,rgba(255,215,0,0.08),transparent 60%); pointer-events:none; }
.mega-hero-badge { display:inline-block; padding:6px 20px; border-radius:999px; font-size:13px; font-weight:800; text-transform:uppercase; letter-spacing:2px; margin-bottom:16px; background:linear-gradient(90deg,#ff2d55,#ffd700); color:#fff; box-shadow:0 0 30px rgba(255,45,85,0.4); }
.mega-hero h1 { font-size:clamp(36px,6vw,60px); font-weight:900; line-height:1.1; margin-bottom:10px; background:linear-gradient(135deg,#ff2d55 0%,#ff6b35 40%,#ffd700 70%,#ff2d55 100%); background-size:200% auto; -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text; animation:mega-shimmer 4s ease-in-out infinite; }
@keyframes mega-shimmer { 0%,100%{background-position:0% center} 50%{background-position:200% center} }
.mega-hero-sub { font-size:clamp(16px,2.5vw,22px); color:#b0b0b8; margin-bottom:8px; font-weight:600; }
.mega-hero-stats { font-size:14px; color:#6b6b75; margin-top:12px; }
.mega-hero-stats strong { color:#ffd700; font-size:18px; }

/* Main content — full width, no sidebar */
.content-area { width:100%; max-width:100%; }

/* Grid — permanently mega-sized */
.grid-43 { grid-template-columns:repeat(auto-fill,minmax(var(--mega-card-min),1fr)); gap:var(--mega-gap); }
.card-43 { border-color:var(--mega-border); box-shadow:var(--mega-shadow); }
.card-43:hover { border-color:var(--mega-gold); box-shadow:var(--mega-shadow-hover); transform:translateY(-6px) scale(1.02); }
.card-43 .thumb { aspect-ratio:4/3; }
.card-43 .thumb img { filter:contrast(1.15) brightness(1.05) saturate(1.3); }
.card-43:hover .thumb img { transform:scale(1.08); }
.card-43 .ctitle { font-size:15px; font-weight:700; }
.card-43 .cmeta { font-size:12px; color:var(--mega-gold); }
.card-43 .views { font-size:13px; padding:5px 12px; background:rgba(0,0,0,0.92); font-weight:700; }
.card-43 .float-btn { width:36px; height:36px; font-size:16px; background:rgba(255,45,85,0.6); border-color:rgba(255,215,0,0.3); }

/* Keyword badges — bigger */
.kw-pill, .kw-ribbon, .kw-tag, .kw-glow, .kw-stamp, .kw-underline { font-size:11px !important; }
.card-43 .diagonal-badge { font-size:10px !important; padding:3px 10px 3px 14px !important; }
/* Skeleton loading */
.skeleton-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(var(--mega-card-min),1fr)); gap:var(--mega-gap); padding:16px 0; }
.skeleton-card { background:linear-gradient(90deg,var(--bg-tertiary) 25%,var(--bg-card) 50%,var(--bg-tertiary) 75%); background-size:200% 100%; animation:mega-shimmer-card 1.5s infinite; aspect-ratio:4/3; border-radius:12px; padding-bottom:52px; box-sizing:content-box; }
@keyframes mega-shimmer-card { 0%{background-position:200% 0} 100%{background-position:-200% 0} }

/* Responsive */
@media (max-width:768px) {
  .grid-43 { grid-template-columns:repeat(2,1fr); gap:12px; }
  .card-43 .thumb { aspect-ratio:16/11; }
  :root { --mega-card-min: 280px; }
}
@media (max-width:480px) {
  .grid-43 { grid-template-columns:repeat(2,1fr); gap:8px; }
  .card-43 { border-radius:8px; }
  :root { --mega-card-min: 200px; }
}
</style>
