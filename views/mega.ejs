<script>
// ─── State ───
const MEGA_VIDEOS = <%- JSON.stringify(videos) %>;
const state = {
  videos: [...MEGA_VIDEOS],
  page: 1,
  loading: false,
  hasMore: true,
  limit: 24,
  searchQuery: '',
  categoryFilter: '',
  sortBy: 'newest'
};

// ─── Render ───
function createVideoCard(v) {
  const kwHtml = getKeywordRibbon() || '';
  const b64 = btoa(v.id).slice(0, 8);
  return `<a href="/${v.id}" class="card-43" data-id="${v.id}" style="animation-delay:${Math.random() * 0.3}s">
    <div class="thumb">
      <div class="img-shimmer"></div>
      <img src="${v.thumbnail}" alt="${v.title}" loading="lazy" decoding="async" width="320" height="240" onerror="this.parentElement.querySelector('.img-shimmer').style.display='none'">
      <div class="overlay"></div>
      <span class="views">👁️ ${v.views}</span>
      <div class="float-btn" onclick="event.preventDefault();event.stopPropagation();toggleFloat('${v.id}')">▶</div>
      ${kwHtml}
    </div>
    <div class="card-body">
      <div class="ctitle">${v.title}</div>
      <div class="cmeta">${v.category} · ${v.subTags.slice(0, 2).join(', ')}</div>
    </div>
  </a>`;
}

function createCompactCard(v) {
  return `<a href="/${v.id}" class="card-mini" data-id="${v.id}">
    <div class="thumb">
      <div class="img-shimmer"></div>
      <img src="${v.thumbnail}" alt="${v.title}" loading="lazy" decoding="async" width="160" height="120" onerror="this.parentElement.querySelector('.img-shimmer').style.display='none'">
      <div class="overlay"></div>
      <span class="views">👁️ ${v.views}</span>
    </div>
    <div class="card-body">
      <div class="ctitle">${v.title}</div>
    </div>
  </a>`;
}

// ─── Keyword Ribbon ───
const KEYWORDS = ['awek tudung','melayu xxx','malay porn','skandal','video rakam','bilik tidur','terkini','lucah','seks','malaysian','chinese','xx','amatuer','xxx','matuer','xamateur','bokep','indonesia','jilbab','tudung','main','terbaru','viral','hot','sexy','montok','gemuk','chubby','bogel','telanjang','dalam','kereta','kolej','universiti','asrama','bini orang','janda','tetangga','curi','dengar','ngintip','memek','kontol','ngewe','colok','ngentot','sangek','sange','sange','masturbasi','coli','onani','pamer','show','live','stream','cam','telegram','whatsapp','wecam','omegle','chat','video call','ml','relationship','couple','kekasih','pacar','suami','istri','pasangan','rumah','pribadi','privat','exclusive','rare','langka','sukar','cari'];
const GRADIENTS = ['linear-gradient(135deg,#ff2d55,#ff6b35)','linear-gradient(135deg,#2979ff,#00e676)','linear-gradient(135deg,#8e2de2,#4a00e0)','linear-gradient(135deg,#ffd700,#ff6b35)','linear-gradient(135deg,#00e676,#2979ff)','linear-gradient(135deg,#ff6b35,#ff2d55)','linear-gradient(135deg,#4a00e0,#8e2de2)','linear-gradient(135deg,#ff2d55,#ffd700)','linear-gradient(135deg,#ff1744,#ff9100)','linear-gradient(135deg,#00bfa5,#2979ff)'];
const SHAPES = ['kw-pill','kw-ribbon','kw-tag','kw-glow','kw-stamp','kw-underline','kw-bracket-wrap'];
let _kwIdx = 0;
let _skipCounter = 0;
function getKeywordRibbon() {
  _skipCounter++;
  if (_skipCounter < Math.floor(Math.random() * 3) + 1) return '';
  _skipCounter = 0;
  const kw = KEYWORDS[_kwIdx % KEYWORDS.length];
  _kwIdx++;
  const grad = GRADIENTS[_kwIdx % GRADIENTS.length];
  const shape = SHAPES[_kwIdx % SHAPES.length];
  if (shape === 'kw-bracket-wrap') return `<span class="kw-bracket-wrap" style="color:#fff;text-shadow:0 0 4px rgba(0,0,0,0.8)"><strong style="background:${grad};-webkit-background-clip:text;-webkit-text-fill-color:transparent">[</strong>${kw}<strong style="background:${grad};-webkit-background-clip:text;-webkit-text-fill-color:transparent">]</strong></span>`;
  return `<span class="${shape}" style="background:${grad};color:#fff">${kw}</span>`;
}

// ─── Load & Filter ───
function filterVideos() {
  let list = [...MEGA_VIDEOS];
  const q = state.searchQuery.toLowerCase().trim();
  if (q) {
    const terms = q.split(/\s+/).filter(t => t.length > 1);
    list = list.filter(v => {
      const text = (v.title + ' ' + v.keywords.join(' ')).toLowerCase();
      return terms.some(t => text.includes(t));
    });
  }
  if (state.categoryFilter) list = list.filter(v => v.category.toLowerCase() === state.categoryFilter);
  if (state.sortBy === 'views') list.sort((a, b) => b.views - a.views);
  else if (state.sortBy === 'likes') list.sort((a, b) => b.likes - a.likes);
  else list.sort((a, b) => new Date(b.uploaded) - new Date(a.uploaded));
  return list;
}

function showNextBatch() {
  if (state.loading || !state.hasMore) return;
  state.loading = true;
  const filtered = filterVideos();
  const start = (state.page - 1) * state.limit;
  const batch = filtered.slice(start, start + state.limit);
  if (!batch.length) { state.hasMore = false; document.getElementById('loadingIndicator').style.display = 'none'; state.loading = false; return; }
  const grid = document.getElementById('videoGrid');
  const skeleton = document.getElementById('skeletonGrid');
  if (skeleton) skeleton.style.display = 'none';
  batch.forEach(v => { grid.insertAdjacentHTML('beforeend', createVideoCard(v)); });
  document.getElementById('loadingIndicator').style.display = state.hasMore ? 'block' : 'none';
  document.getElementById('megaResultInfo').textContent = `${Math.min(start + state.limit, filtered.length)} / ${filtered.length}`;
  if (filtered.length <= start + state.limit) state.hasMore = false;
  state.page++;
  state.loading = false;
}

function loadVideos() {
  state.page = 1;
  state.hasMore = true;
  document.getElementById('videoGrid').innerHTML = '';
  document.getElementById('noResults').style.display = 'none';
  const filtered = filterVideos();
  if (!filtered.length) {
    document.getElementById('skeletonGrid').style.display = 'none';
    document.getElementById('noResults').style.display = 'block';
    document.getElementById('megaResultInfo').textContent = '0 / 0';
    return;
  }
  document.getElementById('loadingIndicator').style.display = 'block';
  showNextBatch();
}

function handleSortChange() { state.sortBy = document.getElementById('sortSelect').value; loadVideos(); }
function handleFilterChange() { state.categoryFilter = document.getElementById('categoryFilter').value; loadVideos(); }
function resetFilters() {
  document.getElementById('sortSelect').value = 'newest';
  document.getElementById('categoryFilter').value = '';
  document.getElementById('searchInput').value = '';
  state.searchQuery = '';
  state.categoryFilter = '';
  state.sortBy = 'newest';
  loadVideos();
}

// ─── Floating Player ───
function toggleFloat(id) {
  const v = MEGA_VIDEOS.find(x => x.id === id);
  if (!v) return;
  if (window.__floatEl) { window.__floatEl.remove(); window.__floatEl = null; }
  const el = document.createElement('div');
  el.id = 'floatingPlayer';
  el.innerHTML = `<div style="position:fixed;bottom:20px;right:20px;z-index:9999;width:320px;background:#000;border-radius:12px;overflow:hidden;box-shadow:0 8px 40px rgba(0,0,0,0.8);border:1px solid rgba(255,255,255,0.1)"><button onclick="this.parentElement.remove();window.__floatEl=null" style="position:absolute;top:4px;right:4px;z-index:10;background:rgba(0,0,0,0.7);color:#fff;border:none;border-radius:50%;width:24px;height:24px;cursor:pointer;font-size:14px">×</button><video src="${v.video}" autoplay loop muted playsinline style="width:100%;display:block;aspect-ratio:16/11"></video></div>`;
  document.body.appendChild(el);
  window.__floatEl = el;
}

// ─── Scroll-based loading ───
const scrollTrigger = document.getElementById('scrollTrigger');
const scrollObserver = new IntersectionObserver(entries => {
  if (entries[0].isIntersecting) showNextBatch();
}, { rootMargin: '400px' });
scrollObserver.observe(scrollTrigger);

// ─── Search ───
document.getElementById('searchBtn')?.addEventListener('click', () => {
  state.searchQuery = document.getElementById('searchInput').value;
  loadVideos();
});
document.getElementById('searchInput')?.addEventListener('keydown', e => {
  if (e.key === 'Enter') { state.searchQuery = document.getElementById('searchInput').value; loadVideos(); }
});

// ─── Mobile menu ───
function toggleMobileMenu() {
  const nav = document.getElementById('navLinks');
  const btn = document.getElementById('mobileMenuBtn');
  const expanded = nav.style.display === 'flex';
  nav.style.display = expanded ? 'none' : 'flex';
  btn.setAttribute('aria-expanded', !expanded);
}

// ─── Init ───
document.addEventListener('DOMContentLoaded', () => {
  loadVideos();
});
</script>
