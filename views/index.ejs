<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Lucahman - Loading...</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Inter', sans-serif;
      background: #0a0a0b;
      color: white;
      height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
    }
    .logo { 
      font-size: 48px; 
      font-weight: 800; 
      background: linear-gradient(135deg, #ff2d55, #ff4d6f);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      margin-bottom: 24px;
      animation: bounce 2s infinite;
    }
    @keyframes bounce {
      0%, 20%, 50%, 80%, 100% { transform: translateY(0); }
      40% { transform: translateY(-10px); }
      60% { transform: translateY(-5px); }
    }
    .spinner {
      width: 60px;
      height: 60px;
      border: 4px solid #1a1a1e;
      border-top: 4px solid #ff2d55;
      border-radius: 50%;
      animation: spin 1s linear infinite;
      margin: 32px auto;
    }
    @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
    .status { font-size: 18px; color: #a0a0a8; margin-bottom: 8px; }
    .count { font-size: 24px; font-weight: 700; color: #ff2d55; }
    .announcement { 
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      background: linear-gradient(135deg, #ff2d55, #ff4d6f);
      color: white;
      padding: 12px;
      font-weight: 600;
      box-shadow: 0 4px 20px rgba(255,45,85,0.4);
      animation: pulse 2s infinite;
    }
    @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.9; } }
  </style>
</head>
<body>
<!-- display ads only (no popunder) -->
  <div class="announcement">
    New viral video launching Wednesday 10PM! 🚀 Stay tuned!
  </div>
  
  <div class="logo">Lucahman</div>
  
  <div class="spinner"></div>
  
  <div class="status">Loading <span class="count" id="videoCount">0</span> videos...</div>
  
  <script>
    let count = 0;
    const counter = document.getElementById('videoCount');
    const timer = setInterval(() => {
      count += Math.floor(Math.random() * 100) + 50;
      counter.textContent = count.toLocaleString();
      if (count > 5000) {
        clearInterval(timer);
        setTimeout(() => location.href = '/gallery || /', 500);
      }
    }, 50);
  </script>
</body>
</html>
