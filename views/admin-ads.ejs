<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Ad Manager</title>
  <meta name="robots" content="noindex, nofollow">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      background: #0a0a0b; color: #e0e0e0; padding: 20px;
    }
    .admin-nav { display: flex; gap: 4px; margin-bottom: 24px; background: #1a1a1e; border-radius: 12px; padding: 4px; }
    .admin-nav a {
      padding: 10px 20px; border-radius: 8px; text-decoration: none;
      color: #6b6b75; font-size: 13px; font-weight: 500; transition: all .2s;
    }
    .admin-nav a:hover { color: #fff; background: #2a2a30; }
    .admin-nav a.active { color: #fff; background: #ff2d55; }
    h1 { color: #ff2d55; margin-bottom: 20px; font-size: 24px; }
    .back-link { color: #ff2d55; text-decoration: none; font-size: 13px; display: inline-block; margin-bottom: 16px; }
    .back-link:hover { text-decoration: underline; }
    .card {
      background: #1a1a1e; border: 1px solid #2a2a30; border-radius: 12px; padding: 24px;
      margin-bottom: 20px;
    }
    .card h2 { font-size: 15px; color: #fff; margin-bottom: 16px; }
    .card label { display: block; color: #a0a0a8; font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 6px; margin-top: 14px; }
    .card label:first-child { margin-top: 0; }
    .card input {
      width: 100%; padding: 10px 14px; background: #0a0a0b; border: 1px solid #2a2a30;
      border-radius: 8px; color: #fff; font-size: 13px;
    }
    .card input:focus { outline: none; border-color: #ff2d55; }
    .btn {
      padding: 10px 24px; border-radius: 8px; border: none; font-size: 13px;
      font-weight: 600; cursor: pointer; transition: all .2s; margin-top: 16px;
    }
    .btn-primary { background: #ff2d55; color: #fff; }
    .btn-primary:hover { background: #ff4d6f; }
    .btn-secondary { background: #2a2a30; color: #a0a0a8; }
    .btn-secondary:hover { background: #3a3a40; color: #fff; }
    .btn-danger { background: #cc2233; color: #fff; }
    .btn-danger:hover { background: #dd3344; }
    .banner-item {
      display: flex; gap: 12px; align-items: center; padding: 12px;
      background: #0a0a0b; border: 1px solid #2a2a30; border-radius: 8px; margin-bottom: 8px;
    }
    .banner-item input { flex: 1; margin-top: 0; }
    .banner-item .btn { margin-top: 0; white-space: nowrap; }
    .banner-item .drag { color: #6b6b75; cursor: grab; font-size: 18px; }
    .status { padding: 8px 16px; border-radius: 8px; font-size: 13px; margin-bottom: 16px; display: none; }
    .status.success { display: block; background: rgba(52,199,89,0.15); color: #34c759; border: 1px solid rgba(52,199,89,0.3); }
    .status.error { display: block; background: rgba(255,45,85,0.15); color: #ff2d55; border: 1px solid rgba(255,45,85,0.3); }
  </style>
</head>
<body>
  <a href="/admin" class="back-link">← Back to Dashboard</a>
  <h1>Ad Manager</h1>

  <div class="admin-nav">
    <a href="/admin">Dashboard</a>
    <a href="/admin/pages">Pages</a>
    <a href="/admin/videos">Videos</a>
    <a href="/admin/ads" class="active">Ads</a>
    <a href="/admin/keywords">Keywords</a>
    <a href="/admin/super-x">Super X</a>
  </div>

  <div class="status" id="status"></div>

  <div class="card">
    <h2>VAST Ad Configuration</h2>
    <label>VAST Ad URL (primary)</label>
    <input type="text" id="vastUrl" placeholder="https://example.com/vast.xml">
    <label>VAST Fallback URL</label>
    <input type="text" id="vastFallback" placeholder="Fallback if primary fails">
  </div>

  <div class="card">
    <h2>Banner Ads</h2>
    <div id="bannerList"></div>
    <button class="btn btn-secondary" onclick="addBanner()">+ Add Banner</button>
  </div>

  <div class="card">
    <h2>PiP Skyscraper Ads (Desktop, 160×600)</h2>
    <p style="color:#6b6b75;font-size:12px;margin-bottom:12px">These fixed-position 160×600 skyscrapers appear left/right of the floating PiP player on desktop (≥1024px). Paste the full ad snippet (ins + script tags).</p>
    <label>Left Skyscraper Ad Code</label>
    <textarea id="pipLeft" rows="4" style="width:100%;padding:10px 14px;background:#0a0a0b;border:1px solid #2a2a30;border-radius:8px;color:#fff;font-size:13px;font-family:monospace;resize:vertical"></textarea>
    <label>Right Skyscraper Ad Code</label>
    <textarea id="pipRight" rows="4" style="width:100%;padding:10px 14px;background:#0a0a0b;border:1px solid #2a2a30;border-radius:8px;color:#fff;font-size:13px;font-family:monospace;resize:vertical"></textarea>
  </div>

  <div class="card" style="display:flex;gap:12px">
    <button class="btn btn-primary" onclick="saveConfig()">Save Ad Config</button>
    <button class="btn btn-secondary" onclick="loadConfig()">Reset Form</button>
  </div>

  <script>
    let config = { vastUrl: '', vastFallbackUrl: '', banners: [], pipAds: { left: '', right: '' } };

    async function loadConfig() {
      try {
        const res = await fetch('/api/admin/ads');
        config = await res.json();
        if (!config.banners) config.banners = [];
        if (!config.pipAds) config.pipAds = { left: '', right: '' };
        document.getElementById('vastUrl').value = config.vastUrl || '';
        document.getElementById('vastFallback').value = config.vastFallbackUrl || '';
        document.getElementById('pipLeft').value = config.pipAds.left || '';
        document.getElementById('pipRight').value = config.pipAds.right || '';
        renderBanners();
      } catch { console.error('Failed to load ad config'); }
    }

    function renderBanners() {
      const el = document.getElementById('bannerList');
      el.innerHTML = config.banners.map((b, i) => `
        <div class="banner-item">
          <span class="drag">☰</span>
          <input type="text" value="${b.url || ''}" placeholder="Banner URL" onchange="config.banners[${i}].url = this.value">
          <input type="text" value="${b.image || ''}" placeholder="Image URL (optional)" onchange="config.banners[${i}].image = this.value">
          <input type="text" value="${b.label || ''}" placeholder="Label (optional)" onchange="config.banners[${i}].label = this.value" style="max-width:150px">
          <button class="btn btn-danger" onclick="removeBanner(${i})">✕</button>
        </div>
      `).join('');
    }

    function addBanner() {
      config.banners.push({ url: '', image: '', label: '' });
      renderBanners();
    }

    function removeBanner(i) {
      config.banners.splice(i, 1);
      renderBanners();
    }

    async function saveConfig() {
      const data = {
        vastUrl: document.getElementById('vastUrl').value,
        vastFallbackUrl: document.getElementById('vastFallback').value,
        banners: config.banners,
        pipAds: {
          left: document.getElementById('pipLeft').value,
          right: document.getElementById('pipRight').value
        }
      };
      const status = document.getElementById('status');
      try {
        const res = await fetch('/api/admin/ads', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });
        const result = await res.json();
        if (result.success) {
          status.className = 'status success';
          status.textContent = 'Ad config saved successfully!';
        } else {
          status.className = 'status error';
          status.textContent = 'Failed to save.';
        }
      } catch {
        status.className = 'status error';
        status.textContent = 'Network error.';
      }
      status.style.display = 'block';
      setTimeout(() => status.style.display = 'none', 5000);
    }

    loadConfig();
  </script>
</body>
</html>
