        `).join('');
      }

      if (section) section.style.display = 'block';

      NAMED_CAROUSELS[id] = { videos: slice, idx: 0, playing: true, interval: null };

      const pages = Math.ceil(slice.length / 3);
      if (dotsEl) dotsEl.innerHTML = Array.from({ length: pages }, (_, i) =>
        `<div class="carousel-dot ${i === 0 ? 'active' : ''}" onclick="goToNamedSlide('${id}', ${i})"></div>`
      ).join('');

      startNamedCarousel(id);
    }

    function startNamedCarousel(id) {
      const c = NAMED_CAROUSELS[id];
      if (!c) return;
      if (c.interval) clearInterval(c.interval);
      if (!c.playing) return;
      c.interval = setInterval(() => {
        c.idx = (c.idx + 1) % Math.ceil(c.videos.length / 3);
        updateNamedCarousel(id);
      }, 5000);
    }

    function toggleNamedCarousel(id) {
      const c = NAMED_CAROUSELS[id];
      if (!c) return;
      c.playing = !c.playing;
      const el = document.getElementById('play-' + id);
      if (el) el.textContent = c.playing ? '⏸️' : '▶️';
      if (c.playing) startNamedCarousel(id);
      else if (c.interval) clearInterval(c.interval);
    }

    function goToNamedSlide(id, idx) {
      const c = NAMED_CAROUSELS[id];
      if (!c) return;
      c.idx = idx;
      updateNamedCarousel(id);
      startNamedCarousel(id);
    }

    function updateNamedCarousel(id) {
      const c = NAMED_CAROUSELS[id];
      if (!c) return;
      const track = document.getElementById('track-' + id);
      if (!track) return;
      const cardWidth = track.querySelector('.carousel-card')?.offsetWidth || 0;
      const gap = 12;
      const offset = c.idx * (cardWidth + gap) * 3;
      track.style.transform = `translateX(-${offset}px)`;
      const dotsEl = document.getElementById('dots-' + id);
      if (dotsEl) {
        dotsEl.querySelectorAll('.carousel-dot').forEach((dot, i) => {
          dot.classList.toggle('active', i === c.idx);
