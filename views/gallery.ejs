    // ---- NAMED CAROUSELS (auto-play keyword carousels) ----
    const NAMED_CAROUSELS = {};

    function renderNamedCarousel(id, videos) {
      const section = document.getElementById('carousel-' + id);
      if (!videos || videos.length < 3) {
        if (section) section.style.display = 'none';
        return;
