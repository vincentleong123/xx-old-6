      video.preload = 'auto';
      video.play().catch(() => {});
      gridPreviews.set(vid, { video, el });
      if (gridPreviews.size > previewLimits) {
        const oldest = gridPreviews.entries().next().value;
        if (oldest) {
          oldest[1].video.pause();
          oldest[1].video.removeAttribute('src');
          oldest[1].video.load();
          gridPreviews.delete(oldest[0]);
