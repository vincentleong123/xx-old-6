.badge-bini { background:rgba(255,51,102,0.82); }
.badge-chubby { background:rgba(255,153,204,0.82); }
.badge-indo { background:rgba(255,136,0,0.82); }
.badge-thai { background:rgba(255,68,170,0.82); }
.badge-kolej { background:rgba(68,170,255,0.82); }
