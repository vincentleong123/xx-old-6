    // SMART 4-CARD PREVIEW BATCH — auto-evicts oldest when full
    const batchPreview = {
      maxConcurrent: 4,
      startAt: 0.10,
      endAt: 3.5,
      minInViewRatio: 0.45,
      playing: new Set(),
      playOrder: [], // tracks insertion order for LRU eviction
      cardMap: new Map(), // vid -> {card, video, thumb}
      urlCache: new Map() // urlBase -> urlWithTime
    };

    function ensureVideo(card) {
      return card.querySelector('.video-thumb video, .card-preview, .hero-preview');
    }

    function startCard(card) {
      const vid = card.dataset.videoId || card.dataset.id || card.dataset.preview;
      const video = ensureVideo(card);
      const url = card.dataset.preview;
      const thumb = card.querySelector('img');
      if (!vid || !video || !url) return;
      if (batchPreview.playing.has(vid)) return;
      // Evict oldest when at capacity
      if (batchPreview.playing.size >= batchPreview.maxConcurrent) {
        const oldestVid = batchPreview.playOrder.shift();
        if (oldestVid) stopCard(oldestVid);
      }

      try {
        video.preload = 'metadata';
        video.src = url + '#t=' + batchPreview.startAt + ',' + batchPreview.endAt;
        video.muted = true;
        video.currentTime = batchPreview.startAt;
        const p = video.play();
        if (p && p.catch) p.catch(() => {});
        batchPreview.playing.add(vid);
        batchPreview.playOrder.push(vid);
        batchPreview.cardMap.set(vid, { card, video, thumb });
        // Crossfade: thumbnail fades out, video fades in
        if (thumb) thumb.style.opacity = '0';
        video.style.opacity = '1';
      } catch {}
    }

    function stopCard(cardOrVid) {
      const entry = typeof cardOrVid === 'string' ? batchPreview.cardMap.get(cardOrVid) : null;
      const card = entry?.card || (cardOrVid?.dataset ? cardOrVid : null);
      const vid = entry ? (entry.video?.dataset?.id || cardOrVid) : (card?.dataset?.videoId || card?.dataset?.id || card?.dataset?.preview);
      const video = entry?.video || (card ? ensureVideo(card) : null);
      const thumb = entry?.thumb || (card ? card.querySelector('img') : null);
      if (!vid || !video) return;

      try {
        video.pause();
        video.removeAttribute('src');
        video.load();
        if (thumb) thumb.style.opacity = '1';
        video.style.opacity = '0';
      } catch {}

      batchPreview.playing.delete(vid);
      batchPreview.playOrder = batchPreview.playOrder.filter(v => v !== vid);
      batchPreview.cardMap.delete(vid);
    }

    const previewQueue = [];
    const queued = new Set();
    let ticking = false;

    function enqueue(card) {
      const vid = card.dataset.videoId || card.dataset.id || card.dataset.preview;
      if (!vid || queued.has(vid)) return;
      queued.add(vid);
      previewQueue.push({ card, vid });
      if (!ticking) processQueue();
    }

    function processQueue() {
      ticking = true;
      setTimeout(() => {
        ticking = false;
        while (previewQueue.length && batchPreview.playing.size < batchPreview.maxConcurrent) {
          const { card, vid } = previewQueue.shift();
          queued.delete(vid);
          if (!card || !document.body.contains(card)) continue;

          const rect = card.getBoundingClientRect();
          const inView = rect.top < window.innerHeight && rect.bottom > 0;
          if (!inView) { stopCard(vid); continue; }

          // start only if still meets ratio
          if (rect.height > 0) {
            const ratio = Math.min(window.innerHeight, rect.bottom) - Math.max(0, rect.top);
            const inRatio = ratio / rect.height >= batchPreview.minInViewRatio;
            if (!inRatio) { continue; }
          }

          startCard(card);
        }
      }, 0);
    }

    const previewIO = new IntersectionObserver((entries) => {
      for (const en of entries) {
        const card = en.target;
        const vid = card.dataset.videoId || card.dataset.id || card.dataset.preview;
        if (!vid) continue;

        if (en.isIntersecting && en.intersectionRatio >= batchPreview.minInViewRatio) {
          enqueue(card);
        } else {
          stopCard(vid);
          queued.delete(vid);
        }
      }
    }, { rootMargin: '0px', threshold: [0, 0.45, 0.7, 1] });

    function observePreviews() {
      document.querySelectorAll('.video-card, .card-43, .card-mini, .hero-main, .hero-side-card')
        .forEach(card => { if (card.dataset.preview) previewIO.observe(card); });
    }

