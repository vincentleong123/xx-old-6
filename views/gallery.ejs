<style>
.super-x { text-align:center; padding:18px 16px 12px; position:relative; overflow:hidden; border-radius:12px; margin:0 0 12px; background:linear-gradient(135deg,#0d0d12 0%,#1a0a14 50%,#0d0d12 100%); border:1px solid rgba(255,45,85,0.15); }
.super-x-badge { display:inline-block; padding:3px 12px; border-radius:12px; font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:1px; margin-bottom:6px; background:linear-gradient(90deg,#ff2d55,#ff6b35); color:#fff; }
.hero-section { text-align:center; padding:14px 12px 10px; border-bottom:1px solid rgba(255,255,255,0.06); margin-bottom:10px; }
.hero-section h1 { font-size:clamp(16px,2vw,24px); font-weight:800; text-align:center; margin:0 0 2px; background:linear-gradient(135deg,#ff2d55,#ffd700); -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text; }
.super-x h1 { font-size:clamp(18px,2.5vw,28px); font-weight:800; line-height:1.2; margin-bottom:4px; background:linear-gradient(135deg,#ff2d55 0%,#ff6b35 40%,#ffd700 70%,#ff2d55 100%); background-size:200% auto; -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text; }
.super-x-btn { display:inline-flex; align-items:center; gap:8px; padding:8px 20px; border-radius:50px; font-size:13px; font-weight:700; text-decoration:none; text-transform:uppercase; letter-spacing:1px; cursor:pointer; border:none; transition:all .3s; margin:2px; background:linear-gradient(135deg,#ff2d55,#ff6b35); color:#fff; box-shadow:0 2px 12px rgba(255,45,85,0.3); }
.super-x-btn:hover { transform:translateY(-1px) scale(1.02); box-shadow:0 4px 20px rgba(255,45,85,0.5); }
.super-x-btn-alt { background:linear-gradient(135deg,#2979ff,#00e676); box-shadow:0 2px 12px rgba(41,121,255,0.2); }
.super-x-btn-alt:hover { box-shadow:0 4px 20px rgba(41,121,255,0.4); }
/* Super X carousel */
.superx-carousel-section { margin-bottom:20px; }
.superx-carousel-header { display:flex; align-items:center; justify-content:space-between; margin-bottom:10px; }
.superx-section-title { font-size:14px; font-weight:700; color:var(--text-primary); margin:0; }
.superx-carousel-controls { display:flex; gap:6px; }
.superx-carousel-btn { width:28px; height:28px; background:var(--bg-tertiary); border:1px solid var(--border); border-radius:50%; color:var(--text-muted); font-size:12px; cursor:pointer; transition:all .2s; }
.superx-carousel-btn:hover { background:var(--accent); border-color:var(--accent); color:#fff; }
.superx-carousel-container { position:relative; overflow:hidden; border-radius:8px; background:var(--bg-card); }
.superx-carousel-track { display:flex; transition:transform 0.5s ease; gap:16px; padding:16px; }
.superx-carousel-card { flex:0 0 calc(33.333% - 11px); min-width:calc(33.333% - 11px); background:var(--bg-tertiary); border-radius:10px; overflow:hidden; cursor:pointer; transition:transform .3s ease; position:relative; }
.superx-carousel-card:hover { transform:scale(1.02); }
.superx-carousel-thumb { position:relative; aspect-ratio:16/9; overflow:hidden; background:var(--bg-card); }
.superx-carousel-thumb img { width:100%; height:100%; object-fit:cover; }
.superx-carousel-thumb video { position:absolute; top:0; left:0; width:100%; height:100%; object-fit:cover; }
.superx-c-views { position:absolute; bottom:8px; left:8px; background:rgba(0,0,0,0.85); padding:3px 8px; border-radius:4px; font-size:11px; color:#fff; }
.superx-c-dur { position:absolute; bottom:8px; right:8px; background:rgba(0,0,0,0.85); padding:3px 8px; border-radius:4px; font-size:12px; color:#fff; }
.superx-c-title { padding:12px; font-size:13px; font-weight:600; line-height:1.3; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; color:var(--text-primary); }
.superx-carousel-dots { display:flex; justify-content:center; gap:8px; margin-top:16px; }
.superx-carousel-dot { width:8px; height:8px; border-radius:50%; background:var(--border); cursor:pointer; transition:all .2s; }
.superx-carousel-dot.active { background:var(--accent); width:24px; border-radius:4px; }
.superx-carousel-dot:hover { background:var(--accent); }
@media (max-width:768px) { .superx-carousel-card { flex:0 0 100%; min-width:100%; } }
@media (min-width:769px) and (max-width:1200px) { .superx-carousel-card { flex:0 0 calc(50% - 8px); min-width:calc(50% - 8px); } }
.stats-card { background:var(--bg-tertiary); border-radius:10px; padding:8px 16px; margin-bottom:10px; display:flex; flex-direction:column; gap:4px; }
.stats-row { display:flex; justify-content:center; align-items:center; gap:8px; font-size:11px; flex-wrap:wrap; }
.stats-label { color:var(--text-muted); }
.stats-value { color:var(--text-primary); font-weight:600; font-variant-numeric:tabular-nums; }
.stats-sep { color:var(--border); }
.sidebar { position:sticky; top:80px; align-self:flex-start; max-height:calc(100vh - 100px); overflow-y:auto; scrollbar-width:thin; }
.sidebar-header { display:flex; align-items:center; justify-content:flex-end; padding:0 0 8px; }
.sidebar-close { display:none; background:none; border:none; color:var(--text-muted); font-size:22px; cursor:pointer; padding:0 4px; line-height:1; transition:color .2s; }
.sidebar-close:hover { color:#fff; }
.sidebar-toggle { display:none; width:32px; height:32px; border-radius:8px; background:#141417; border:1px solid #2a2a30; cursor:pointer; color:#fff; font-size:18px; align-items:center; justify-content:center; flex-shrink:0; transition:all .2s; }
.sidebar-toggle:hover { background:#1c1c21; border-color:var(--accent); }
.sidebar-toggle.gone { display:none !important; }
.sidebar-superx-top { padding:2px 0 8px; margin-bottom:6px; border-bottom:1px solid var(--border); }
.sidebar-superx-link { display:flex; align-items:center; gap:8px; text-decoration:none; font-size:14px; font-weight:800; background:linear-gradient(135deg,#ff2d55,#ffd700); -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text; transition:all .2s; }
.sidebar-superx-link:hover { transform:translateX(3px); }
.sidebar-superx-badge { font-size:8px; font-weight:700; text-transform:uppercase; letter-spacing:0.3px; padding:1px 6px; border-radius:4px; color:#fff; background:#ff2d55; }
.super-x-mobile-tag { display:inline-flex; align-items:center; padding:5px 14px; font-size:12px; font-weight:900; text-transform:uppercase; letter-spacing:-0.3px; text-decoration:none; color:#fff; background:#ff2d55; border-radius:20px; text-shadow:0 0 12px rgba(255,45,85,0.5); box-shadow:0 0 15px rgba(255,45,85,0.4); transition:all .3s; white-space:nowrap; }
.super-x-mobile-tag:hover { transform:scale(1.05); box-shadow:0 0 25px rgba(255,45,85,0.7); }
.sidebar-tier1 { padding:4px 0; display:flex; flex-direction:column; gap:2px; }
.sidebar-tier1-link { display:flex; align-items:center; gap:8px; padding:5px 8px; text-decoration:none; font-size:12px; font-weight:600; color:var(--text-primary); border-radius:6px; transition:all .2s; }
.sidebar-tier1-link:hover { background:var(--bg-tertiary); color:var(--accent); transform:translateX(3px); }
.nav-divider { height:1px; background:var(--border); margin:8px 12px; }
.tier-link { font-size:11px; font-weight:700; padding:4px 8px; margin:0 6px; }
/* Sidebar toggle button */
.sidebar-toggle { display:inline-flex; }
/* Mobile off-canvas sidebar */
@media (max-width:768px) {
  .sidebar { position:fixed; top:0; left:0; width:280px; height:100vh; z-index:200; background:var(--bg-primary); border-right:1px solid var(--border); padding:16px; transform:translateX(-100%); transition:transform 0.3s cubic-bezier(0.33,1,0.68,1); overflow-y:auto; max-height:100vh; }
  .sidebar.show-mobile { transform:translateX(0); }
  .sidebar-close { display:flex; font-size:24px; padding:2px 6px; color:#fff; }
  .sidebar-overlay { position:fixed; inset:0; background:rgba(0,0,0,0.6); z-index:199; opacity:0; pointer-events:none; transition:opacity 0.3s; }
  .sidebar-overlay.show { opacity:1; pointer-events:auto; }
}
/* Desktop close — sidebar becomes visually hidden but stays in DOM */
@media (min-width:769px) {
  .sidebar.closed { display:none; }
  .sidebar-close { display:flex; }
}
.sidebar-title { font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:0.8px; color:var(--text-muted); margin-bottom:6px; }
.sidebar-section { padding:10px 0; border-bottom:1px solid var(--border); }
.sidebar-section:last-child { border-bottom:none; }
.cat-icon { display:none; }
/* Mega X X Melayu toggle */
.mega-toggle-btn { display:flex; align-items:center; gap:8px; width:100%; padding:10px 12px; border:2px solid rgba(255,45,85,0.4); border-radius:10px; background:linear-gradient(135deg,rgba(255,45,85,0.12),rgba(255,107,53,0.08)); color:var(--text-primary); font-size:13px; font-weight:700; cursor:pointer; transition:all 0.3s cubic-bezier(0.33,1,0.68,1); text-align:left; }
.mega-toggle-btn:hover { border-color:#ff2d55; background:linear-gradient(135deg,rgba(255,45,85,0.25),rgba(255,107,53,0.15)); transform:translateX(2px); box-shadow:0 0 20px rgba(255,45,85,0.2); }
.mega-toggle-btn.active { border-color:#ffd700; background:linear-gradient(135deg,rgba(255,45,85,0.3),rgba(255,215,0,0.15)); box-shadow:0 0 30px rgba(255,45,85,0.3),inset 0 0 20px rgba(255,215,0,0.05); }
.mega-toggle-icon { font-size:18px; }
.mega-toggle-text { flex:1; }
.mega-toggle-status { font-size:10px; padding:2px 8px; border-radius:4px; background:rgba(255,255,255,0.08); color:var(--text-muted); transition:all 0.3s; }
.mega-toggle-btn.active .mega-toggle-status { background:#ffd700; color:#000; font-weight:800; }
/* Sidebar footer */
.sidebar-footer { display:flex; gap:8px; justify-content:center; padding:4px 0; font-size:11px; color:var(--text-muted); }
.sidebar-link { color:var(--text-muted); text-decoration:none; transition:color .2s; }
.sidebar-link:hover { color:var(--accent); }
/* Backlink grid */
.backlink-grid { display:flex; flex-wrap:wrap; gap:6px; }
.backlink-link { padding:5px 10px; border-radius:6px; background:rgba(255,255,255,0.04); border:1px solid var(--border); color:var(--text-muted); font-size:11px; font-weight:500; text-decoration:none; transition:all 0.2s; }
.backlink-link:hover { background:rgba(255,45,85,0.1); border-color:var(--accent); color:#fff; }
/* Mega X X mode — zoomed in, vibrant, in-your-face */
body.mega-xx .video-grid { grid-template-columns:repeat(auto-fill,minmax(300px,1fr)); gap:18px; }
body.mega-xx .video-card { border-color:rgba(255,215,0,0.15); box-shadow:0 4px 24px rgba(255,45,85,0.08); }
body.mega-xx .video-card:hover { border-color:#ffd700; box-shadow:0 12px 48px rgba(255,45,85,0.25),0 0 0 2px rgba(255,215,0,0.2); transform:translateY(-6px) scale(1.02); }
body.mega-xx .video-thumb { aspect-ratio:4/3; }
body.mega-xx .video-thumb img { /* no filter — raw thumbnails */ }
body.mega-xx .v-title { font-size:15px; }
body.mega-xx .v-meta { color:#ffd700; font-size:11px; }
@media (max-width:768px) { body.mega-xx .video-grid { grid-template-columns:repeat(2,1fr); gap:12px; } body.mega-xx .video-thumb { aspect-ratio:16/11; } }
/* xx finale card system */
.video-card { display:block; background:var(--bg-card); border:1px solid var(--border); border-radius:12px; overflow:hidden; text-decoration:none; cursor:pointer; transition:transform 0.3s cubic-bezier(0.33,1,0.68,1),border-color 0.3s,box-shadow 0.3s; will-change:transform; }
.video-card:hover { transform:translateY(-4px); border-color:var(--accent); box-shadow:0 12px 40px rgba(255,45,85,0.15),0 0 0 1px rgba(255,45,85,0.3); }
.video-thumb { position:relative; aspect-ratio:16/11; overflow:hidden; background:var(--bg-tertiary); }
.video-thumb img { position:absolute; top:0; left:0; width:100%; height:100%; object-fit:cover; z-index:1; transition:transform 0.5s cubic-bezier(0.33,1,0.68,1); filter:brightness(1.06) contrast(1.08) saturate(1.12); }
.video-card:hover .video-thumb img { transform:scale(1.05); }
.video-thumb video { position:absolute; top:0; left:0; width:100%; height:100%; object-fit:cover; pointer-events:none; z-index:2; }
.v-title { font-size:13px; font-weight:600; color:var(--text-primary); margin:8px 12px 4px; line-height:1.35; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
.v-meta { font-size:10px; color:var(--text-muted); margin:0 12px 10px; display:block; }
/* xx finale badges — modern pill + glass */
.badge { position:absolute; top:8px; left:8px; padding:3px 10px; border-radius:999px; font-size:9px; font-weight:700; color:#fff; z-index:10; letter-spacing:0.15px; line-height:1.5; display:inline-flex; align-items:center; gap:3px; white-space:nowrap; backdrop-filter:blur(8px); -webkit-backdrop-filter:blur(8px); border:1px solid rgba(255,255,255,0.08); box-shadow:0 2px 6px rgba(0,0,0,0.2); }
.badge-tudung { background:rgba(255,45,85,0.82); }
.badge-viral { background:rgba(255,68,68,0.82); }
.badge-scandal { background:rgba(255,102,0,0.82); }
