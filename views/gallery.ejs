    async function openFullscreen(videoSrc) {
      if (!videoSrc) return;
      _fsCooldown = true;
      setTimeout(() => { _fsCooldown = false; }, 2000);

      // Fetch ad config BEFORE the transition (async work)
      let showAd = false, vastTag = '', rollType = 'preRoll';
      try {
        const resp = await fetch('/api/video-ad-config');
        const cfg = await resp.json();
        showAd = cfg.showAd;
        vastTag = cfg.vastTag;
        rollType = cfg.rollType;
      } catch(e) {}

      // Find the visible thumbnail for view transition
      let thumbImg = null;
      const cards = document.querySelectorAll('.video-card');
      for (const card of cards) {
        const rect = card.getBoundingClientRect();
        if (rect.top < window.innerHeight && rect.bottom > 0) {
          thumbImg = card.querySelector('.video-thumb img');
          if (thumbImg) break;
        }
      }

      // Mark the thumbnail for the old-state capture
      if (thumbImg) thumbImg.style.viewTransitionName = 'active-video';

      // Build Fluid Player options
      const opts = {
        layoutControls: {
          primaryColor: '#ff2d55',
          fillToContainer: true,
          posterImage: ''
        }
      };
      if (showAd && vastTag) {
        opts.vastOptions = {
          adList: [{ roll: rollType, vastTag }]
        };
      }

      // Destroy previous Fluid Player instance
      if (fluidInstance) {
        try { fluidInstance.destroy(); } catch(e) {}
        fluidInstance = null;
      }

      // DOM change: show overlay, set video src, mark new-state element
      const apply = () => {
        fsVideo.src = videoSrc;
        fsVideo.style.viewTransitionName = 'active-video';
        fsPlayer.classList.add('active');
        document.body.style.overflow = 'hidden';
      };

      // Run view transition (or fallback)
      if (document.startViewTransition) {
        try {
          await document.startViewTransition(apply).finished;
        } catch(e) {
          apply();
        }
      } else {
        apply();
      }

      // Clean up view-transition-name
      if (thumbImg) thumbImg.style.viewTransitionName = '';
      fsVideo.style.viewTransitionName = '';

      // Initialize Fluid Player
      if (typeof fluidPlayer === 'function') {
        try {
          fluidInstance = fluidPlayer('fullscreenVideo', opts);
          return;
        } catch(e) {}
      }
      // Fallback: play directly
      fsVideo.play().catch(() => {});
    }

    function exitFullscreen() {
      _fsCooldown = true;
      setTimeout(() => { _fsCooldown = false; }, 2000);
      if (fluidInstance) {
        try { fluidInstance.destroy(); } catch(e) {}
        fluidInstance = null;
      }

      // Reverse view transition: mark fullscreen video as old state
      fsVideo.style.viewTransitionName = 'active-video';

      const apply = () => {
        fsVideo.pause();
        fsVideo.src = '';
        fsVideo.style.viewTransitionName = '';
        fsPlayer.classList.remove('active');
        document.body.style.overflow = '';
      };

      if (document.startViewTransition) {
        document.startViewTransition(apply);
      } else {
        apply();
      }
    }

