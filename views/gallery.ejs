      const toast = document.getElementById('toast');
      toast.textContent = msg;
      toast.classList.add('show');
      setTimeout(() => toast.classList.remove('show'), 2500);
    }

    // Scroll progress update on load
    function updateScrollOnLoad() {
      requestAnimationFrame(() => {
        updateScrollProgress();
      });
    }

    // Search with suggestions
    let searchTimeout;
    let searchSuggestionsEl = document.getElementById('searchSuggestions');
    
    const popularSearches = [
      { text: 'Trending Videos', icon: '🔥', count: null },
      { text: 'New Releases', icon: '✨', count: null },
      { text: 'Most Popular', icon: '👑', count: null },
      { text: 'HD Quality', icon: '🎬', count: null },
    ];

    searchInput.addEventListener('input', (e) => {
      clearTimeout(searchTimeout);
      const query = e.target.value.trim();
      
      if (query.length > 0) {
        searchTimeout = setTimeout(() => {
          showSearchSuggestions(query);
        }, 200);
      } else {
        searchSuggestionsEl.classList.remove('active');
      }
      
      searchTimeout = setTimeout(() => {
        state.query = query;
        loadVideos();
        scrollToTop();
      }, 500);
    });

    function showSearchSuggestions(query) {
      const matches = popularSearches.filter(s => 
        s.text.toLowerCase().includes(query.toLowerCase())
      );
      
      if (matches.length > 0) {
        searchSuggestionsEl.innerHTML = matches.map(m => `
          <div class="suggestion-item" onclick="selectSuggestion('${m.text}')">
            <span class="suggestion-icon">${m.icon}</span>
            <span class="suggestion-text">${m.text}</span>
          </div>
        `).join('');
        searchSuggestionsEl.classList.add('active');
      } else {
        searchSuggestionsEl.classList.remove('active');
      }
    }

    function selectSuggestion(text) {
      searchInput.value = text;
      state.query = text;
      searchSuggestionsEl.classList.remove('active');
      loadVideos();
      scrollToTop();
    }
    
    document.getElementById('searchBtn').addEventListener('click', () => {
      state.query = searchInput.value.trim();
      searchSuggestionsEl.classList.remove('active');
      loadVideos(true);
      searchInput.blur();
    });
    
    searchInput.addEventListener('keypress', (e) => {
      if (e.key === 'Enter') {
        state.query = searchInput.value.trim();
        searchSuggestionsEl.classList.remove('active');
        loadVideos();
        scrollToTop();
        searchInput.blur();
      }
    });

    searchInput.addEventListener('focus', () => {
      if (searchInput.value.trim().length === 0) {
        searchSuggestionsEl.innerHTML = popularSearches.map(m => `
          <div class="suggestion-item" onclick="selectSuggestion('${m.text}')">
            <span class="suggestion-icon">${m.icon}</span>
            <span class="suggestion-text">${m.text}</span>
          </div>
        `).join('');
        searchSuggestionsEl.classList.add('active');
      }
    });

    document.addEventListener('click', (e) => {
      if (!e.target.closest('.search-wrapper')) {
        searchSuggestionsEl.classList.remove('active');
      }
    });

    // Type filters (Amateur, Professional, Reality, Cosplay)
    document.querySelectorAll('.type-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.type-btn').forEach(b => b.classList.remove('active'));
        if (state.action === btn.dataset.action) {
          state.action = '';
        } else {
          btn.classList.add('active');
          state.action = btn.dataset.action;
        }
        loadVideos();
        scrollToTop();
      });
    });

    // Scene filters (Solo, Couple, Group, POV)
    document.querySelectorAll('.scene-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.scene-btn').forEach(b => b.classList.remove('active'));
        if (state.action === btn.dataset.action) {
          state.action = '';
        } else {
          btn.classList.add('active');
          state.action = btn.dataset.action;
        }
        loadVideos();
        scrollToTop();
      });
    });

    // Rating filters (Teen, MILF)
    document.querySelectorAll('.rating-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.rating-btn').forEach(b => b.classList.remove('active'));
        if (state.action === btn.dataset.action) {
          state.action = '';
        } else {
          btn.classList.add('active');
          state.action = btn.dataset.action;
        }
        loadVideos();
        scrollToTop();
      });
    });

    // Fetish tags
    document.querySelectorAll('.fetish-tag').forEach(tag => {
      tag.addEventListener('click', () => {
        if (tag.classList.contains('active')) {
          tag.classList.remove('active');
          state.fetish = '';
        } else {
          document.querySelectorAll('.fetish-tag').forEach(t => t.classList.remove('active'));
          tag.classList.add('active');
          state.fetish = tag.dataset.fetish;
        }
        loadVideos();
        scrollToTop();
      });
    });

    // Quality filters (4K, HD, SD)
    document.querySelectorAll('.quality-option input[type="radio"]').forEach(input => {
      input.addEventListener('change', () => {
        document.querySelectorAll('.quality-option').forEach(opt => opt.classList.remove('active'));
        if (input.checked) {
          input.closest('.quality-option').classList.add('active');
          state.quality = input.value;
        } else {
          state.quality = '';
        }
        loadVideos();
        scrollToTop();
      });
    });

    // Duration filters (Short, Medium, Long)
    document.querySelectorAll('.duration-option input[type="radio"]').forEach(input => {
      input.addEventListener('change', () => {
        document.querySelectorAll('.duration-option').forEach(opt => opt.classList.remove('active'));
        if (input.checked) {
          input.closest('.duration-option').classList.add('active');
          state.duration = input.value;
        } else {
          state.duration = '';
        }
        loadVideos();
        scrollToTop();
      });
    });

    // Mobile filter panel
    document.getElementById('mobileCategoryNav')?.addEventListener('click', (e) => {
      const item = e.target.closest('.mobile-cat-btn');
      if (item) {
        document.querySelectorAll('.mobile-cat-btn').forEach(b => b.classList.remove('active'));
        item.classList.add('active');
        state.category = item.dataset.category === 'all' ? '' : item.dataset.category;
        if (state.category) {
          document.title = 'xMelayu - ' + state.category + ' Malaysian Amateur Videos';
          var h1 = document.querySelector('.hero-section h1');
          if (h1) h1.innerHTML = 'xMelayu &mdash; ' + state.category + ' Malaysian Amateur Videos';
        } else {
          document.title = 'xMelayu - Malaysian Amateur Video Collection';
          var h1 = document.querySelector('.hero-section h1');
          if (h1) h1.innerHTML = 'xMelayu &mdash; Malaysian Amateur Videos';
        }
        loadVideos();
        closeMobileFilter();
        scrollToTop();
      }
    });

    document.querySelector('.mobile-sort')?.addEventListener('click', (e) => {
      const btn = e.target.closest('.mobile-sort-btn');
      if (btn) {
        document.querySelectorAll('.mobile-sort-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        state.sort = btn.dataset.sort;
        loadVideos();
        closeMobileFilter();
        scrollToTop();
      }
    });

    // Reset
    document.getElementById('resetFilters')?.addEventListener('click', () => {
      state.query = '';
      state.category = '';
      state.tag = '';
      state.sort = 'newest';
      state.action = '';
      state.fetish = '';
      state.quality = '';
      state.duration = '';
      state.region = '';
      state.hasMore = true;
      searchInput.value = '';

      document.querySelectorAll('.type-btn, .scene-btn, .rating-btn, .fetish-tag').forEach(el => el.classList.remove('active'));
      document.querySelectorAll('.quality-option, .duration-option').forEach(el => el.classList.remove('active'));
      document.querySelectorAll('input[type="radio"]').forEach(el => el.checked = false);

      loadVideos();
      scrollToTop();
    });
    
    searchInput.addEventListener('keypress', (e) => {
      if (e.key === 'Enter') {
        state.query = searchInput.value.trim();
        loadVideos(true);
        searchInput.blur();
      }
    });

    // Category filter
    document.getElementById('categoryNav')?.addEventListener('click', (e) => {
      const item = e.target.closest('.category-item');
      if (item) {
        state.category = item.dataset.category === 'all' ? '' : item.dataset.category;
        if (state.category) {
          document.title = 'xMelayu - ' + state.category + ' Malaysian Amateur Videos';
          var h1 = document.querySelector('.hero-section h1');
          if (h1) h1.innerHTML = 'xMelayu &mdash; ' + state.category + ' Malaysian Amateur Videos';
        } else {
          document.title = 'xMelayu - Malaysian Amateur Video Collection';
          var h1 = document.querySelector('.hero-section h1');
          if (h1) h1.innerHTML = 'xMelayu &mdash; Malaysian Amateur Videos';
        }
        loadVideos(true);
      }
    });

    // Tag filter
    document.getElementById('tagsCloud')?.addEventListener('click', (e) => {
      const tag = e.target.closest('.tag-chip');
      if (tag) {
        state.tag = state.tag === tag.dataset.tag ? '' : tag.dataset.tag;
        loadVideos(true);
      }
    });

    // Sort
    document.querySelector('.quick-filters')?.addEventListener('click', (e) => {
      const btn = e.target.closest('.filter-btn');
      if (btn) {
        state.sort = btn.dataset.sort;
        loadVideos(true);
      }
    });

    // Refresh
    document.getElementById('refreshBtn')?.addEventListener('click', async () => {
      await fetch('/api/refresh');
      showToast('Cache refreshed');
      loadVideos(true);
    });

    window.scrollToTop = scrollToTop;
    window.scrollToBottom = scrollToBottom;

    // Populate batchVideos from server-rendered DOM cards (before API call replaces feed)
    initBatchVideosFromDOM();

    // Initial load
    loadVideos();

    // Scroll depth tracking
    let scrollMarkers = { 25: false, 50: false, 75: false, 100: false };
    window.addEventListener('scroll', () => {
      const scrollPercent = Math.round((window.scrollY / (document.body.scrollHeight - window.innerHeight)) * 100);
      [25, 50, 75, 100].forEach(marker => {
        if (!scrollMarkers[marker] && scrollPercent >= marker) {
          scrollMarkers[marker] = true;
          if (typeof gtag !== 'undefined') {
            gtag('event', 'scroll_depth', { percent_scrolled: marker, page: 'gallery' });
          }
        }
      });
    });

    // Mobile touch preview — uses shared gridPreviews LRU
    if ('ontouchstart' in window || navigator.maxTouchPoints > 0) {
      document.addEventListener('touchstart', function(e) {
        const thumb = e.target.closest('.video-thumb, .thumb');
        if (!thumb) return;
        const card = thumb.closest('.video-card');
        if (!card) return;
        const vid = card.dataset.id;
        if (!vid || gridPreviews.has(vid)) return;
        const video = thumb.querySelector('video');
        const url = card.dataset.preview;
        if (!video || !url) return;
        video.src = url + '#t=0.15,5';
        video.preload = 'auto';
        video.play().catch(function(){});
        gridPreviews.set(vid, { video, el: thumb });
        if (gridPreviews.size > previewLimits) {
          const oldest = gridPreviews.entries().next().value;
          if (oldest) {
            oldest[1].video.pause();
            oldest[1].video.removeAttribute('src');
            oldest[1].video.load();
            gridPreviews.delete(oldest[0]);
          }
        }
      }, { passive: true });
    }
    window.toggleLike = function(videoId, btnEl) {
      if (btnEl._liking) return;
      btnEl._liking = true;
      fetch('/api/likes/' + videoId, { method: 'POST' })
        .then(function(r) { return r.json(); })
        .then(function(data) {
          btnEl.querySelector('.like-count').textContent = data.likes;
          btnEl.classList.toggle('liked', data.liked);
        })
        .catch(function() {})
        .finally(function() { btnEl._liking = false; });
    };
    document.addEventListener('DOMContentLoaded', function() {
      document.querySelectorAll('.like-btn').forEach(function(btn) {
        var id = btn.dataset.id;
        if (id) fetch('/api/likes/' + id).then(function(r) { return r.json(); }).then(function(d) {
          btn.querySelector('.like-count').textContent = d.likes;
        }).catch(function() {});
      });
      // Sidebar toggle init — show on mobile or when sidebar is closed on desktop
      var sb = document.getElementById('sidebar');
      var tg = document.getElementById('sidebarToggle');
      if (sb && tg && (window.innerWidth <= 768 || sb.classList.contains('closed'))) {
        tg.classList.remove('gone');
      }
    });
  </script>

