.badge-trending { background:rgba(255,107,53,0.82); }

/* ════════════════════════════════════════════════════════════
   SEO KEYWORD BADGE SHAPES (CMS-managed, 7 styles)
   ════════════════════════════════════════════════════════════ */

/* Skeleton loading */
.skeleton-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(240px,1fr)); gap:14px; padding:16px 0; }
.skeleton-card { background:linear-gradient(90deg,var(--bg-tertiary) 25%,var(--bg-card) 50%,var(--bg-tertiary) 75%); background-size:200% 100%; animation:shimmer 1.5s infinite; aspect-ratio:16/11; border-radius:12px; padding-bottom:52px; box-sizing:content-box; }
@keyframes shimmer { 0%{background-position:200% 0} 100%{background-position:-200% 0} }
/* grid layouts */
.video-grid { display:grid; gap:14px; grid-template-columns:repeat(auto-fill,minmax(240px,1fr)); }
.video-section { margin-bottom:28px; }
/* Carousel cards */
.carousel-card { flex:0 0 260px; scroll-snap-align:start; border-radius:12px; overflow:hidden; }
.carousel-card .video-card { border:none; border-radius:0; }
.carousel-card .video-card:hover { transform:none; box-shadow:none; }
.carousel-section { margin-bottom:28px; }
.carousel-header { display:flex; align-items:center; justify-content:space-between; padding:0 0 12px; }
.carousel-header .section-title { font-size:16px; font-weight:700; margin:0; }
.carousel-header .section-subtitle { font-size:12px; color:var(--text-muted); }
.carousel-container { overflow:hidden; position:relative; }
.carousel-track { display:flex; gap:12px; overflow-x:auto; scroll-snap-type:x mandatory; -webkit-overflow-scrolling:touch; padding-bottom:8px; scrollbar-width:thin; scrollbar-color:var(--accent) var(--bg-tertiary); }
