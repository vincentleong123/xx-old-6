                  onerror="this.src='data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAzMjAgMTgwIj48cmVjdCBmaWxsPSIjMWExYTFlIiB3aWR0aD0iMzIwIiBoZWlnaHQ9IjE4MCIvPjwvc3ZnPg=='">
                <video muted loop preload="none" playsinline></video>
                ${getBadgeHtml(v)}
                ${getKeywordRibbon(v)}
              </div>
              <div class="v-title">${v.title}</div>
