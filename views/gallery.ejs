<% } else { %>
  <%- include('_about') %>
<% } %>

  <%- include('footer-component') %>

  <div class="toast" id="toast"></div>


  <script>
    const state = {
      query: '', category: '<%= typeof filterCategory !== 'undefined' ? filterCategory : '' %>', tag: '', sort: 'newest',
      action: '', fetish: '', quality: '', duration: '', region: '',
      totalVideos: 0, isLoading: false, hasMore: true,
      batchVideos: [], batchIndex: 0, batchSize: 50, usedIds: new Set(),
      simplifiedSidebar: <%= simplifiedSidebar ? 'true' : 'false' %>,
      superxCarouselIdx: 0, superxCarouselPlaying: true, superxCarouselInterval: null, connectionSpeed: 'fast'
    };

    function detectConnectionSpeed() {
      if ('connection' in navigator) {
        var conn = navigator.connection || navigator.mozConnection || navigator.webkitConnection;
        if (conn) {
          if (conn.effectiveType === 'slow-2g' || conn.effectiveType === '2g') state.connectionSpeed = 'slow';
          else if (conn.effectiveType === '3g') state.connectionSpeed = 'medium';
          else state.connectionSpeed = 'fast';
        }
      }
      return state.connectionSpeed;
    }
    detectConnectionSpeed();

    const shuffle = a => { const b = [...a]; for (let i = b.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [b[i], b[j]] = [b[j], b[i]]; } return b; };

    function kwText(v) {
      const k = v.keywords;
      return Array.isArray(k) ? k.join(' ') : (k || '');
    }

    // Legacy pill badge system (enhanced with amateur/asian patterns)
    const BADGE_MAP = [
      { k: /tudung|hijab/i, cls: 'badge-tudung', icon: '🧕', text: 'Tudung' },
      { k: /viral|scandal|bocor/i, cls: 'badge-viral', icon: '📈', text: 'Viral' },
      { k: /janda|dara/i, cls: 'badge-janda', icon: '💋', text: 'Janda' },
      { k: /montok|thick|curvy/i, cls: 'badge-montok', icon: '🔥', text: 'Montok' },
      { k: /bini.?geram|isteri/i, cls: 'badge-bini', icon: '💢', text: 'Bini Geram' },
      { k: /chubby|gemuk|bbw/i, cls: 'badge-chubby', icon: '🍑', text: 'Chubby' },
      { k: /indonesia|indon|jakarta/i, cls: 'badge-indo', icon: '🇮🇩', text: 'Indo' },
      { k: /thai|bangkok/i, cls: 'badge-thai', icon: '🇹🇭', text: 'Thai' },
      { k: /kolej|uitm|pelajar/i, cls: 'badge-kolej', icon: '🎓', text: 'Kolej' },
      { k: /private|closet|hidden|personal/i, cls: 'badge-private', icon: '🤫', text: 'Private' },
      { k: /old|archive/i, cls: 'badge-archive', icon: '📼', text: 'Archive' },
      { k: /new|2025|2026|terbaru/i, cls: 'badge-fresh', icon: '🆕', text: 'Fresh' },
      { k: /x.?mateur|x.?amateur|xmateur|xamateur/i, cls: 'badge-hot', icon: '🔥', text: 'xMateur' },
      { k: /amateur|homemade|real/i, cls: 'badge-trending', icon: '⭐', text: 'Amateur' },
      { k: /asian|sea|southeast/i, cls: 'badge-fresh', icon: '🌏', text: 'Asian' },
    ];
    function getBadgeHtml(video) {
      if (!video) return '';
      const combined = ((video.title || '') + ' ' + kwText(video)).toLowerCase();
      for (const b of BADGE_MAP) {
        if (b.k.test(combined)) {
          return `<span class="badge ${b.cls}">${b.icon} ${b.text}</span>`;
        }
      }
      if (video.views > 50000) return '<span class="badge badge-trending">📈 Trending</span>';
      if (video.views > 10000) return '<span class="badge badge-hot">🔥 Hot</span>';
      return '';
    }

    // FLOATING PLAYER - Watch without leaving gallery + SEO descriptions
    let floatingPlayer = null;

    function h(s) { return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;'); }

    function initBatchVideosFromDOM() {
      document.querySelectorAll('.video-card[data-id]').forEach(function(el) {
        var id = el.dataset.id;
        if (id && !state.batchVideos.some(function(v) { return v.id === id; })) {
          state.batchVideos.push({
            id: id,
            video: el.dataset.preview || '',
            title: (el.querySelector('.v-title')?.textContent || '').trim(),
            keywords: [],
            category: (el.querySelector('.v-meta')?.textContent || '').trim()
          });
        }
      });
    }

    function buildFloatingPlayerHtml(videoData, index, total) {
      var safeTitle = h(videoData.title);
      var cat = h(videoData.category || 'melayu');
      var views = videoData.views ? videoData.views.toLocaleString() : '—';
      var relatedHtml = buildRelatedStrip(videoData, index, total);
      var likeState = window.likedVideos && window.likedVideos[videoData.id] ? ' liked' : '';
      return '<div class="floating-player" id="floatingPlayer" data-current-id="' + videoData.id + '">' +
        '<div class="floating-player-content">' +
          '<button class="fp-close" onclick="closeFloatingPlayer()">✕</button>' +
          '<div class="fp-video">' +
            '<video id="fpVideoPlayer" controls playsinline title="' + safeTitle + ' - xMelayu.Site">' +
              '<source src="' + (videoData._rawVideoUrl || videoData.video) + '" type="video/mp4">' +
            '</video>' +
            (index > 0 ? '<button class="fp-nav fp-nav-prev" onclick="navigateFloatingPlayer(-1)">◀</button>' : '') +
            (index < total - 1 ? '<button class="fp-nav fp-nav-next" onclick="navigateFloatingPlayer(1)">▶</button>' : '') +
          '</div>' +
          '<div class="fp-info">' +
            '<div class="fp-title" title="' + safeTitle + '">' + safeTitle + '</div>' +
            '<div class="fp-meta">' +
              '<span class="fp-meta-row"><span class="fp-counter" id="fpCounter">' + (index + 1) + ' / ' + total + '</span></span>' +
              '<span class="fp-meta-row"><span class="fp-views">' + views + ' views</span></span>' +
              '<button class="fp-like-btn' + likeState + '" data-id="' + videoData.id + '" onclick="event.stopPropagation();fpToggleLike(this,\'' + videoData.id + '\')">♡ <span class="fp-like-count">' + (videoData.likes || 0) + '</span></button>' +
            '</div>' +
            '<div class="fp-keywords">' +
              (videoData.keywords || []).slice(0, 8).map(function(k) { return '<span class="fp-kw">#' + h(k) + '</span>'; }).join('') +
            '</div>' +
            '<div class="fp-desc" id="fpDesc"></div>' +
            '<div class="fp-links">' +
              '<a href="/' + videoData.id + '" class="fp-link-btn fp-link-full" title="Open full ' + safeTitle + ' on xMelayu.Site">Open Full Page →</a>' +
              '<a href="/?q=' + encodeURIComponent(cat) + '" class="fp-link-btn" style="background:var(--bg3)" title="More ' + cat + ' videos">🎬 ' + cat + '</a>' +
            '</div>' +
            relatedHtml +
            '<button class="fp-back" onclick="closeFloatingPlayer()">← Back to Gallery</button>' +
          '</div>' +
        '</div>' +
      '</div>';
    }

    function buildRelatedStrip(current, index, total) {
      var others = state.batchVideos.filter(function(v, i) { return i !== index && v.id !== current.id; }).slice(0, 10);
      if (others.length === 0) return '';
      var cards = others.map(function(v) {
        var t = h(v.title || '');
        var thumb = v.thumbnail || '/thumbnails/' + v.id + '.jpg';
        return '<a href="/' + v.id + '" class="fp-related-card" onclick="event.preventDefault();navigateFloatingPlayerTo(\'' + v.id + '\')">' +
          '<img src="' + thumb + '" alt="' + t + '" loading="lazy" onerror="this.src=\'data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAzMjAgMTgwIj48cmVjdCBmaWxsPSIjMWExYTFlIiB3aWR0aD0iMzIwIiBoZWlnaHQ9IjE4MCIvPjwvc3ZnPg==\'">' +
          '<div class="r-title">' + t + '</div></a>';
      }).join('');
      return '<div class="fp-related"><div class="fp-related-title">More Videos</div><div class="fp-related-track">' + cards + '</div></div>';
    }

    function fetchFloatingPlayerDesc(videoId) {
      fetch('/api/video-descriptions/' + videoId)
        .then(function(r) { return r.json(); })
        .then(function(data) {
          var de = document.getElementById('fpDesc');
          if (!de) return;
          de.innerHTML = '';
          if (data.text) {
            var p = document.createElement('div');
            p.className = 'fp-desc-text';
            p.innerHTML = data.text.substring(0, 400);
            de.appendChild(p);
          }
          // description panel
        })
        .catch(function() {});
    }

    function updateFloatingPlayerNav(index, total) {
      var fp = document.getElementById('floatingPlayer');
      if (!fp) return;
      var videoWrap = fp.querySelector('.fp-video');
      if (!videoWrap) return;
      var existing = videoWrap.querySelectorAll('.fp-nav');
      existing.forEach(function(el) { el.remove(); });
      if (index > 0) {
        var prev = document.createElement('button');
        prev.className = 'fp-nav fp-nav-prev';
        prev.textContent = '◀';
        prev.onclick = function() { navigateFloatingPlayer(-1); };
        videoWrap.appendChild(prev);
      }
      if (index < total - 1) {
        var next = document.createElement('button');
        next.className = 'fp-nav fp-nav-next';
        next.textContent = '▶';
        next.onclick = function() { navigateFloatingPlayer(1); };
        videoWrap.appendChild(next);
      }
    }

    function navigateFloatingPlayer(dir) {
      var fp = document.getElementById('floatingPlayer');
      if (!fp) return;
      var curId = fp.dataset.currentId;
      if (!curId) return;
      var idx = state.batchVideos.findIndex(function(v) { return v.id === curId; });
      if (idx === -1) return;
      var newIdx = idx + dir;
      if (newIdx < 0 || newIdx >= state.batchVideos.length) return;
      var next = state.batchVideos[newIdx];
      if (!next || (!next._rawVideoUrl && !next.video)) return;

      var fpv = document.getElementById('fpVideoPlayer');
      if (fpv) {
        var source = fpv.querySelector('source');
        if (source) source.src = next._rawVideoUrl || next.video;
        fpv.load();
        fpv.play();
      }

      var info = document.querySelector('.fp-info');
      if (info) {
        var safeTitle = h(next.title);
        var cat = h(next.category || 'melayu');
        var views = next.views ? next.views.toLocaleString() : '—';
        var likeState = window.likedVideos && window.likedVideos[next.id] ? ' liked' : '';
        var relatedHtml = buildRelatedStrip(next, newIdx, state.batchVideos.length);
        info.innerHTML =
          '<div class="fp-title" title="' + safeTitle + '">' + safeTitle + '</div>' +
          '<div class="fp-meta">' +
            '<span class="fp-meta-row"><span class="fp-counter" id="fpCounter">' + (newIdx + 1) + ' / ' + state.batchVideos.length + '</span></span>' +
            '<span class="fp-meta-row"><span class="fp-views">' + views + ' views</span></span>' +
            '<button class="fp-like-btn' + likeState + '" data-id="' + next.id + '" onclick="event.stopPropagation();fpToggleLike(this,\'' + next.id + '\')">♡ <span class="fp-like-count">' + (next.likes || 0) + '</span></button>' +
          '</div>' +
          '<div class="fp-keywords">' +
            (next.keywords || []).slice(0, 8).map(function(k) { return '<span class="fp-kw">#' + h(k) + '</span>'; }).join('') +
          '</div>' +
          '<div class="fp-desc" id="fpDesc"></div>' +
          '<div class="fp-links">' +
            '<a href="/' + next.id + '" class="fp-link-btn fp-link-full" title="Open full ' + safeTitle + '">Open Full Page →</a>' +
            '<a href="/?q=' + encodeURIComponent(cat) + '" class="fp-link-btn" style="background:var(--bg3)" title="More ' + cat + ' videos">🎬 ' + cat + '</a>' +
          '</div>' +
          relatedHtml +
          '<button class="fp-back" onclick="closeFloatingPlayer()">← Back to Gallery</button>';
      }

      updateFloatingPlayerNav(newIdx, state.batchVideos.length);
      fp.dataset.currentId = next.id;

      fetchFloatingPlayerDesc(next.id);
      gtag('event', 'video_play', { video_id: next.id, video_title: next.title, video_category: next.category });
    }

    function navigateFloatingPlayerTo(id) {
      var fp = document.getElementById('floatingPlayer');
      if (!fp) return;
      var idx = state.batchVideos.findIndex(function(v) { return v.id === id; });
      if (idx === -1) return;
      var curId = fp.dataset.currentId;
      var curIdx = state.batchVideos.findIndex(function(v) { return v.id === curId; });
      if (curIdx === -1) return;
      var dir = idx > curIdx ? 1 : -1;
      while (fp.dataset.currentId !== id) navigateFloatingPlayer(dir);
    }

    function openFloatingPlayer(videoId, cardEl) {
      if (floatingPlayer) closeFloatingPlayer();

      var videoData = state.batchVideos.find(function(v) { return v.id === videoId; });
      if ((!videoData || (!videoData._rawVideoUrl && !videoData.video)) && cardEl) {
        videoData = {
          id: videoId,
          video: cardEl.dataset.preview || '',
          title: (cardEl.querySelector('.v-title')?.textContent || videoId).trim(),
          keywords: [],
          category: (cardEl.querySelector('.v-meta')?.textContent || 'melayu').trim()
        };
      }
      if (!videoData || (!videoData._rawVideoUrl && !videoData.video)) return window.location.href = '/' + videoId;

      var index = state.batchVideos.findIndex(function(v) { return v.id === videoId; });
      if (index === -1) {
        state.batchVideos.push(videoData);
        index = state.batchVideos.length - 1;
      }
      var total = state.batchVideos.length;

      document.body.insertAdjacentHTML('beforeend', buildFloatingPlayerHtml(videoData, index, total));
      floatingPlayer = document.getElementById('floatingPlayer');
      document.body.style.overflow = 'hidden';
      var fpv = document.getElementById('fpVideoPlayer');
      if (fpv) fpv.play();

      gtag('event', 'page_view', { page_title: videoData.title, page_location: '/' + videoId });
      gtag('event', 'video_play', { video_id: videoId, video_title: videoData.title, video_category: videoData.category });

      fetchFloatingPlayerDesc(videoId);

      // Enrich batch video data from API for all videos in batch
      if (state.batchVideos.length > 0) {
        fetch('/api/search?limit=' + state.batchVideos.length + '&page=1')
          .then(function(r) { return r.json(); })
          .then(function(data) {
            if (data && data.videos) {
              data.videos.forEach(function(apiV) {
                var match = state.batchVideos.find(function(bv) { return bv.id === apiV.id; });
                if (match && !match.views) {
                  match.video = apiV._rawVideoUrl || apiV.video || match.video;
                  match.keywords = apiV.keywords || [];
                  match.views = apiV.views;
                  match.likes = apiV.likes;
                  match.thumbnail = apiV.thumbnail;
                  // Update current view if this is the active video
                  if (apiV.id === videoId) {
                    var viewsEl = document.querySelector('.fp-views');
                    if (viewsEl) viewsEl.textContent = (apiV.views || 0).toLocaleString() + ' views';
                    var countEl = document.querySelector('.fp-like-count');
                    if (countEl) countEl.textContent = apiV.likes || 0;
                  }
                }
              });
            }
          })
          .catch(function() {});
      }

      floatingPlayer.addEventListener('click', function(e) {
        if (e.target === floatingPlayer) closeFloatingPlayer();
      });

      // Keyboard shortcuts for floating player
      var fpKeyHandler = function(e) {
        if (e.key === 'Escape') { closeFloatingPlayer(); return; }
        if (e.key === 'ArrowLeft') { var prevBtn = floatingPlayer.querySelector('.fp-nav-prev'); if (prevBtn) prevBtn.click(); return; }
        if (e.key === 'ArrowRight') { var nextBtn = floatingPlayer.querySelector('.fp-nav-next'); if (nextBtn) nextBtn.click(); return; }
        if (e.key === ' ' || e.key === 'Space') {
          e.preventDefault();
          var v = document.getElementById('fpVideoPlayer');
          if (v) { if (v.paused) v.play(); else v.pause(); }
        }
      };
      document.addEventListener('keydown', fpKeyHandler);
      floatingPlayer._fpKeyHandler = fpKeyHandler;

      // Track time watched
      var fpPlayStart = Date.now();
      var fpvEl = document.getElementById('fpVideoPlayer');
      if (fpvEl) {
        fpvEl.addEventListener('pause', function onPause() {
          var elapsed = Math.round((Date.now() - fpPlayStart) / 1000);
          if (elapsed > 5) gtag('event', 'video_watch', { video_id: videoId, seconds: elapsed });
          fpvEl.removeEventListener('pause', onPause);
        });
      }

      // Swipe gestures
      setupFpSwipe(floatingPlayer);

      fetch('/' + videoId, { mode: 'no-cors' }).catch(function(){});
    }

    function fpToggleLike(btn, id) {
      btn.classList.toggle('liked');
      var countEl = btn.querySelector('.fp-like-count');
      var count = parseInt(countEl.textContent) || 0;
      countEl.textContent = btn.classList.contains('liked') ? count + 1 : Math.max(0, count - 1);
      if (window.toggleLike) toggleLike(id, btn);
      gtag('event', 'video_like', { video_id: id });
    }

    function closeFloatingPlayer() {
      if (floatingPlayer) {
        const v = document.getElementById('fpVideoPlayer');
        if (v) { v.pause(); v.removeAttribute('src'); v.load(); }
        var lastId = floatingPlayer.dataset.currentId;
        // Remove keyboard handler
        if (floatingPlayer._fpKeyHandler) {
          document.removeEventListener('keydown', floatingPlayer._fpKeyHandler);
        }
        floatingPlayer.remove();
        floatingPlayer = null;
        document.body.style.overflow = '';
        if (lastId) gtag('event', 'video_close', { video_id: lastId });
      }
    }

    var fpSwipeState = { startX: 0, startY: 0, startTime: 0 };
    function setupFpSwipe(container) {
      if (!container) return;
      container.addEventListener('touchstart', function(e) {
        var t = e.changedTouches[0];
        fpSwipeState.startX = t.clientX;
        fpSwipeState.startY = t.clientY;
        fpSwipeState.startTime = Date.now();
      }, { passive: true });
      container.addEventListener('touchend', function(e) {
        var t = e.changedTouches[0];
        var dx = t.clientX - fpSwipeState.startX;
        var dy = t.clientY - fpSwipeState.startY;
        var dt = Date.now() - fpSwipeState.startTime;
        if (dt > 500) return;
        var absDx = Math.abs(dx);
        var absDy = Math.abs(dy);
        // Swipe down to close
        if (dy > 80 && absDx < absDy * 0.6) {
          closeFloatingPlayer();
          gtag('event', 'video_swipe_close', {});
          return;
        }
        // Swipe left/right to navigate
        if (absDx > 60 && absDx > absDy * 1.5) {
