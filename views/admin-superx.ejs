<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <meta name="robots" content="noindex, nofollow">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; background: #0a0a0b; color: #e0e0e0; padding: 20px; }
    .admin-nav { display: flex; gap: 4px; margin-bottom: 24px; background: #1a1a1e; border-radius: 12px; padding: 4px; flex-wrap:wrap; }
    .admin-nav a { padding: 10px 20px; border-radius: 8px; text-decoration: none; color: #6b6b75; font-size: 13px; font-weight: 500; transition: all .2s; }
    .admin-nav a:hover { color: #fff; background: #2a2a30; }
    .admin-nav a.active { color: #fff; background: #ff2d55; }
    h1 { color: #ff2d55; margin-bottom: 20px; font-size: 24px; display:flex;align-items:center;gap:12px;flex-wrap:wrap; }
    h1 small { font-size:14px; font-weight:400; color:#6b6b75; }
    .back-link { color: #ff2d55; text-decoration: none; font-size: 13px; display: inline-block; margin-bottom: 16px; }
    .back-link:hover { text-decoration: underline; }
    .card { background: #1a1a1e; border: 1px solid #2a2a30; border-radius: 12px; padding: 24px; margin-bottom: 20px; }
    .card h2 { font-size: 15px; color: #fff; margin-bottom: 16px; display:flex;align-items:center;gap:8px; }
    .card label { display: block; color: #a0a0a8; font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 4px; margin-top: 14px; }
    .card label:first-child { margin-top: 0; }
    .card input, .card textarea, .card select { width: 100%; padding: 10px 14px; background: #0a0a0b; border: 1px solid #2a2a30; border-radius: 8px; color: #fff; font-size: 13px; font-family: inherit; }
    .card input:focus, .card textarea:focus, .card select:focus { outline: none; border-color: #ff2d55; }
    .card textarea { resize: vertical; font-family: 'Consolas', 'Courier New', monospace; font-size: 12px; }
    .card select { cursor:pointer; }
    .btn { padding: 10px 24px; border-radius: 8px; border: none; font-size: 13px; font-weight: 600; cursor: pointer; transition: all .2s; margin-top: 16px; }
    .btn-primary { background: #ff2d55; color: #fff; }
    .btn-primary:hover { background: #ff4d6f; }
    .btn-secondary { background: #2a2a30; color: #a0a0a8; }
    .btn-secondary:hover { background: #3a3a40; color: #fff; }
    .btn-small { padding: 6px 14px; font-size: 11px; margin-top: 0; }
    .btn-danger { background: #cc2233; color: #fff; }
    .btn-danger:hover { background: #dd3344; }
    .btn-row { display: flex; gap: 12px; margin-top: 20px; }
    .status { padding: 8px 16px; border-radius: 8px; font-size: 13px; margin-bottom: 16px; display: none; }
    .status.success { display: block; background: rgba(52,199,89,0.15); color: #34c759; border: 1px solid rgba(52,199,89,0.3); }
    .status.error { display: block; background: rgba(255,45,85,0.15); color: #ff2d55; border: 1px solid rgba(255,45,85,0.3); }
    .tag-item { display: flex; gap: 8px; align-items: center; padding: 8px; background: #0a0a0b; border: 1px solid #2a2a30; border-radius: 8px; margin-bottom: 6px; }
    .tag-item input { margin-top: 0; }
    .tag-item .drag { color: #6b6b75; cursor: grab; font-size: 16px; user-select:none; }
    .col-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    .col-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 12px; }
    .hint { color: #6b6b75; font-size: 11px; margin-top: 3px; }
    .page-tabs { display:flex; gap:4px; margin-bottom:20px; flex-wrap:wrap; }
    .page-tab { padding: 8px 16px; border-radius: 8px; text-decoration: none; font-size: 12px; font-weight:600; background: #1a1a1e; color: #6b6b75; border:1px solid #2a2a30; transition: all .2s; }
    .page-tab:hover { background: #2a2a30; color:#fff; }
    .page-tab.active { background: #ff2d55; color:#fff; border-color:#ff2d55; }
    .page-tab.main-tab { border-color:rgba(255,215,0,0.3); }
    .page-tab.main-tab.active { background:#ffd700; color:#000; }
    .badge-new { font-size:9px; background:#ff2d55; color:#fff; padding:2px 6px; border-radius:4px; margin-left:4px; }
    .inline-group { display:flex; gap:8px; align-items:center; }
    .inline-group input { flex:1; }
    .ad-zone-row { display:flex; gap:8px; align-items:center; margin-bottom:8px; }
    .ad-zone-row label { margin:0; min-width:80px; text-transform:none; font-weight:400; }
    .ad-zone-row input { flex:1; }
  </style>
</head>
