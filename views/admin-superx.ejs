    }
    function addNicheTag() { if (!mainConfig.nicheTags) mainConfig.nicheTags = []; mainConfig.nicheTags.push({ label: '', cls: 'p' }); renderNicheTagsMain(); }
    function removeNicheTagMain(i) { mainConfig.nicheTags.splice(i, 1); renderNicheTagsMain(); }
    function renderCtaButtonsMain() {
      const el = document.getElementById('ctaList');
      el.innerHTML = (mainConfig.ctaButtons || []).map((b, i) => `
        <div class="tag-item">
          <span class="drag">☰</span>
          <input type="text" value="${escapeHtml(b.label)}" placeholder="Label" style="flex:2" onchange="mainConfig.ctaButtons[${i}].label = this.value">
