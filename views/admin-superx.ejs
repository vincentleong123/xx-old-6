        document.getElementById('cat-indonesian').value = cats.indonesian || '';
        document.getElementById('cat-thai').value = cats.thai || '';
        document.getElementById('cat-milf').value = cats.milf || '';
        document.getElementById('cat-chubby').value = cats.chubby || '';
        document.getElementById('cat-viral').value = cats.viral || '';
        document.getElementById('cat-janda').value = cats.janda || '';
        document.getElementById('cat-kolej').value = cats.kolej || '';
        const az = pageConfig.adZones || {};
        document.getElementById('adTop').value = az.top || '';
        document.getElementById('adSidebar').value = az.sidebar || '';
        document.getElementById('adInline').value = az.inline || '';
        renderNicheTags();
        renderCtaButtons();
      } catch { console.error('Failed to load page config'); }
    }

    function renderNicheTags() {
      const el = document.getElementById('nicheList');
      el.innerHTML = (pageConfig.nicheTags || []).map((t, i) => `
        <div class="tag-item">
          <span class="drag">☰</span>
          <input type="text" value="${escapeHtml(t.label)}" placeholder="Label" style="flex:2" onchange="pageConfig.nicheTags[${i}].label = this.value">
          <input type="text" value="${escapeHtml(t.cls)}" placeholder="CSS class (p/b/l/s)" style="flex:1" onchange="pageConfig.nicheTags[${i}].cls = this.value">
          <button class="btn btn-danger btn-small" onclick="removeNicheTag(${i})">✕</button>
        </div>`).join('');
    }
    function addNicheTag() { if (!pageConfig.nicheTags) pageConfig.nicheTags = []; pageConfig.nicheTags.push({ label: '', cls: 'p' }); renderNicheTags(); }
    function removeNicheTag(i) { pageConfig.nicheTags.splice(i, 1); renderNicheTags(); }
    function renderCtaButtons() {
      const el = document.getElementById('ctaList');
      el.innerHTML = (pageConfig.ctaButtons || []).map((b, i) => `
        <div class="tag-item">
          <span class="drag">☰</span>
          <input type="text" value="${escapeHtml(b.label)}" placeholder="Label" style="flex:2" onchange="pageConfig.ctaButtons[${i}].label = this.value">
          <input type="text" value="${escapeHtml(b.href || '')}" placeholder="href" style="flex:2" onchange="pageConfig.ctaButtons[${i}].href = this.value">
          <input type="text" value="${escapeHtml(b.cls || '')}" placeholder="CSS class" style="flex:1" onchange="pageConfig.ctaButtons[${i}].cls = this.value">
          <button class="btn btn-danger btn-small" onclick="removeCtaBtn(${i})">✕</button>
        </div>`).join('');
    }
    function addCtaBtn() { if (!pageConfig.ctaButtons) pageConfig.ctaButtons = []; pageConfig.ctaButtons.push({ href: '', label: '', cls: 'super-x-btn' }); renderCtaButtons(); }
    function removeCtaBtn(i) { pageConfig.ctaButtons.splice(i, 1); renderCtaButtons(); }

    function escapeHtml(s) { return String(s||'').replace(/"/g,'&quot;').replace(/'/g,'&#39;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

    async function savePageConfig() {
      const st = { s1: document.getElementById('s1').value, s2: document.getElementById('s2').value, s3: document.getElementById('s3').value, s4: document.getElementById('s4').value };
      const ss = { s1: document.getElementById('s1sub').value, s2: document.getElementById('s2sub').value, s3: document.getElementById('s3sub').value, s4: document.getElementById('s4sub').value };
      const cats = {
        tudung: document.getElementById('cat-tudung').value, montok: document.getElementById('cat-montok').value,
        indonesian: document.getElementById('cat-indonesian').value, thai: document.getElementById('cat-thai').value,
        milf: document.getElementById('cat-milf').value, chubby: document.getElementById('cat-chubby').value,
        viral: document.getElementById('cat-viral').value, janda: document.getElementById('cat-janda').value,
        kolej: document.getElementById('cat-kolej').value
      };
      const filterKw = document.getElementById('filterKw').value.split(',').map(s => s.trim()).filter(Boolean);
      const data = {
        title: document.getElementById('title').value,
        metaDesc: document.getElementById('metaDesc').value,
        metaKeywords: document.getElementById('metaKeywords').value,
        filterKw,
        badge: document.getElementById('badge').value, h1: document.getElementById('h1').value,
        h1Sub: document.getElementById('h1Sub').value, subtitle: document.getElementById('subtitle').value,
        nicheTags: pageConfig.nicheTags || [], ctaButtons: pageConfig.ctaButtons || [],
        sectionTitles: st, sectionSubs: ss, cats,
        adZones: {
          top: document.getElementById('adTop').value,
          sidebar: document.getElementById('adSidebar').value,
          inline: document.getElementById('adInline').value
        }
      };
      const status = document.getElementById('status');
      try {
        const res = await fetch('/api/admin/superx-pages/' + SLUG, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) });
        const result = await res.json();
        if (result.success) { status.className = 'status success'; status.textContent = 'Page config saved for /super-x-melayu/' + SLUG + '!'; pageConfig = data; }
        else { status.className = 'status error'; status.textContent = 'Save failed.'; }
      } catch { status.className = 'status error'; status.textContent = 'Network error.'; }
      status.style.display = 'block';
      setTimeout(() => status.style.display = 'none', 5000);
    }

    loadPageConfig();
  </script>
<% } %>
</body>
</html>