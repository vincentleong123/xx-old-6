<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <meta name="robots" content="noindex, nofollow">
  <style>
    *{margin:0;padding:0;box-sizing:border-box}
    body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;background:#0a0a0b;color:#e0e0e0;padding:20px}
    h1{color:#ff2d55;margin-bottom:20px;font-size:24px}
    .admin-nav{display:flex;gap:4px;margin-bottom:24px;background:#1a1a1e;border-radius:12px;padding:4px}
    .admin-nav a{padding:10px 20px;border-radius:8px;text-decoration:none;color:#6b6b75;font-size:13px;font-weight:500;transition:all .2s}
    .admin-nav a:hover{color:#fff;background:#2a2a30}
    .admin-nav a.active{color:#fff;background:#ff2d55}
    .toolbar{display:flex;gap:12px;margin-bottom:16px;align-items:center}
    .btn{padding:8px 16px;border:none;border-radius:8px;font-weight:600;cursor:pointer;font-size:13px;transition:all .2s}
    .btn-primary{background:#ff2d55;color:#fff}
    .btn-primary:hover{background:#ff4d6f}
    .btn-danger{background:#ff4444;color:#fff}
    .btn-danger:hover{background:#ff6666}
    .btn-ghost{background:#2a2a30;color:#a0a0a8}
    .btn-ghost:hover{color:#fff}
    .badge-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:12px}
    .badge-card{background:#1a1a1e;border:1px solid #2a2a30;border-radius:12px;padding:16px;position:relative}
    .badge-card .preview{margin-bottom:12px;display:flex;gap:8px;flex-wrap:wrap}
    .badge-card .id{font-size:10px;color:#6b6b75;font-family:monospace;margin-bottom:4px}
    .badge-card .text{font-size:16px;font-weight:700;margin-bottom:4px}
    .badge-card .meta{font-size:11px;color:#6b6b75}
    .badge-card .meta span{margin-right:12px}
    .badge-card .actions{position:absolute;top:12px;right:12px;display:flex;gap:4px}
    .badge-card .actions button{width:28px;height:28px;border-radius:6px;border:none;cursor:pointer;font-size:12px;transition:all .2s}
    .badge-card .actions .edit-btn{background:#2979ff;color:#fff}
    .badge-card .actions .del-btn{background:#ff4444;color:#fff}
    .badge-card .actions .edit-btn:hover{background:#4a99ff}
    .badge-card .actions .del-btn:hover{background:#ff6666}
    .modal-overlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,0.7);z-index:1000;justify-content:center;align-items:center}
    .modal-overlay.show{display:flex}
    .modal{background:#1a1a1e;border:1px solid #2a2a30;border-radius:16px;padding:24px;width:520px;max-height:80vh;overflow-y:auto}
    .modal h2{margin-bottom:16px;font-size:18px}
    .form-group{margin-bottom:14px}
    .form-group label{display:block;font-size:12px;font-weight:600;color:#a0a0a8;margin-bottom:4px;text-transform:uppercase;letter-spacing:0.3px}
    .form-group input,.form-group select,.form-group textarea{width:100%;padding:8px 12px;border-radius:8px;border:1px solid #2a2a30;background:#0a0a0b;color:#fff;font-size:13px;outline:none}
    .form-group input:focus,.form-group select:focus,.form-group textarea:focus{border-color:#ff2d55}
    .form-group textarea{resize:vertical;min-height:60px;font-family:monospace;font-size:12px}
    .form-row{display:flex;gap:12px}
    .form-row .form-group{flex:1}
    .modal-actions{display:flex;gap:8px;justify-content:flex-end;margin-top:20px}
    .shape-preview{display:inline-flex;align-items:center;gap:4px;font-size:11px;font-weight:700;padding:3px 10px;border-radius:6px}
    .empty{color:#6b6b75;text-align:center;padding:40px;font-size:14px}
    .search-box{flex:1;padding:8px 12px;border-radius:8px;border:1px solid #2a2a30;background:#0a0a0b;color:#fff;font-size:13px;outline:none;max-width:300px}
    .search-box:focus{border-color:#ff2d55}
  </style>
</head>
<body>
  <h1>SEO Keyword Badges</h1>
  <div class="admin-nav">
    <a href="/admin">Dashboard</a>
    <a href="/admin/pages">Pages</a>
    <a href="/admin/videos">Videos</a>
    <a href="/admin/ads">Ads</a>
    <a href="/admin/keywords" class="active">Keywords</a>
    <a href="/admin/super-x">Super X</a>
  </div>
  <div class="toolbar">
    <button class="btn btn-primary" onclick="openModal()">+ Add Badge</button>
    <input class="search-box" id="searchInput" placeholder="Filter badges..." oninput="renderBadges()">
  </div>
  <div class="badge-grid" id="badgeGrid"></div>
  <div id="emptyState" class="empty" style="display:none">No keyword badges yet. Add one to start targeting SEO terms on video thumbnails.</div>

  <!-- Modal -->
  <div class="modal-overlay" id="modal">
    <div class="modal">
      <h2 id="modalTitle">Add Keyword Badge</h2>
      <div class="form-group">
        <label>Badge Text</label>
        <input id="fText" placeholder="e.g. Seks Melayu">
      </div>
      <div class="form-group">
        <label>Match Patterns (JSON array)</label>
        <textarea id="fPatterns" placeholder='["seks","sex","melayu"]'></textarea>
        <div style="font-size:10px;color:#6b6b75;margin-top:4px">Video title/keywords must match ANY of these patterns (case-insensitive)</div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label>Group</label>
          <select id="fGroup">
            <option value="primary">Primary (95%)</option>
            <option value="secondary88">Secondary (88%)</option>
            <option value="secondary71">Secondary (71%)</option>
            <option value="related54">Related (54%)</option>
            <option value="custom">Custom</option>
          </select>
        </div>
        <div class="form-group">
          <label>Priority</label>
          <input id="fPriority" type="number" value="50" min="1" max="100">
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label>Color</label>
          <input id="fColor" type="color" value="#ff2d55">
        </div>
        <div class="form-group">
          <label>Background</label>
          <input id="fBg" placeholder="solid #hex or linear-gradient(...)" value="#ff2d55">
        </div>
      </div>
      <div class="form-group">
        <label>Shape</label>
        <select id="fShape">
          <option value="pill">Pill (rounded)</option>
          <option value="ribbon">Ribbon (diagonal)</option>
          <option value="tag">Tag (left accent)</option>
          <option value="glow">Glow (neon)</option>
          <option value="bracket">Bracket ([text])</option>
          <option value="stamp">Stamp (border)</option>
          <option value="underline">Underline</option>
        </select>
      </div>
      <div class="modal-actions">
        <button class="btn btn-ghost" onclick="closeModal()">Cancel</button>
        <button class="btn btn-primary" id="saveBtn" onclick="saveBadge()">Save</button>
      </div>
    </div>
  </div>

  <script>
    let badges = [];
    let editingId = null;

    async function loadBadges() {
      try {
        const r = await fetch('/api/admin/keywords');
        badges = await r.json();
        renderBadges();
      } catch(e) { document.getElementById('badgeGrid').innerHTML = '<div class="empty">Failed to load</div>'; }
    }

    function getShapeHtml(text, shape, bg, color) {
      const s = text.replace(/'/g,"\\'");
      const b = bg || color || '#6b6b75';
      const c = color || '#fff';
      const style = shape==='ribbon' ? `background:${b};color:${c};transform:skewX(-8deg);display:inline-block;padding:2px 10px;font-size:10px;font-weight:800;text-transform:uppercase` :
                     shape==='pill' ? `background:${b};color:${c};padding:3px 12px;border-radius:999px;font-size:10px;font-weight:700` :
                     shape==='tag' ? `background:${b};color:${c};padding:3px 10px 3px 14px;font-size:10px;font-weight:700;clip-path:polygon(0 50%,10px 0,100% 0,100% 100%,10px 100%)` :
                     shape==='glow' ? `background:${b};color:${c};padding:3px 12px;border-radius:6px;font-size:10px;font-weight:700;box-shadow:0 0 12px ${b}66` :
                     shape==='bracket' ? `color:${b};font-size:10px;font-weight:800;letter-spacing:0.5px` :
                     shape==='stamp' ? `border:2px solid ${b};color:${b};padding:2px 10px;border-radius:4px;font-size:9px;font-weight:800;text-transform:uppercase` :
                     shape==='underline' ? `color:${b};font-size:10px;font-weight:700;border-bottom:2px solid ${b};padding-bottom:1px` :
                     `background:${b};color:${c};padding:3px 10px;border-radius:4px;font-size:10px;font-weight:700`;
      const openTag = shape==='bracket' ? '<span style="color:'+b+';font-size:10px;font-weight:800">[</span>' : '';
      const closeTag = shape==='bracket' ? '<span style="color:'+b+';font-size:10px;font-weight:800">]</span>' : '';
      return openTag + '<span style="'+style+'"><strong>'+s+'</strong></span>' + closeTag;
    }

    function renderBadges() {
      const q = document.getElementById('searchInput').value.toLowerCase();
      const filtered = q ? badges.filter(b => b.text.toLowerCase().includes(q) || (b.patterns||[]).some(p => p.includes(q)) || (b.group||'').includes(q)) : badges;
      const grid = document.getElementById('badgeGrid');
      const empty = document.getElementById('emptyState');
      if (!filtered.length) { grid.innerHTML = ''; empty.style.display = 'block'; return; }
      empty.style.display = 'none';
      grid.innerHTML = filtered.map(b => `
        <div class="badge-card">
          <div class="id">${b.id}</div>
          <div class="preview">${getShapeHtml(b.text, b.shape, b.bg, b.color)}</div>
          <div class="text" style="color:${b.color}">${b.text}</div>
          <div class="meta">
            <span>Group: ${b.group}</span>
            <span>Priority: ${b.priority}</span>
            <span>Shape: ${b.shape}</span>
            <span>Patterns: ${(b.patterns||[]).join(', ')}</span>
          </div>
          <div class="actions">
            <button class="edit-btn" onclick="editBadge('${b.id}')">✎</button>
            <button class="del-btn" onclick="deleteBadge('${b.id}')">✕</button>
          </div>
        </div>
      `).join('');
    }

    function openModal() {
      editingId = null;
      document.getElementById('modalTitle').textContent = 'Add Keyword Badge';
      document.getElementById('fText').value = '';
      document.getElementById('fPatterns').value = '';
      document.getElementById('fGroup').value = 'primary';
      document.getElementById('fPriority').value = '50';
      document.getElementById('fColor').value = '#ff2d55';
      document.getElementById('fBg').value = '#ff2d55';
      document.getElementById('fShape').value = 'pill';
      document.getElementById('saveBtn').textContent = 'Add Badge';
      document.getElementById('modal').classList.add('show');
    }

    function editBadge(id) {
      const b = badges.find(x => x.id === id);
      if (!b) return;
      editingId = id;
      document.getElementById('modalTitle').textContent = 'Edit Keyword Badge';
      document.getElementById('fText').value = b.text || '';
      document.getElementById('fPatterns').value = JSON.stringify(b.patterns || []);
      document.getElementById('fGroup').value = b.group || 'custom';
      document.getElementById('fPriority').value = b.priority || 50;
      document.getElementById('fColor').value = b.color || '#ff2d55';
      document.getElementById('fBg').value = b.bg || b.color || '#ff2d55';
      document.getElementById('fShape').value = b.shape || 'pill';
      document.getElementById('saveBtn').textContent = 'Update';
      document.getElementById('modal').classList.add('show');
    }

    function closeModal() { document.getElementById('modal').classList.remove('show'); }

    async function saveBadge() {
      const text = document.getElementById('fText').value.trim();
      let patterns;
      try { patterns = JSON.parse(document.getElementById('fPatterns').value); }
      catch { alert('Patterns must be valid JSON array'); return; }
      if (!text || !patterns || !patterns.length) { alert('Text and patterns required'); return; }
      const data = {
        text, patterns, group: document.getElementById('fGroup').value,
        priority: parseInt(document.getElementById('fPriority').value) || 50,
        color: document.getElementById('fColor').value,
        bg: document.getElementById('fBg').value || document.getElementById('fColor').value,
        shape: document.getElementById('fShape').value
      };
      try {
        if (editingId) {
          await fetch('/api/admin/keywords/' + editingId, { method: 'PUT', headers: {'Content-Type':'application/json'}, body: JSON.stringify(data) });
        } else {
          await fetch('/api/admin/keywords', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify(data) });
        }
        closeModal();
        await loadBadges();
      } catch(e) { alert('Failed to save'); }
    }

    async function deleteBadge(id) {
      if (!confirm('Delete this keyword badge?')) return;
      try {
        await fetch('/api/admin/keywords/' + id, { method: 'DELETE' });
        await loadBadges();
      } catch(e) { alert('Failed to delete'); }
    }

    loadBadges();
  </script>
</body>
</html>