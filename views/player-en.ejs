  <script>
    function toggleMobileMenu() {
      const panel = document.getElementById('mobileNavPanel');
      const overlay = document.getElementById('navOverlay');
      const btn = document.getElementById('mobileMenuBtn');
      panel.classList.toggle('show');
      overlay.classList.toggle('show');
      btn.setAttribute('aria-expanded', panel.classList.contains('show'));
      document.body.style.overflow = panel.classList.contains('show') ? 'hidden' : '';
    }
    function closeMobileNav() {
      const panel = document.getElementById('mobileNavPanel');
      const overlay = document.getElementById('navOverlay');
      const btn = document.getElementById('mobileMenuBtn');
      panel.classList.remove('show');
      overlay.classList.remove('show');
      btn.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    }
    function h(s) { return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;'); }

    async function markGoodPart(videoId, title) {
      try {
        var v = document.querySelector('.video-player video');
        if (!v) return;
        var t = Math.floor(v.currentTime);
        if (Number.isNaN(t) || t < 0) return;
        var resp = await fetch('/api/goodparts/' + videoId, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ time: t })
        });
        if (!resp.ok) throw new Error();
        var data = await resp.json();
        var btn = document.getElementById('gpMarkBtn');
        try {
          var cr = await fetch('/api/goodparts/' + videoId);
          var cd = await cr.json();
          var total = cd.reduce(function(a, b) { return a + b.votes; }, 0);
          if (btn) btn.textContent = total > 0 ? '\u{1F525} ' + total + ' votes \u2014 Mark Good Part' : '\u{1F48E} Mark Good Part';
        } catch {}
        updateMarkedListUI(videoId);
        toast('\u{1F4CD} ' + (data.location || 'Unknown') + ' marked \u23F1 ' + formatDuration('' + t));
      } catch {}
    }

    async function updateMarkedListUI(videoId) {
      try {
        var resp = await fetch('/api/goodparts/' + videoId);
        if (!resp.ok) throw new Error();
        var data = await resp.json();
        var container = document.getElementById('gpMarkedList');
        if (!container) return;
        if (!data || data.length === 0) { container.innerHTML = ''; return; }
        container.innerHTML = data.map(function(item) {
          return '<span class="gp-marked-item" data-time="' + item.time_sec + '">\u23F1 ' + formatDuration('' + item.time_sec) + ' (\u{1F525} ' + item.votes + ')</span>';
        }).join(' &nbsp; ');
        Array.from(container.querySelectorAll('.gp-marked-item')).forEach(function(el) {
          el.addEventListener('click', function() {
            var v = document.querySelector('.video-player video');
            if (v) { v.currentTime = parseInt(el.dataset.time); v.play(); }
          });
        });
      } catch {}
    }

    function formatDuration(s) {
      s = parseInt(s) || 0;
      var m = Math.floor(s / 60);
      var sec = s % 60;
      return m + ':' + (sec < 10 ? '0' : '') + sec;
    }

    function toast(msg) {
      var t = document.querySelector('.toast');
      if (!t) {
        var el = document.createElement('div');
        el.className = 'toast';
        document.body.appendChild(el);
        t = el;
      }
      t.textContent = msg;
      t.classList.add('show');
      setTimeout(function() { t.classList.remove('show'); }, 2500);
    }

    (function() {
      var videoId = '<%= video.id %>';
      if (videoId) updateMarkedListUI(videoId);
    })();
  </script>
