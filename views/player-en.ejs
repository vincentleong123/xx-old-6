  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    :root {
      --bg: #0a0a0b; --bg2: #111114; --bg3: #18181c; --bg4: #1f1f24;
      --text: #ffffff; --text2: #a0a0a8; --text3: #6b6b75;
      --accent: #ff2d55; --gold: #ffd700; --border: #2a2a30;
    }
    body {
      font-family: 'Inter', -apple-system, sans-serif;
      background: var(--bg); color: var(--text); line-height: 1.5;
    }
    .container { max-width: 1100px; margin: 0 auto; padding: 20px; }
    .header {
      background: var(--bg2); border-bottom: 1px solid var(--border); padding: 14px 0; overflow:hidden;
    }
    @media (max-width:768px) { .header { padding: 8px 0; } }
    .header-inner {
      max-width: 1100px; margin: 0 auto; padding: 0 20px;
      display: flex; align-items: center; gap: 12px;
    }
    .header-actions { margin-left: auto; display: flex; align-items: center; gap: 8px; }
    .logo { color: var(--accent); font-weight: 800; font-size: 20px; text-decoration: none; }
    .logo span { color: var(--text); }
    .back-link { color: var(--text2); text-decoration: none; font-size: 14px; }
    .back-link:hover { color: var(--text); }
    .video-player {
      width: 100%; aspect-ratio: 16/11;
      background: #000; border-radius: 12px; overflow: hidden;
      margin-bottom: 20px;
    }
    .video-player video {
      width: 100%; height: 100%; display: block;
    }
    .video-info { margin-bottom: 24px; }
    .video-info h1 {
      font-size: 22px; font-weight: 700; margin-bottom: 8px;
    }
    .video-info .meta {
      color: var(--text3); font-size: 13px; display: flex; gap: 16px; flex-wrap: wrap;
    }
    .video-info .meta span { display: flex; align-items: center; gap: 4px; }
    @keyframes colorCycle {
      0%   { background: #ff2d55; color: #fff; }
      20%  { background: #ff6b35; color: #fff; }
      40%  { background: #ffd700; color: #000; }
      60%  { background: #00e676; color: #000; }
      80%  { background: #2979ff; color: #fff; }
      100% { background: #ff2d55; color: #fff; }
    }
    .tag-bar {
      display: flex; flex-wrap: wrap; gap: 8px;
      padding: 12px 0; margin-bottom: 8px;
      justify-content: center;
    }
    .tag-bar .pill {
      padding: 6px 16px; border-radius: 20px;
      font-size: 12px; font-weight: 700; text-decoration: none;
      text-transform: uppercase; letter-spacing: 0.5px;
      animation: colorCycle 4s ease-in-out infinite;
      transition: transform 0.15s;
    }
    .tag-bar .pill:hover { transform: scale(1.05); }
    .tag-bar .pill:nth-child(2) { animation-delay: 0.5s; }
    .tag-bar .pill:nth-child(3) { animation-delay: 1s; }
    .tag-bar .pill:nth-child(4) { animation-delay: 1.5s; }
    .tag-bar .pill:nth-child(5) { animation-delay: 2s; }
    .tag-bar .pill:nth-child(6) { animation-delay: 2.5s; }
    .tag-bar .pill:nth-child(7) { animation-delay: 3s; }
    .tag-bar .pill:nth-child(8) { animation-delay: 3.5s; }
    .cat-badge {
      display: inline-block;
      font-size: 11px; font-weight: 700; text-transform: uppercase;
      letter-spacing: 0.5px;
      padding: 3px 10px; border-radius: 10px;
      animation: colorCycle 3s ease-in-out infinite;
    }
    .kw-tag {
      padding: 4px 10px; border-radius: 12px;
      font-size: 11px; text-decoration: none; font-weight: 600;
      animation: colorCycle 5s ease-in-out infinite;
    }
    .kw-tag:nth-child(even) { animation-delay: 1s; }
    .kw-tag:nth-child(3n) { animation-delay: 2s; }
    .video-info .description {
      color: var(--text2); font-size: 14px; line-height: 1.7;
      margin-top: 16px; padding: 16px;
      background: var(--bg2); border: 1px solid var(--border); border-radius: 8px;
    }
    .tags { display: flex; flex-wrap: wrap; gap: 6px; margin: 12px 0; }
    .tag {
      padding: 4px 10px; background: var(--bg3); border: 1px solid var(--border);
      border-radius: 12px; color: var(--text2); font-size: 11px; text-decoration: none;
    }
    .tag:hover { border-color: var(--accent); color: var(--text); }
    h2 { font-size: 18px; font-weight: 700; margin: 24px 0 16px; }
    .video-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
      gap: 12px;
    }
    .video-card {
      display: block;
      background: var(--bg2); border: 1px solid var(--border);
      border-radius: 8px; overflow: hidden; text-decoration: none;
      transition: transform 0.2s, border-color 0.2s;
    }
    .video-card:hover { transform: translateY(-2px); border-color: var(--accent); }
    .video-card .thumb {
      aspect-ratio: 16/11; background: var(--bg3); position: relative; overflow: hidden;
    }
    .video-card .thumb img { width: 100%; height: 100%; object-fit: cover; }
    .card-body { padding: 8px 10px; }
    .card-body .ctitle { font-size: 12px; font-weight: 600; color: var(--text); line-height: 1.3; }
    .footer { margin-top: 40px; text-align: center; color: var(--text3); font-size: 12px; padding: 20px 0; border-top: 1px solid var(--border); }
    .goodpart-area { margin-top: 16px; display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
    .gp-btn {
      padding: 8px 16px; background: var(--accent); border: none; border-radius: 8px;
      color: white; font-weight: 600; font-size: 12px; cursor: pointer; transition: background 0.2s;
    }
    .gp-btn:hover { background: #ff4d6f; }
    .gp-marked-list { display: flex; flex-wrap: wrap; gap: 4px; width: 100%; }
    .gp-marked-item {
      font-size: 10px; padding: 2px 6px; background: var(--accent);
      color: #fff; border-radius: 4px; cursor: pointer; font-weight: 600;
    }
    .gp-marked-item:hover { opacity: 0.8; }
    .toast {
      position: fixed; bottom: 24px; left: 50%; transform: translateX(-50%) translateY(100px);
      padding: 14px 24px; background: var(--bg2); border: 1px solid var(--border);
      border-radius: 12px; color: var(--text); font-weight: 500;
      opacity: 0; transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); z-index: 1000;
    }
    .toast.show { transform: translateX(-50%) translateY(0); opacity: 1; }
    .nav-links { display: flex; gap: 6px; }
    .nav-link { display: flex; align-items: center; gap: 4px; padding: 6px 10px; border-radius: 8px; color: #a0a0a8; text-decoration: none; font-size: 12px; font-weight: 500; transition: all 0.2s; white-space: nowrap; }
    .nav-link:hover { background: #1c1c21; color: #fff; }
    .mobile-hamburger { display:none; width:32px; height:32px; border-radius:8px; background:#141417; border:1px solid #2a2a30; cursor:pointer; padding:0; position:relative; flex-shrink:0; align-items:center; justify-content:center; flex-direction:column; gap:3px; transition:all .2s; }
    .mobile-hamburger:hover { background:#1c1c21; border-color:#3a3a45; }
    .mobile-hamburger span { display:block; width:14px; height:2px; background:#fff; border-radius:2px; transition:all .2s; }
    @media (max-width: 768px) { .nav-links { display: none; } .mobile-hamburger { display:flex; } }
    .mobile-menu-panel { position:fixed; bottom:0; left:0; right:0; z-index:300; background:#0a0a0b; border-top:1px solid #2a2a30; border-radius:16px 16px 0 0; max-height:80vh; overflow-y:auto; transform:translateY(100%); transition:transform 0.3s cubic-bezier(0.33,1,0.68,1); }
    .mobile-menu-panel.show { transform:translateY(0); }
    .mobile-menu-overlay { position:fixed; inset:0; background:rgba(0,0,0,0.6); z-index:299; opacity:0; pointer-events:none; transition:opacity 0.3s; }
    .mobile-menu-overlay.show { opacity:1; pointer-events:auto; }
    .mobile-menu-header { display:flex; align-items:center; justify-content:space-between; padding:16px 20px 12px; border-bottom:1px solid #2a2a30; position:sticky; top:0; background:#0a0a0b; z-index:1; }
    .mobile-menu-title { font-size:16px; font-weight:700; color:#fff; }
    .mobile-menu-close { background:none; border:none; color:#6b6b75; font-size:22px; cursor:pointer; padding:0 4px; line-height:1; transition:color .2s; }
    .mobile-menu-close:hover { color:#fff; }
    .mobile-menu-content { padding:12px 20px 24px; }
    .mobile-section { margin-bottom:16px; }
    .mobile-section:last-child { margin-bottom:0; }
    .mobile-section-title { font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:0.5px; color:#6b6b75; margin-bottom:8px; padding:0 4px; }
    .mobile-link { display:block; width:100%; padding:10px 14px; border-radius:8px; color:#e0e0e0; text-decoration:none; font-size:14px; font-weight:500; transition:all .15s; }
    .mobile-link:hover { background:#141417; color:#fff; }
    @media (max-width:768px) {
      .header .header-actions { display:none; }
      .header-inner { gap:8px; }
    }
    @media (max-width: 640px) {
      .container { padding: 12px; }
      .video-info h1 { font-size: 18px; }
      .video-grid { grid-template-columns: repeat(2, 1fr); }
    }
</style>
<script type="text/javascript" data-cfasync="false" async src="https://poweredby.jads.co/js/jads.js"></script>
</head>
