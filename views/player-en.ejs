  <meta name="googlebot" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1">
  <link rel="canonical" href="<%= siteBase %>/xamateur/<%= video.id %>">
<% var vidSrc = typeof video._rawVideoUrl !== 'undefined' ? video._rawVideoUrl : video.video; %>
  <meta property="og:type" content="video.other">
  <meta property="og:title" content="<%= typeof seoTitle !== 'undefined' ? seoTitle : video.title %>">
  <meta property="og:description" content="<%= seoDesc %>">
  <meta property="og:url" content="<%= siteBase %>/xamateur/<%= video.id %>">
  <meta property="og:image" content="<%= video.thumbnail %>">
  <meta property="og:image:alt" content="<%= video.title %>">
  <meta property="og:image:width" content="1280">
  <meta property="og:image:height" content="720">
  <meta property="article:published_time" content="<%= video.uploaded || new Date().toISOString() %>">
  <meta name="twitter:player:width" content="1920">
  <meta name="twitter:player:height" content="1080">
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "VideoObject",
    "name": "<%= typeof seoTitle !== 'undefined' ? seoTitle : video.title %>",
    "description": "<%= (video.description || (typeof seoTitle !== 'undefined' ? seoTitle : video.title)).replace(/"/g, '&quot;').replace(/\n/g, ' ') %>",
    "thumbnailUrl": "<%= video.thumbnail %>",
    "uploadDate": "<%= video.uploaded %>",
    "contentUrl": "<%= siteBase %><%= vidSrc %>",
    "embedUrl": "<%= siteBase %>/xamateur/<%= video.id %>",
    "mainEntityOfPage": "<%= siteBase %>/xamateur/<%= video.id %>",
    "genre": ["Adult", "<%= video.category || 'Amateur' %>"],
    "keywords": "<%= (video.keywords || []).join(', ') %>",
    "isAccessibleForFree": true,
    "isFamilyFriendly": false,
    "contentRating": "R18+",
    "regionsAllowed": "US",
    "publisher": {
      "@type": "Organization",
      "name": "xAmateur",
      "logo": {
        "@type": "ImageObject",
        "url": "<%= siteBase %>/logo.svg"
      }
    },
    "potentialAction": {
      "@type": "WatchAction",
      "target": "<%= siteBase %>/xamateur/<%= video.id %>"
    }
  }
  </script>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "<%= siteBase %>" },
