<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <meta name="description" content="<%= metaDescription %>">
  <meta name="robots" content="index, follow">
  <meta property="og:title" content="<%= title %>">
  <meta property="og:description" content="<%= metaDescription %>">
  <meta property="og:type" content="website">
  <meta property="og:url" content="<%= typeof canonicalUrl !== 'undefined' ? canonicalUrl : 'https://xmelayu.site/xamateur/real' %>">
  <link rel="canonical" href="<%= typeof canonicalUrl !== 'undefined' ? canonicalUrl : 'https://xmelayu.site/xamateur/real' %>">
  <meta name="juicyads-site-verification" content="46572b6e9c3f0cd05fa280411328c8ff">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "<%= title.replace(/"/g, '&quot;') %>",
    "description": "<%= metaDescription.replace(/"/g, '&quot;') %>",
    "url": "<%= typeof canonicalUrl !== 'undefined' ? canonicalUrl.replace(/"/g, '&quot;') : 'https://xmelayu.site/xamateur/real' %>"
  }
  </script>
  <style>
    .ad-holder { display: flex; align-items: center; justify-content: center; padding: 12px 0; margin: 4px 0; }
    .ad-holder ins { display: block; }
    .ad-holder--strip { gap: 16px; flex-wrap: wrap; padding: 20px 0; margin-top: 8px; border-top: 1px solid rgba(255,255,255,0.05); }

    * { margin: 0; padding: 0; box-sizing: border-box; }
    :root {
      --bg: #0a0a0b; --bg2: #111114; --bg3: #18181c; --bg4: #1f1f24;
      --text: #ffffff; --text2: #a0a0a8; --text3: #6b6b75;
      --accent: #ff2d55; --gold: #ffd700; --border: #2a2a30;
      --green: #00e676;
    }
    body {
      font-family: 'Inter', -apple-system, sans-serif;
      background: var(--bg); color: var(--text); line-height: 1.6;
    }
    .header {
      background: var(--bg2); border-bottom: 1px solid var(--border); padding: 14px 0;
      position: sticky; top: 0; z-index: 100;
    }
    .header-inner {
      max-width: 1200px; margin: 0 auto; padding: 0 20px;
      display: flex; align-items: center; justify-content: space-between;
    }
    .logo { color: var(--green); font-weight: 800; font-size: 20px; text-decoration: none; }
    .logo span { color: var(--text); }
    .nav-link { color: var(--text2); text-decoration: none; font-size: 13px; transition: color 0.2s; }
    .nav-link:hover { color: var(--text); }
    .container { max-width: 1200px; margin: 0 auto; padding: 20px; }
    h1 { font-size: 28px; font-weight: 800; margin-bottom: 8px; }
    .subtitle { color: var(--text2); font-size: 14px; margin-bottom: 24px; }
    .article { color: var(--text2); font-size: 14px; line-height: 1.7; }
    .article h2 { font-size: 20px; font-weight: 700; color: var(--text); margin: 28px 0 12px; }
    .article h3 { font-size: 17px; font-weight: 600; color: var(--text); margin: 22px 0 10px; }
    .article p { margin-bottom: 14px; }
    .article ul { margin: 10px 0 14px 20px; }
    .article ul li { margin-bottom: 6px; }
    .article strong { color: var(--text); }
    .article a { color: var(--green); text-decoration: none; }
    .article a:hover { text-decoration: underline; }
    .highlight-box {
      background: var(--bg3); border: 1px solid var(--border);
      border-radius: 8px; padding: 20px; margin: 20px 0;
    }
    .highlight-box h3 { font-size: 16px; font-weight: 700; color: var(--gold); margin-bottom: 8px; }
    .highlight-box p { margin-bottom: 10px; color: var(--text2); font-size: 13px; }
    .btn {
      display: inline-block; background: var(--green); color: #000;
      padding: 10px 20px; border-radius: 6px; font-weight: 700;
      font-size: 13px; text-decoration: none; transition: background 0.2s;
    }
    .btn:hover { background: #33ff99; }
    .section-title {
      font-size: 18px; font-weight: 700; margin: 36px 0 16px;
      display: flex; align-items: center; gap: 10px;
    }
    .section-title .badge {
      font-size: 10px; font-weight: 700; text-transform: uppercase;
      padding: 3px 8px; border-radius: 4px; letter-spacing: 0.5px;
    }
    .badge-phone { background: var(--green); color: #000; }
    .badge-new { background: var(--accent); color: #fff; }
    .badge-all { background: var(--gold); color: #000; }

    /* Gallery cards */
    .gallery-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
      gap: 16px;
      margin-bottom: 32px;
    }
    .gallery-card {
      display: block; background: var(--bg2); border: 1px solid var(--border);
      border-radius: 12px; overflow: hidden; text-decoration: none;
      transition: transform 0.25s, border-color 0.25s, box-shadow 0.25s;
    }
    .gallery-card:hover {
      transform: translateY(-4px); border-color: var(--green);
      box-shadow: 0 8px 30px rgba(0,230,118,0.12);
    }
    .gallery-card .preview {
      display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 2px;
      aspect-ratio: 16/11; background: var(--bg3); overflow: hidden;
    }
    .gallery-card .preview img {
      width: 100%; height: 100%; object-fit: cover;
    }
    .gallery-card .card-body { padding: 14px; }
    .gallery-card .gtitle {
      font-size: 15px; font-weight: 700; color: var(--text);
      margin-bottom: 4px;
    }
    .gallery-card .gcount {
      font-size: 12px; color: var(--text3);
    }

    /* Video grid (inside gallery) */
    .grid-43 {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: 14px;
    }
    .card-43 {
      display: block; background: var(--bg2); border: 1px solid var(--border);
      border-radius: 10px; overflow: hidden; text-decoration: none;
      transition: transform 0.25s, border-color 0.25s, box-shadow 0.25s;
    }
    .card-43:hover {
      transform: translateY(-4px); border-color: var(--green);
      box-shadow: 0 8px 30px rgba(0,230,118,0.12);
    }
    .card-43 .thumb {
      aspect-ratio: 4/3; background: var(--bg3); position: relative; overflow: hidden;
      display: flex; align-items: center; justify-content: center;
      color: var(--text3); font-size: 38px;
    }
    .card-43 .thumb img {
      width: 100%; height: 100%; object-fit: cover;
      transition: transform 0.4s;
    }
    .card-43:hover .thumb img { transform: scale(1.08); }
    .card-43 .thumb .overlay {
      position: absolute; inset: 0;
      background: linear-gradient(transparent 50%, rgba(0,0,0,0.85));
    }
    .card-43 .views {
      position: absolute; bottom: 6px; right: 6px;
      background: rgba(0,0,0,0.8); color: var(--text);
      font-size: 11px; padding: 2px 7px; border-radius: 4px; font-weight: 600;
    }
    .card-43 .card-body { padding: 10px 12px; }
    .card-43 .ctitle {
      font-size: 13px; font-weight: 600; color: var(--text);
      line-height: 1.3; display: -webkit-box; -webkit-line-clamp: 2;
      -webkit-box-orient: vertical; overflow: hidden;
    }

    /* Carousel for latest */
    .carousel-wrap { position: relative; margin-bottom: 32px; }
    .carousel {
      display: flex; gap: 12px; overflow-x: auto; scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch; padding-bottom: 8px;
      scrollbar-width: thin; scrollbar-color: var(--green) var(--bg3);
    }
    .carousel::-webkit-scrollbar { height: 6px; }
    .carousel::-webkit-scrollbar-track { background: var(--bg3); border-radius: 3px; }
    .carousel::-webkit-scrollbar-thumb { background: var(--green); border-radius: 3px; }
    .carousel-card {
      flex: 0 0 280px; scroll-snap-align: start;
      background: var(--bg2); border: 1px solid var(--border);
      border-radius: 10px; overflow: hidden; text-decoration: none;
      transition: transform 0.2s, border-color 0.2s;
    }
    .carousel-card:hover { transform: translateY(-3px); border-color: var(--green); }
    .carousel-card .thumb {
      aspect-ratio: 4/3; background: var(--bg3); position: relative; overflow: hidden;
      display: flex; align-items: center; justify-content: center;
      color: var(--text3); font-size: 36px;
    }
    .carousel-card .thumb img {
      width: 100%; height: 100%; object-fit: cover;
    }
    .carousel-card .thumb .overlay {
      position: absolute; inset: 0;
      background: linear-gradient(transparent 60%, rgba(0,0,0,0.8));
    }
    .carousel-card .views {
      position: absolute; bottom: 6px; right: 6px;
      background: rgba(0,0,0,0.8); color: var(--text);
      font-size: 11px; padding: 2px 7px; border-radius: 4px; font-weight: 600;
    }
    .carousel-card .card-body { padding: 10px 12px; }
    .carousel-card .ctitle {
      font-size: 13px; font-weight: 600; color: var(--text);
      line-height: 1.3; display: -webkit-box; -webkit-line-clamp: 2;
      -webkit-box-orient: vertical; overflow: hidden;
    }
    .carousel-arrow {
      position: absolute; top: 50%; transform: translateY(-50%);
      width: 36px; height: 36px; border-radius: 50%;
      background: rgba(0,0,0,0.7); border: 1px solid var(--border);
      color: #fff; font-size: 18px; cursor: pointer;
      display: flex; align-items: center; justify-content: center;
      z-index: 10; transition: background 0.2s;
    }
    .carousel-arrow:hover { background: var(--green); }
    .carousel-arrow.left { left: -14px; }
    .carousel-arrow.right { right: -14px; }

    .back-bar {
      display: flex; align-items: center; gap: 12px; margin-bottom: 20px;
    }
    .back-bar a { color: var(--text2); text-decoration: none; font-size: 13px; }
    .back-bar a:hover { color: var(--text); }
    .back-bar .sep { color: var(--text3); font-size: 12px; }

    .footer { margin-top: 40px; text-align: center; color: var(--text3); font-size: 12px; padding: 20px 0; border-top: 1px solid var(--border); }
    .footer a { color: var(--text2); text-decoration: none; }
    .footer a:hover { color: var(--text); }

    @media (max-width: 640px) {
      .container { padding: 12px; }
      h1 { font-size: 22px; }
      .gallery-grid { grid-template-columns: repeat(2, 1fr); gap: 10px; }
      .grid-43 { grid-template-columns: repeat(2, 1fr); gap: 10px; }
      .carousel-card { flex: 0 0 220px; }
      .carousel-arrow { display: none; }
    }
  </style>
</head>
<body>
<!-- display ads only (no popunder) -->
  <div class="header">
    <div class="header-inner">
      <a href="/xamateur/real" class="logo">x<span>Amateur</span> <span style="color:var(--green);font-size:12px;font-weight:600;">REAL</span></a>
      <div>
        <a href="/xamateur/real" class="nav-link">Galleries</a>
        <span style="color:var(--text3);margin:0 8px;font-size:11px;">|</span>
        <a href="/xamateur" class="nav-link">xAmateur Home</a>
        <span style="color:var(--text3);margin:0 8px;font-size:11px;">|</span>
        <a href="/super-x-melayu" class="nav-link" style="color:#ffd700;font-weight:700;">★ Super X Melayu</a>
      </div>
    </div>
  </div>
  <div class="container">
    <% if (!isGallery) { %>
      <!-- REAL HOME PAGE -->
      <h1><%= heading %></h1>
      <div class="subtitle"><%= totalVideos %> authentic phone-recorded amateur videos</div>

      <!-- Article -->
      <div class="article">
        <%- content %>
      </div>

      <div class="ad-holder" style="gap:16px;flex-wrap:wrap;padding:16px 0">
        <ins id="r-h-a1" data-width="300" data-height="250"></ins>
        <script>(adsbyjuicy = window.adsbyjuicy || []).push({'adzone':1118844});</script>
        <ins id="r-h-a2" data-width="300" data-height="250"></ins>
        <script>(adsbyjuicy = window.adsbyjuicy || []).push({'adzone':1118846});</script>
      </div>

      <!-- Gallery Grid -->
      <div class="section-title">
        Browse by Collection <span class="badge badge-phone">PHONE AMATEUR</span>
      </div>
      <div class="gallery-grid">
        <% galleries.forEach(function(g) { %>
          <a href="/xamateur/real/<%= g.slug %>" class="gallery-card">
            <div class="preview">
              <% if (g.previews && g.previews.length >= 3) { %>
                <img src="<%= g.previews[0] %>" alt="<%= cleanAlt(g) %> preview" loading="lazy" decoding="async" onerror="this.style.display='none'">
                <img src="<%= g.previews[1] %>" alt="<%= cleanAlt(g) %> preview" loading="lazy" decoding="async" onerror="this.style.display='none'">
                <img src="<%= g.previews[2] %>" alt="<%= cleanAlt(g) %> preview" loading="lazy" decoding="async" onerror="this.style.display='none'">
              <% } else { %>
                <div style="display:flex;align-items:center;justify-content:center;color:var(--text3);font-size:24px;grid-column:1/-1;">&#x1F4F1;</div>
              <% } %>
            </div>
            <div class="card-body">
              <div class="gtitle"><%= g.title %></div>
              <div class="gcount"><%= g.videoCount %> videos</div>
            </div>
          </a>
        <% }); %>
      </div>

      <!-- Latest video carousel -->
      <div class="section-title">
        Latest Phone Recordings <span class="badge badge-new">NEW</span>
      </div>
      <div class="carousel-wrap">
        <button class="carousel-arrow left" onclick="document.querySelector('.carousel').scrollBy({left:-300,behavior:'smooth'})">&#10094;</button>
        <div class="carousel">
          <% latest.slice(0, 20).forEach(function(v) { %>
            <a href="/xamateur/<%= v.id %>" class="carousel-card">
              <div class="thumb">
                <img src="<%= v.thumbnail || '' %>" alt="<%= cleanAlt(v) %>" loading="lazy" decoding="async" onerror="this.style.display='none'" style="width:100%;height:100%;object-fit:cover;position:absolute;inset:0">
                <div class="overlay"></div>
                <span class="views"><%= (v.views || 0).toLocaleString() %></span>
              </div>
              <div class="card-body">
                <div class="ctitle"><%= v.title %></div>
              </div>
            </a>
          <% }); %>
        </div>
        <button class="carousel-arrow right" onclick="document.querySelector('.carousel').scrollBy({left:300,behavior:'smooth'})">&#10095;</button>
      </div>

    <% } else { %>
      <!-- GALLERY DETAIL PAGE -->
      <div class="back-bar">
        <a href="/xamateur/real">&larr; All Galleries</a>
        <span class="sep">/</span>
        <span style="color:var(--text2);font-size:13px;"><%= gallery.title %></span>
      </div>

      <h1><%= gallery.title %></h1>
      <div class="subtitle"><%= videos.length %> phone-recorded amateur videos</div>

      <div class="article">
        <p><%= gallery.description %></p>
      </div>

      <div class="ad-holder" style="gap:16px;flex-wrap:wrap;padding:16px 0">
        <ins id="r-g-a1" data-width="300" data-height="250"></ins>
        <script>(adsbyjuicy = window.adsbyjuicy || []).push({'adzone':1118840});</script>
        <ins id="r-g-a2" data-width="300" data-height="250"></ins>
        <script>(adsbyjuicy = window.adsbyjuicy || []).push({'adzone':1118844});</script>
      </div>

      <div class="grid-43">
        <% videos.forEach(function(v) { %>
          <a href="/xamateur/<%= v.id %>" class="card-43">
            <div class="thumb">
              <img src="<%= v.thumbnail || '' %>" alt="<%= cleanAlt(v) %>" loading="lazy" decoding="async" onerror="this.style.display='none'">
              <div class="overlay"></div>
              <span class="views"><%= (v.views || 0).toLocaleString() %></span>
            </div>
            <div class="card-body">
              <div class="ctitle"><%= v.title %></div>
            </div>
          </a>
        <% }); %>
      </div>

      <div class="ad-holder ad-holder--strip">
        <ins id="r-g-f1" data-width="300" data-height="250"></ins>
        <script>(adsbyjuicy = window.adsbyjuicy || []).push({'adzone':1118846});</script>
        <ins id="r-g-f2" data-width="300" data-height="250"></ins>
        <script>(adsbyjuicy = window.adsbyjuicy || []).push({'adzone':1118840});</script>
      </div>
    <% } %>

    <%- include('_about') %>
    <div class="footer">
      <p>&copy; 2026 xAmateur &middot; <a href="/xamateur">American Amateur Videos</a> &middot; <a href="/xamateur/real">Real Phone Recordings</a> &middot; All models 18+</p>
    </div>
  </div>
<ins id="1119407" data-width="108" data-height="140"></ins>
<script>(adsbyjuicy = window.adsbyjuicy || []).push({'adzone':1119407});</script>
<!-- JuicyAds Float Ad -->
<script type="text/javascript">juicy_adzone = '1118850';</script>
<script type="text/javascript" src="https://poweredby.jads.co/js/jfc.js" charset="utf-8"></script>
<!-- End JuicyAds Float Ad -->
<!--JuicyAds END-->
</body>
</html>
