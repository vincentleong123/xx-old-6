<!--- Modular Mega Menu Component --->
<div class="mega-menu-overlay" id="megaMenuOverlay"></div>
<div class="mega-menu-panel" id="megaMenuPanel">
  <div class="mega-menu-header">
    <h3>Navigation</h3>
    <button class="mega-menu-close" id="megaMenuClose" aria-label="Close menu">×</button>
  </div>
  <div class="mega-menu-content">
    <div class="mega-menu-column">
      <h4>Discovery</h4>
      <label class="discovery-toggle">
        <input type="checkbox" id="discoveryMode">
        <span class="toggle-slider"></span>
        <span class="toggle-label">Surprise Me</span>
      </label>
      <button class="surprise-btn">🎲 Random</button>
    </div>
    <div class="mega-menu-column">
      <h4>Sort</h4>
      <select class="sort-select">
        <option>Newest</option>
        <option>Trending</option>
        <option>Popular</option>
        <option>A-Z</option>
      </select>
    </div>
    <div class="mega-menu-column">
      <h4>Trending Keywords</h4>
      <div class="keyword-cloud">
        <!-- Populated by JS -->
      </div>
    </div>
    <div class="mega-menu-column">
      <h4>Tags</h4>
      <div class="tag-cloud">
        <!-- Populated by JS -->
      </div>
    </div>
  </div>
  <div class="mega-menu-actions">
    <span id="filterCount">0 filters</span>
    <div>
      <button class="btn-clear">Clear All</button>
      <button class="mega-apply-btn">Apply Filters</button>
    </div>
  </div>
</div>

