<link rel="stylesheet" href="/css/gallery.css?v=<%= typeof cacheVersion!=='undefined'?cacheVersion:'' %>">
<style>
:root{--card-min:230px;--gap:14px}
.hero{text-align:center;padding:40px 20px 28px;position:relative;overflow:hidden;border-radius:16px;margin:0 0 20px;background:linear-gradient(135deg,#0d0d12,#1a0a14);border:1px solid rgba(255,45,85,0.15)}
.hero::before{content:'';position:absolute;inset:0;background:radial-gradient(ellipse at 30% 50%,rgba(255,45,85,0.1),transparent 70%);pointer-events:none}
.hero-badge{display:inline-block;padding:4px 16px;border-radius:999px;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:2px;margin-bottom:12px;background:linear-gradient(90deg,#ff2d55,#ff6b35);color:#fff}
.hero h1{font-size:clamp(28px,5vw,48px);font-weight:900;line-height:1.1;margin-bottom:8px;background:linear-gradient(135deg,#ff2d55,#ff6b35,#ffd700);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.hero p{font-size:clamp(13px,2vw,16px);color:#b0b0b8;max-width:700px;margin:0 auto 12px}
.hero-stats{font-size:13px;color:#6b6b75}
.hero-stats strong{color:#ffd700;font-size:16px}
.content-area{width:100%;max-width:100%}
.grid-43{grid-template-columns:repeat(auto-fill,minmax(var(--card-min),1fr));gap:var(--gap)}
@media(max-width:768px){.grid-43{grid-template-columns:repeat(2,1fr);gap:10px}:root{--card-min:180px}}
@media(max-width:480px){.grid-43{grid-template-columns:repeat(2,1fr);gap:8px}:root{--card-min:160px}}
.card-43 .thumb video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0;transition:opacity 0.35s ease;z-index:2;pointer-events:none}
.card-43:hover .thumb video{opacity:1}
</style>
</head>
<body>
<header class="header">
  <button class="mobile-menu-btn" onclick="toggleMobileMenu()" aria-label="Menu"><span>☰</span></button>
  <a href="/tudung-porn" class="logo"><img src="/logo.svg" alt="xMelayu" class="logo-img" loading="lazy" width="120" height="32"></a>
  <nav class="nav-links" id="navLinks">
    <a href="/" class="nav-link"><span>🏠</span><span>Home</span></a>
    <a href="/tudung-porn" class="nav-link active"><span>🧕</span><span style="background:linear-gradient(135deg,#ff2d55,#ff6b35);-webkit-background-clip:text;-webkit-text-fill-color:transparent;font-weight:800">Tudung Porn</span></a>
    <a href="/super-x-melayu" class="nav-link"><span>🔥</span><span>Super X</span></a>
    <a href="/mega-x-melayu" class="nav-link"><span>🚀</span><span>Mega</span></a>
  </nav>
  <div class="search-wrapper">
    <div class="search-box"><span>🔍</span><input type="text" id="searchInput" placeholder="Search tudung videos..." autocomplete="off"><button id="searchBtn" class="search-btn">Search</button></div>
  </div>
  <div class="header-actions"><a href="/super-x-melayu" class="super-x-mobile-tag">SUPER XMELAYU</a></div>
</header>

<main class="main-content">
  <div class="layout" style="display:block"><div class="content-area">

    <div class="hero">
      <div class="hero-badge">🧕 MALAYSIAN HIJAB</div>
      <h1>Tudung — Malaysian Hijab Videos</h1>
      <p>Malaysian hijab amateur video collection featuring authentic homemade content from Malaysia and Southeast Asia.</p>
      <div class="hero-stats"><strong id="count"><%= totalVideos %></strong> tudung videos — updated daily</div>
    </div>

    <div style="max-width:800px;margin:0 auto 32px;padding:24px;background:var(--bg-card);border-radius:16px;border:1px solid var(--border)">
      <h2 style="font-size:20px;margin-bottom:12px;color:var(--text-primary)">Malaysian Tudung Videos — Authentic Hijab Amateur Content</h2>
      <p style="color:var(--text-secondary);line-height:1.7;margin-bottom:12px">xMelayu features the largest collection of Malaysian tudung and hijab amateur videos online. Our curated library showcases authentic content from Muslim women across Malaysia — from Kuala Lumpur to Penang, Johor to Sabah. Every video in this collection features genuine amateur performances from real Malaysian women who embrace both their faith and their natural desires.</p>
      <p style="color:var(--text-secondary);line-height:1.7;margin-bottom:12px">The Malaysian hijab scene has grown exponentially in recent years, with content ranging from shy first-time performances to experienced creators who know exactly how to captivate their audience. Whether you prefer the innocent charm of a college student in her dormitory or the confident allure of a mature woman after hours, our tudung collection covers every taste and preference.</p>
      <p style="color:var(--text-secondary);line-height:1.7;margin-bottom:0">All videos are carefully categorized and tagged for easy discovery. Browse by location, body type, or specific preferences using our advanced search and filter system. New tudung videos are added daily to ensure fresh content for our visitors. xMelayu is committed to providing the most comprehensive and authentic Malaysian hijab amateur video experience available anywhere online.</p>
    </div>

    <div class="section-header">
      <div class="section-title"><h3>Tudung Malay Hijab Videos</h3><span id="resultInfo">loading...</span></div>
    </div>

    <div class="grid-43" id="videoGrid">
      <% for (let i = 0; i < Math.min(videos.length, 72); i++) { %>
        <% const v = videos[i]; %>
        <a href="/<%= v.id %>" class="card-43" data-id="<%= v.id %>" data-preview="<%= v._rawVideoUrl || v.video || '' %>" style="animation-delay:<%= (i % 8) * 0.04 %>s">
          <div class="thumb">
            <div class="img-shimmer"></div>
            <img src="<%= v.thumbnail %>" alt="<%= cleanAlt(v) %> - xMelayu" loading="<%= i < 6 ? 'eager' : 'lazy' %>" decoding="async" width="320" height="240">
            <video muted loop preload="none" playsinline></video>
            <div class="overlay"></div>
            <span class="views">👁️ <%= v.views %></span>
          </div>
          <div class="card-body">
            <div class="ctitle"><%= v.title %></div>
            <div class="cmeta"><%= v.category %> · <%= v.subTags.slice(0, 2).join(', ') %></div>
          </div>
        </a>
      <% } %>
    </div>

    <div id="loadingIndicator" class="loading-indicator" style="display:none">
      <div class="loading-spinner"></div>
      <span class="loading-indicator-text">Loading more tudung videos...</span>
    </div>
    <div class="scroll-trigger" id="scrollTrigger"></div>

  </div></div>
</main>


<script>
const TUDUNG = <%- JSON.stringify(videos) %>;
const state = { page: 1, loading: false, hasMore: true, limit: 36, query: '' };
function cleanAlt(v) { return (v.id||v.title||'').replace(/-[0-9A-F]{4,}$/i,'').replace(/[-_]/g,' ').replace(/\s+/g,' ').trim(); }
function renderCard(v) {
  return '<a href="/'+v.id+'" class="card-43" data-id="'+v.id+'" data-preview="'+(._rawVideoUrl||||'')+'"><div class="thumb"><div class="img-shimmer"></div><img src="'+v.thumbnail+'" alt="'+cleanAlt(v)+' - xMelayu" loading="lazy" decoding="async" width="320" height="240"><video muted loop preload="none" playsinline></video><div class="overlay"></div><span class="views">👁️ '+v.views+'</span></div><div class="card-body"><div class="ctitle">'+v.title+'</div><div class="cmeta">'+v.category+'</div></div></a>';
}
function showBatch() {
  if (state.loading || !state.hasMore) return;
  state.loading = true;
  const q = state.query.toLowerCase().trim();
  let list = q ? TUDUNG.filter(v => (v.title+' '+v.keywords.join(' ')).toLowerCase().includes(q)) : TUDUNG;
  const start = (state.page - 1) * state.limit;
  const batch = list.slice(start, start + state.limit);
  if (!batch.length) { state.hasMore = false; document.getElementById('loadingIndicator').style.display='none'; state.loading=false; return; }
  const grid = document.getElementById('videoGrid');
  batch.forEach(v => grid.insertAdjacentHTML('beforeend', renderCard(v)));
  document.getElementById('loadingIndicator').style.display = state.hasMore ? 'block' : 'none';
  document.getElementById('resultInfo').textContent = Math.min(start + state.limit, list.length) + ' / ' + list.length;
  if (list.length <= start + state.limit) state.hasMore = false;
  state.page++;
  state.loading = false;
}
function doSearch() {
  state.page = 1; state.hasMore = true;
  document.getElementById('videoGrid').innerHTML = '';
  showBatch();
}
const obs = new IntersectionObserver(e => { if (e[0].isIntersecting) showBatch(); }, { rootMargin: '400px' });
obs.observe(document.getElementById('scrollTrigger'));
document.getElementById('searchBtn')?.addEventListener('click', doSearch);
document.getElementById('searchInput')?.addEventListener('keydown', e => { if (e.key === 'Enter') doSearch(); });
function toggleMobileMenu() {
  const n = document.getElementById('navLinks');
  n.style.display = n.style.display === 'flex' ? 'none' : 'flex';
}
setTimeout(showBatch, 100);
(function(){var m=new Map(),mx=6;function s(v){var e=m.get(v);if(e){e.pause();e.removeAttribute('src');e.load();m.delete(v)}}function p(vid){if(m.has(vid))return;var c=document.querySelector('.card-43[data-id="'+vid+'"]');if(!c)return;var th=c.querySelector('.thumb'),u=c.dataset.preview,vd=th&&th.querySelector('video');if(!vd||!u)return;vd.src=u+'#t=0.06,30';vd.currentTime=0.05;vd.preload='auto';vd.play().catch(function(){});m.set(vid,vd);if(m.size>mx){var o=m.entries().next().value;if(o){o[1].pause();o[1].removeAttribute('src');o[1].load();m.delete(o[0])}}}document.addEventListener('mouseover',function(e){var t=e.target.closest('.card-43');if(!t)return;var id=t.dataset.id;if(id)p(id)});document.addEventListener('mouseout',function(e){var t=e.target.closest('.card-43');if(t&&t.dataset.id)s(t.dataset.id)})})();
</script>
<%- include('chat') %>
</body>
</html>
