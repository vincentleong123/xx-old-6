<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TubeStream - Video Platform</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --primary: #ff0000;
            --dark: #0f0f0f;
            --darker: #030303;
            --gray: #272727;
            --light-gray: #606060;
            --text: #ffffff;
            --text-secondary: #aaaaaa;
            --hover: #3f3f3f;
            --sidebar-width: 240px;
            --header-height: 56px;
        }

        body {
            font-family: 'Roboto', 'Arial', sans-serif;
            background: var(--dark);
            color: var(--text);
            overflow-x: hidden;
        }

        /* Header */
        .header {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            height: var(--header-height);
            background: var(--dark);
            display: flex;
            align-items: center;
            padding: 0 16px;
            z-index: 1000;
            border-bottom: 1px solid var(--gray);
        }

        .menu-btn {
            background: none;
            border: none;
            color: var(--text);
            font-size: 24px;
            cursor: pointer;
            padding: 8px;
            border-radius: 50%;
            transition: background 0.2s;
        }

        .menu-btn:hover {
            background: var(--hover);
        }

        .logo {
            display: flex;
            align-items: center;
            margin-left: 16px;
            font-size: 20px;
            font-weight: bold;
            color: var(--text);
            text-decoration: none;
        }

        .logo-icon {
            color: var(--primary);
            margin-right: 4px;
            font-size: 28px;
        }

        .search-container {
            flex: 1;
            max-width: 640px;
            margin: 0 16px;
            display: none;
        }

        .search-box {
            display: flex;
            background: var(--darker);
            border: 1px solid var(--gray);
            border-radius: 24px;
            overflow: hidden;
        }

        .search-input {
            flex: 1;
            background: transparent;
            border: none;
            padding: 8px 16px;
            color: var(--text);
            font-size: 16px;
            outline: none;
        }

        .search-btn {
            background: var(--gray);
            border: none;
            color: var(--text);
            padding: 8px 20px;
            cursor: pointer;
            border-left: 1px solid var(--gray);
        }

        .header-actions {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .icon-btn {
            background: none;
            border: none;
            color: var(--text);
            font-size: 20px;
            cursor: pointer;
            padding: 8px;
            border-radius: 50%;
            transition: background 0.2s;
            position: relative;
        }

        .icon-btn:hover {
            background: var(--hover);
        }

        .user-avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: var(--primary);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            cursor: pointer;
        }

        /* Mobile Search Overlay */
        .mobile-search {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: var(--dark);
            z-index: 1001;
            display: none;
            flex-direction: column;
            padding: 16px;
        }

        .mobile-search.active {
            display: flex;
        }

        .mobile-search-header {
            display: flex;
            align-items: center;
            gap: 16px;
            margin-bottom: 16px;
        }

        .mobile-search-input {
            flex: 1;
            background: var(--darker);
            border: 1px solid var(--gray);
            border-radius: 24px;
            padding: 12px 16px;
            color: var(--text);
            font-size: 16px;
        }

        /* Sidebar */
        .sidebar {
            position: fixed;
            left: 0;
            top: var(--header-height);
            bottom: 0;
            width: 100%;
            background: var(--dark);
            transform: translateX(-100%);
            transition: transform 0.3s;
            z-index: 999;
            overflow-y: auto;
            padding: 12px 0;
        }

        .sidebar.active {
            transform: translateX(0);
        }

        .sidebar-overlay {
            position: fixed;
            top: var(--header-height);
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0,0,0,0.5);
            display: none;
            z-index: 998;
        }

        .sidebar-overlay.active {
            display: block;
        }

        .nav-section {
            padding: 8px 0;
            border-bottom: 1px solid var(--gray);
        }

        .nav-item {
            display: flex;
            align-items: center;
            padding: 12px 24px;
            color: var(--text);
            text-decoration: none;
            transition: background 0.2s;
            gap: 24px;
        }

        .nav-item:hover {
            background: var(--hover);
        }

        .nav-item.active {
            background: var(--hover);
            font-weight: 500;
        }

        .nav-icon {
            font-size: 24px;
            width: 24px;
            text-align: center;
        }

        .nav-label {
            font-size: 14px;
        }

        .nav-title {
            padding: 8px 24px;
            font-size: 16px;
            font-weight: 500;
            color: var(--text-secondary);
        }

        /* Main Content */
        .main-content {
            margin-top: var(--header-height);
            padding: 16px;
            min-height: calc(100vh - var(--header-height));
        }

        /* Categories */
        .categories {
            display: flex;
            gap: 12px;
            overflow-x: auto;
            padding-bottom: 16px;
            margin-bottom: 16px;
            scrollbar-width: none;
        }

        .categories::-webkit-scrollbar {
            display: none;
        }

        .category-chip {
            background: var(--gray);
            border: 1px solid var(--light-gray);
            color: var(--text);
            padding: 8px 16px;
            border-radius: 18px;
            font-size: 14px;
            white-space: nowrap;
            cursor: pointer;
            transition: all 0.2s;
        }

        .category-chip:hover {
            background: var(--hover);
        }

        .category-chip.active {
            background: var(--text);
            color: var(--dark);
        }

        /* Video Grid */
        .video-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 16px;
        }

        .video-card {
            cursor: pointer;
            transition: transform 0.2s;
        }

        .video-card:hover {
            transform: scale(1.02);
        }

        .thumbnail {
            position: relative;
            width: 100%;
            aspect-ratio: 16/9;
            background: var(--gray);
            border-radius: 12px;
            overflow: hidden;
        }

        .thumbnail img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .duration {
            position: absolute;
            bottom: 8px;
            right: 8px;
            background: rgba(0,0,0,0.8);
            padding: 2px 6px;
            border-radius: 4px;
            font-size: 12px;
            font-weight: 500;
        }

        .video-info {
            display: flex;
            gap: 12px;
            margin-top: 12px;
        }

        .channel-avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: var(--primary);
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            font-size: 14px;
        }

        .video-details {
            flex: 1;
            min-width: 0;
        }

        .video-title {
            font-size: 16px;
            font-weight: 500;
            line-height: 1.4;
            margin-bottom: 4px;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .channel-name, .video-stats {
            font-size: 14px;
            color: var(--text-secondary);
        }

        .video-stats::before {
            content: "•";
            margin: 0 4px;
        }

        /* Video Player Page */
        .video-page {
            display: none;
            margin-top: var(--header-height);
        }

        .video-page.active {
            display: block;
        }

        .player-container {
            position: relative;
            width: 100%;
            aspect-ratio: 16/9;
            background: #000;
        }

        .video-player {
            width: 100%;
            height: 100%;
        }

        .video-controls {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            background: linear-gradient(transparent, rgba(0,0,0,0.8));
            padding: 16px;
            opacity: 0;
            transition: opacity 0.3s;
        }

        .player-container:hover .video-controls {
            opacity: 1;
        }

        .progress-bar {
            width: 100%;
            height: 4px;
            background: rgba(255,255,255,0.3);
            border-radius: 2px;
            margin-bottom: 12px;
            cursor: pointer;
            position: relative;
        }

        .progress-fill {
            height: 100%;
            background: var(--primary);
            border-radius: 2px;
            width: 0%;
            position: relative;
        }

        .progress-handle {
            position: absolute;
            right: -6px;
            top: 50%;
            transform: translateY(-50%);
            width: 12px;
            height: 12px;
            background: var(--primary);
            border-radius: 50%;
            opacity: 0;
            transition: opacity 0.2s, transform 0.2s;
        }

        .progress-bar:hover .progress-handle {
            opacity: 1;
            transform: translateY(-50%) scale(1.2);
        }

        .controls-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .controls-left, .controls-right {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .control-btn {
            background: none;
            border: none;
            color: white;
            font-size: 20px;
            cursor: pointer;
            padding: 4px;
        }

        .video-info-section {
            padding: 16px;
        }

        .video-page-title {
            font-size: 20px;
            font-weight: 600;
            margin-bottom: 12px;
            line-height: 1.3;
        }

        .video-actions {
            display: flex;
            gap: 8px;
            overflow-x: auto;
            padding-bottom: 16px;
            margin-bottom: 16px;
        }

        .action-btn {
            display: flex;
            align-items: center;
            gap: 8px;
            background: var(--gray);
            border: none;
            color: var(--text);
            padding: 8px 16px;
            border-radius: 20px;
            font-size: 14px;
            cursor: pointer;
            white-space: nowrap;
            transition: background 0.2s;
        }

        .action-btn:hover {
            background: var(--hover);
        }

        .channel-info {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 16px 0;
            border-top: 1px solid var(--gray);
            border-bottom: 1px solid var(--gray);
        }

        .channel-details {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .channel-page-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: var(--primary);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
        }

        .channel-meta h3 {
            font-size: 16px;
            margin-bottom: 2px;
        }

        .channel-meta p {
            font-size: 12px;
            color: var(--text-secondary);
        }

        .subscribe-btn {
            background: var(--text);
            color: var(--dark);
            border: none;
            padding: 10px 20px;
            border-radius: 20px;
            font-size: 14px;
            font-weight: 500;
            cursor: pointer;
            transition: background 0.2s;
        }

        .subscribe-btn:hover {
            background: #e0e0e0;
        }

        .subscribe-btn.subscribed {
            background: var(--gray);
            color: var(--text);
        }

        .video-description {
            padding: 16px 0;
            font-size: 14px;
            line-height: 1.6;
            color: var(--text);
        }

        .comments-section {
            padding: 16px;
        }

        .comments-header {
            font-size: 16px;
            margin-bottom: 16px;
        }

        .comment-input {
            display: flex;
            gap: 12px;
            margin-bottom: 24px;
        }

        .comment-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: var(--primary);
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
        }

        .comment-field {
            flex: 1;
        }

        .comment-textarea {
            width: 100%;
            background: transparent;
            border: none;
            border-bottom: 1px solid var(--gray);
            color: var(--text);
            font-size: 14px;
            padding: 8px 0;
            resize: none;
            outline: none;
        }

        .comment-textarea:focus {
            border-bottom-color: var(--text);
        }

        .comment-actions {
            display: flex;
            justify-content: flex-end;
            gap: 8px;
            margin-top: 8px;
            display: none;
        }

        .comment-actions.active {
            display: flex;
        }

        .cancel-btn, .comment-btn {
            padding: 8px 16px;
            border-radius: 20px;
            border: none;
            font-size: 14px;
            cursor: pointer;
        }

        .cancel-btn {
            background: transparent;
            color: var(--text);
        }

        .comment-btn {
            background: var(--primary);
            color: white;
        }

        .comment {
            display: flex;
            gap: 12px;
            margin-bottom: 16px;
        }

        .comment-content h4 {
            font-size: 13px;
            margin-bottom: 4px;
        }

        .comment-content h4 span {
            color: var(--text-secondary);
            font-weight: normal;
            margin-left: 4px;
        }

        .comment-text {
            font-size: 14px;
            line-height: 1.4;
            margin-bottom: 8px;
        }

        .comment-actions-row {
            display: flex;
            gap: 16px;
            font-size: 12px;
            color: var(--text-secondary);
        }

        .comment-action {
            display: flex;
            align-items: center;
            gap: 4px;
            cursor: pointer;
        }

        /* Upload Modal */
        .modal {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0,0,0,0.8);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 2000;
            padding: 16px;
        }

        .modal.active {
            display: flex;
        }

        .modal-content {
            background: var(--dark);
            border-radius: 12px;
            width: 100%;
            max-width: 600px;
            max-height: 90vh;
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }

        .modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 16px;
            border-bottom: 1px solid var(--gray);
        }

        .modal-title {
            font-size: 20px;
            font-weight: 500;
        }

        .close-btn {
            background: none;
            border: none;
            color: var(--text);
            font-size: 24px;
            cursor: pointer;
        }

        .modal-body {
            padding: 24px;
            overflow-y: auto;
        }

        .upload-area {
            border: 2px dashed var(--gray);
            border-radius: 8px;
            padding: 48px 24px;
            text-align: center;
            cursor: pointer;
            transition: border-color 0.2s;
        }

        .upload-area:hover {
            border-color: var(--primary);
        }

        .upload-icon {
            font-size: 48px;
            margin-bottom: 16px;
            color: var(--primary);
        }

        .upload-text {
            font-size: 16px;
            margin-bottom: 8px;
        }

        .upload-hint {
            font-size: 12px;
            color: var(--text-secondary);
        }

        .form-group {
            margin-bottom: 16px;
        }

        .form-label {
            display: block;
            font-size: 12px;
            color: var(--text-secondary);
            margin-bottom: 8px;
            text-transform: uppercase;
        }

        .form-input, .form-textarea {
            width: 100%;
            background: var(--darker);
            border: 1px solid var(--gray);
            border-radius: 4px;
            padding: 12px;
            color: var(--text);
            font-size: 14px;
            outline: none;
        }

        .form-input:focus, .form-textarea:focus {
            border-color: var(--primary);
        }

        .form-textarea {
            resize: vertical;
            min-height: 100px;
        }

        .modal-footer {
            display: flex;
            justify-content: flex-end;
            gap: 12px;
            padding: 16px;
            border-top: 1px solid var(--gray);
        }

        .btn-secondary {
            background: transparent;
            color: var(--text);
            border: none;
            padding: 10px 20px;
            border-radius: 20px;
            cursor: pointer;
        }

        .btn-primary {
            background: var(--primary);
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 20px;
            cursor: pointer;
        }

        /* Desktop Styles */
        @media (min-width: 768px) {
            .search-container {
                display: block;
            }

            .mobile-search-btn {
                display: none;
            }

            .sidebar {
                width: var(--sidebar-width);
                transform: translateX(0);
            }

            .sidebar.collapsed {
                width: 72px;
            }

            .sidebar.collapsed .nav-label,
            .sidebar.collapsed .nav-title {
                display: none;
            }

            .sidebar.collapsed .nav-item {
                flex-direction: column;
                padding: 16px 0;
                gap: 6px;
            }

            .sidebar-overlay {
                display: none !important;
            }

            .main-content {
                margin-left: var(--sidebar-width);
            }

            .main-content.sidebar-collapsed {
                margin-left: 72px;
            }

            .video-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .video-page-content {
                display: grid;
                grid-template-columns: 1fr 400px;
                gap: 24px;
                max-width: 1600px;
                margin: 0 auto;
            }

            .related-videos {
                padding-top: 16px;
            }

            .player-container {
                border-radius: 12px;
                overflow: hidden;
            }
        }

        @media (min-width: 1024px) {
            .video-grid {
                grid-template-columns: repeat(3, 1fr);
            }
        }

        @media (min-width: 1280px) {
            .video-grid {
                grid-template-columns: repeat(4, 1fr);
            }
        }

        /* Animations */
        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.5; }
        }

        .loading {
            animation: pulse 1.5s infinite;
        }

        /* Toast Notification */
        .toast {
            position: fixed;
            bottom: 24px;
            left: 50%;
            transform: translateX(-50%) translateY(100px);
            background: var(--gray);
            color: var(--text);
            padding: 12px 24px;
            border-radius: 8px;
            font-size: 14px;
            z-index: 3000;
            opacity: 0;
            transition: all 0.3s;
        }

        .toast.active {
            transform: translateX(-50%) translateY(0);
            opacity: 1;
        }

        /* Shorts Section */
        .shorts-section {
            margin: 24px 0;
        }

        .shorts-header {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 16px;
            font-size: 20px;
            font-weight: bold;
        }

        .shorts-icon {
            color: var(--primary);
        }

        .shorts-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 12px;
        }

        .short-card {
            aspect-ratio: 9/16;
            background: var(--gray);
            border-radius: 12px;
            overflow: hidden;
            position: relative;
            cursor: pointer;
        }

        .short-card img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .short-info {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            padding: 12px;
            background: linear-gradient(transparent, rgba(0,0,0,0.8));
        }

        .short-title {
            font-size: 14px;
            font-weight: 500;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .short-views {
            font-size: 12px;
            color: var(--text-secondary);
            margin-top: 4px;
        }

        @media (min-width: 768px) {
            .shorts-grid {
                grid-template-columns: repeat(4, 1fr);
            }
        }

        @media (min-width: 1024px) {
            .shorts-grid {
                grid-template-columns: repeat(6, 1fr);
            }
        }
    </style>
</head>
<body>
    <!-- Header -->
    <header class="header">
        <button class="menu-btn" onclick="toggleSidebar()">☰</button>
        <a href="#" class="logo" onclick="showHome()">
            <span class="logo-icon">▶</span>
            <span>TubeStream</span>
        </a>
        
        <div class="search-container">
            <div class="search-box">
                <input type="text" class="search-input" placeholder="Search" id="searchInput">
                <button class="search-btn" onclick="performSearch()">🔍</button>
            </div>
        </div>

        <div class="header-actions">
            <button class="icon-btn mobile-search-btn" onclick="openMobileSearch()">🔍</button>
            <button class="icon-btn" onclick="openUpload()">📹</button>
            <button class="icon-btn">
                <span style="position: absolute; top: 4px; right: 4px; width: 8px; height: 8px; background: var(--primary); border-radius: 50%;"></span>
                🔔
            </button>
            <div class="user-avatar">U</div>
        </div>
    </header>

    <!-- Mobile Search Overlay -->
    <div class="mobile-search" id="mobileSearch">
        <div class="mobile-search-header">
            <button class="icon-btn" onclick="closeMobileSearch()">←</button>
            <input type="text" class="mobile-search-input" placeholder="Search" id="mobileSearchInput">
            <button class="icon-btn" onclick="performMobileSearch()">🔍</button>
        </div>
    </div>

    <!-- Sidebar Overlay -->
    <div class="sidebar-overlay" id="sidebarOverlay" onclick="toggleSidebar()"></div>

    <!-- Sidebar -->
    <nav class="sidebar" id="sidebar">
        <div class="nav-section">
            <a href="#" class="nav-item active" onclick="showHome()">
                <span class="nav-icon">🏠</span>
                <span class="nav-label">Home</span>
            </a>
            <a href="#" class="nav-item" onclick="showShorts()">
                <span class="nav-icon">🎬</span>
                <span class="nav-label">Shorts</span>
            </a>
            <a href="#" class="nav-item">
                <span class="nav-icon">📺</span>
                <span class="nav-label">Subscriptions</span>
            </a>
        </div>
        
        <div class="nav-section">
            <div class="nav-title">You</div>
            <a href="#" class="nav-item">
                <span class="nav-icon">👤</span>
                <span class="nav-label">Your channel</span>
            </a>
            <a href="#" class="nav-item">
                <span class="nav-icon">⏱</span>
