<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title><%= title %></title>
    <meta name="description" content="Watch <%= video.name %> - Premium HD video content">
    <meta name="theme-color" content="#000000">
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="/style.css">
    <style>
    /* ======================================
       ADVANCED RESPONSIVE VIDEO PLAYER
       ====================================== */
    
    :root {
      --accent: #ff6b35;
      --accent-light: #ff8a50;
      --bg-primary: #0a0a0a;
      --bg-secondary: #141414;
      --bg-tertiary: #1a1a1a;
      --text-primary: #ffffff;
      --text-secondary: #aaaaaa;
      --border: rgba(255, 255, 255, 0.06);
      --transition: 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    }
    
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    
    .player-page {
      background: linear-gradient(180deg, var(--bg-primary) 0%, #111 50%, var(--bg-primary) 100%);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      font-family: 'Poppins', sans-serif;
      color: var(--text-primary);
      overflow-x: hidden;
    }
    
    /* ==================== HEADER ==================== */
    .player-header {
      background: rgba(0, 0, 0, 0.95);
      backdrop-filter: blur(20px);
      border-bottom: 1px solid var(--border);
      position: sticky;
      top: 0;
      z-index: 1000;
      padding: 0;
      height: 70px;
    }
    
    .player-header-content {
      max-width: 100%;
      height: 100%;
      padding: 0 clamp(8px, 2.5vw, 20px);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: clamp(8px, 2vw, 16px);
    }
    
    .back-link {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      color: var(--text-primary);
      font-weight: 600;
      font-size: clamp(11px, 2vw, 13px);
      padding: 8px 12px;
      border-radius: 8px;
      transition: all var(--transition);
      text-transform: uppercase;
      letter-spacing: 0.5px;
      white-space: nowrap;
      flex-shrink: 0;
    }
    
    .back-link:hover {
      background: rgba(255, 255, 255, 0.08);
    }
    
    .back-link svg {
      width: clamp(16px, 2vw, 18px);
      height: clamp(16px, 2vw, 18px);
    }
    
    .player-header-title {
      flex: 1;
      min-width: 0;
      display: flex;
      align-items: center;
    }
    
    .player-header-title h1 {
      font-size: clamp(14px, 3vw, 18px);
      font-weight: 700;
      color: var(--text-primary);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    
    .header-info {
      display: flex;
      align-items: center;
      gap: clamp(8px, 2vw, 16px);
      flex-shrink: 0;
    }
    
    .duration-badge {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 6px 12px;
      background: rgba(255, 107, 53, 0.12);
      border: 1px solid rgba(255, 107, 53, 0.25);
      border-radius: 6px;
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
      color: var(--accent);
    }
    
    /* ==================== MAIN LAYOUT ==================== */
    .player-main {
      flex: 1;
      overflow-y: auto;
      overflow-x: hidden;
    }
    
    .player-container {
      max-width: calc(100vw - 32px);
      margin: 0 auto;
      width: 100%;
      padding: 0 clamp(12px, 2.5vw, 24px);
      display: grid;
      grid-template-columns: 1fr minmax(0, clamp(280px, 28vw, 340px));
      gap: clamp(12px, 3vw, 32px);
      grid-auto-flow: dense;
    }
    
    .player-video-section {
      display: flex;
      flex-direction: column;
      gap: clamp(16px, 3vw, 32px);
      grid-column: 1;
    }
    
    /* ==================== VIDEO PLAYER ==================== */
    .video-wrapper {
      border-radius: clamp(12px, 2vw, 20px);
      overflow: hidden;
      background: #000;
      box-shadow: 0 40px 100px rgba(0, 0, 0, 0.9), inset 0 1px 0 rgba(255, 255, 255, 0.05);
      aspect-ratio: 16 / 9;
      position: relative;
      width: 100%;
      max-width: 100%;
    }
    
    .video-container {
      position: relative;
      width: 100%;
      height: 100%;
      background: #000;
    }
    
    .video-player {
      width: 100%;
      height: 100%;
      object-fit: contain;
      background: #000;
    }
    
    .player-overlay {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.7);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 20px;
      z-index: 10;
      opacity: 1;
      transition: opacity var(--transition);
    }
    
    .player-overlay.hidden {
      opacity: 0;
      pointer-events: none;
    }
    
    .loading-spinner {
      width: 60px;
      height: 60px;
      border: 3px solid rgba(255, 255, 255, 0.15);
      border-top-color: var(--accent);
      border-radius: 50%;
      animation: spin 1s linear infinite;
    }
    
    @keyframes spin {
      to { transform: rotate(360deg); }
    }
    
    .player-overlay p {
      color: var(--text-secondary);
      font-size: clamp(13px, 2vw, 15px);
    }
    
    /* ==================== VIDEO INFO CARD ==================== */
    .video-info-card {
      background: rgba(20, 20, 20, 0.8);
      backdrop-filter: blur(20px);
      border: 1px solid var(--border);
      border-radius: clamp(12px, 2vw, 16px);
      padding: clamp(16px, 4vw, 28px);
      display: grid;
      gap: clamp(12px, 3vw, 20px);
    }
    
    .video-title-section {
      display: flex;
      flex-direction: column;
      gap: clamp(8px, 2vw, 12px);
    }
    
    .video-title {
      font-size: clamp(20px, 5vw, 32px);
      font-weight: 800;
      color: var(--text-primary);
      line-height: 1.2;
      word-break: break-word;
    }
    
    .video-meta-line {
      display: flex;
      align-items: center;
      gap: clamp(6px, 2vw, 12px);
      flex-wrap: wrap;
      font-size: clamp(10px, 1.5vw, 12px);
      color: var(--text-secondary);
    }
    
    .meta-item {
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }
    
    .meta-dot {
      width: 3px;
      height: 3px;
      border-radius: 50%;
      background: var(--text-secondary);
    }
    
    .video-badges {
      display: flex;
      gap: clamp(6px, 2vw, 12px);
      flex-wrap: wrap;
    }
    
    .badge {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: clamp(4px, 1vw, 8px) clamp(10px, 2vw, 14px);
      background: rgba(255, 107, 53, 0.15);
      border: 1px solid rgba(255, 107, 53, 0.3);
      border-radius: 6px;
      font-size: clamp(9px, 1.2vw, 11px);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: var(--accent);
      white-space: nowrap;
    }
    
    /* ==================== NLP TAGS CLOUD ==================== */
    .nlp-tags-container {
      margin-top: 12px;
    }
    
    .nlp-tags-label {
      font-size: 11px;
      font-weight: 600;
      color: var(--text-secondary);
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-bottom: 8px;
      display: flex;
      align-items: center;
      gap: 6px;
    }
    
    .nlp-tags-label::before {
      content: '🏷️';
      font-size: 12px;
    }
    
    .nlp-tags {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      margin: 0;
      padding: 0;
      list-style: none;
    }
    
    .nlp-tag {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 6px 12px;
      background: linear-gradient(135deg, rgba(255, 107, 53, 0.12) 0%, rgba(255, 107, 53, 0.08) 100%);
      border: 1px solid rgba(255, 107, 53, 0.2);
      border-radius: 20px;
      font-size: 11px;
      font-weight: 500;
      color: var(--text-secondary);
      white-space: nowrap;
      transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
      cursor: pointer;
      text-decoration: none;
    }
    
    .nlp-tag:hover {
      background: linear-gradient(135deg, rgba(255, 107, 53, 0.25) 0%, rgba(255, 107, 53, 0.15) 100%);
      border-color: rgba(255, 107, 53, 0.4);
      color: var(--accent);
      transform: translateY(-2px);
      box-shadow: 0 4px 12px rgba(255, 107, 53, 0.2);
    }
    
    .nlp-tag::before {
      content: '#';
      font-weight: 700;
      color: var(--accent);
      opacity: 0.7;
    }
    
    /* NLP Tag variations for visual interest */
    .nlp-tag:nth-child(3n) {
      background: linear-gradient(135deg, rgba(99, 102, 241, 0.12) 0%, rgba(99, 102, 241, 0.08) 100%);
      border-color: rgba(99, 102, 241, 0.2);
    }
    
    .nlp-tag:nth-child(3n):hover {
      background: linear-gradient(135deg, rgba(99, 102, 241, 0.25) 0%, rgba(99, 102, 241, 0.15) 100%);
      border-color: rgba(99, 102, 241, 0.4);
      color: #818cf8;
      box-shadow: 0 4px 12px rgba(99, 102, 241, 0.2);
    }
    
    .nlp-tag:nth-child(3n)::before {
      color: #818cf8;
    }
    
    .nlp-tag:nth-child(4n) {
      background: linear-gradient(135deg, rgba(16, 185, 129, 0.12) 0%, rgba(16, 185, 129, 0.08) 100%);
      border-color: rgba(16, 185, 129, 0.2);
    }
    
    .nlp-tag:nth-child(4n):hover {
      background: linear-gradient(135deg, rgba(16, 185, 129, 0.25) 0%, rgba(16, 185, 129, 0.15) 100%);
      border-color: rgba(16, 185, 129, 0.4);
      color: #34d399;
      box-shadow: 0 4px 12px rgba(16, 185, 129, 0.2);
    }
    
    .nlp-tag:nth-child(4n)::before {
      color: #34d399;
    }
    
    /* Mobile responsive NLP tags */
    @media (max-width: 480px) {
      .nlp-tags {
        gap: 6px;
      }
      
      .nlp-tag {
        padding: 5px 10px;
        font-size: 10px;
      }
      
      .nlp-tags-label {
        font-size: 10px;
      }
    }
    
    /* ==================== ACTION BUTTONS ==================== */
    .video-actions {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(100px, 1fr));
      gap: clamp(8px, 2vw, 12px);
    }
    
    .action-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: clamp(4px, 1.5vw, 8px);
      padding: clamp(8px, 2vw, 12px) clamp(16px, 3vw, 24px);
      border-radius: 10px;
      border: none;
      font-size: clamp(11px, 1.5vw, 13px);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      cursor: pointer;
      transition: all var(--transition);
      text-decoration: none;
      flex-wrap: wrap;
    }
    
    .action-btn-primary {
      background: linear-gradient(135deg, var(--accent) 0%, var(--accent-light) 100%);
      color: white;
    }
    
    .action-btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 12px 30px rgba(255, 107, 53, 0.3);
    }
    
    .action-btn-secondary {
      background: rgba(255, 255, 255, 0.08);
      color: var(--text-primary);
      border: 1px solid rgba(255, 255, 255, 0.12);
    }
    
    .action-btn-secondary:hover {
      background: rgba(255, 255, 255, 0.12);
      border-color: rgba(255, 255, 255, 0.2);
    }
    
    .action-btn.active {
      background: linear-gradient(135deg, var(--accent), var(--accent-light));
      color: white;
    }
    
    /* ==================== RECOMMENDED SECTION ==================== */
    .recommended-section {
      display: flex;
      flex-direction: column;
      gap: clamp(12px, 2vw, 16px);
    }
    
    .section-title {
      font-size: clamp(14px, 3vw, 18px);
      font-weight: 800;
      color: var(--text-primary);
      text-transform: uppercase;
      letter-spacing: 1px;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    
    .section-subtitle {
      font-size: clamp(11px, 1.5vw, 12px);
      color: var(--text-secondary);
      text-transform: none;
      letter-spacing: 0;
    }
    
    .recommended-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(clamp(140px, 15vw, 200px), 1fr));
      gap: clamp(12px, 2vw, 16px);
    }
    
    .video-card-mini {
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: clamp(10px, 2vw, 12px);
      overflow: hidden;
      transition: all var(--transition);
      display: flex;
      flex-direction: column;
      cursor: pointer;
      height: 100%;
    }
    
    .video-card-mini:hover {
      background: rgba(255, 255, 255, 0.06);
      border-color: rgba(255, 107, 53, 0.3);
      transform: translateY(-6px);
    }
    
    .video-card-mini-thumb {
      position: relative;
      padding-top: 56.25%;
      background: #000;
      overflow: hidden;
    }
    
    .video-card-mini-thumb img {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform var(--transition);
    }
    
    .video-card-mini:hover .video-card-mini-thumb img {
      transform: scale(1.08);
    }
    
    .video-card-mini-play {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 50px;
      height: 50px;
      background: rgba(255, 107, 53, 0.95);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 24px;
      opacity: 0;
      transition: all var(--transition);
    }
    
    .video-card-mini:hover .video-card-mini-play {
      opacity: 1;
    }
    
    .video-card-mini-info {
      padding: clamp(10px, 2vw, 12px);
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    
    .video-card-mini-title {
      font-size: clamp(11px, 1.5vw, 12px);
      font-weight: 600;
      color: var(--text-primary);
      line-height: 1.3;
      overflow: hidden;
      text-overflow: ellipsis;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
    }
    
    .video-card-mini-meta {
      font-size: clamp(9px, 1.2vw, 10px);
      color: var(--text-secondary);
    }
    
    /* ==================== SIDEBAR ==================== */
    .player-sidebar {
      display: flex;
      flex-direction: column;
      gap: clamp(16px, 3vw, 20px);
      height: fit-content;
      position: sticky;
      top: clamp(80px, 10vw, 100px);
      grid-column: 2;
      grid-row: 1 / -1;
      max-width: 340px;
      width: 100%;
      box-sizing: border-box;
    }
    
    .sidebar-card {
      background: rgba(20, 20, 20, 0.6);
      backdrop-filter: blur(20px);
      border: 1px solid var(--border);
      border-radius: clamp(12px, 2vw, 16px);
      padding: clamp(16px, 3vw, 20px);
      transition: all var(--transition);
    }
    
    .sidebar-card:hover {
      border-color: rgba(255, 107, 53, 0.2);
      background: rgba(20, 20, 20, 0.8);
    }
    
    .card-title {
      font-size: clamp(10px, 1.5vw, 12px);
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: var(--text-secondary);
      margin-bottom: clamp(12px, 2vw, 14px);
    }
    
    /* ==================== STATS CARD ==================== */
    .stats-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: clamp(8px, 2vw, 10px);
    }
    
    .stat-item {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: clamp(4px, 1vw, 6px);
      padding: clamp(12px, 2vw, 14px);
      background: rgba(255, 255, 255, 0.04);
      border-radius: 10px;
      text-align: center;
    }
    
    .stat-icon {
      font-size: clamp(18px, 3vw, 22px);
    }
    
    .stat-label {
      font-size: clamp(8px, 1.2vw, 9px);
      color: var(--text-secondary);
      text-transform: uppercase;
      letter-spacing: 0.5px;
      font-weight: 600;
    }
    
    .stat-value {
      font-size: clamp(12px, 1.8vw, 14px);
      font-weight: 700;
      color: var(--accent);
    }
    
    /* ==================== ACTION BUTTONS SIDEBAR ==================== */
    .action-buttons {
      display: flex;
      flex-direction: column;
      gap: clamp(8px, 1.5vw, 10px);
    }
    
    .sidebar-btn {
      display: flex;
      align-items: center;
      gap: clamp(8px, 1.5vw, 10px);
      padding: clamp(10px, 2vw, 12px) clamp(12px, 2vw, 14px);
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 10px;
      color: var(--text-primary);
      font-size: clamp(11px, 1.5vw, 12px);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      cursor: pointer;
      transition: all var(--transition);
    }
    
    .sidebar-btn:hover {
      background: rgba(255, 107, 53, 0.15);
      border-color: rgba(255, 107, 53, 0.3);
      color: var(--accent);
      transform: translateX(4px);
    }
    
    .sidebar-btn.active {
      background: rgba(255, 107, 53, 0.2);
      border-color: var(--accent);
      color: var(--accent);
    }
    
    /* ==================== MORE VIDEOS ==================== */
    .mini-videos {
      display: flex;
      flex-direction: column;
      gap: clamp(10px, 2vw, 12px);
    }
    
    .mini-video {
      display: flex;
      gap: clamp(8px, 2vw, 10px);
      padding: clamp(10px, 2vw, 12px);
      border-radius: 8px;
      transition: all var(--transition);
      opacity: 0.75;
      text-decoration: none;
      color: var(--text-secondary);
    }
    
    .mini-video:hover {
      background: rgba(255, 255, 255, 0.08);
      opacity: 1;
      gap: 12px;
    }
    
    .mini-thumb {
      width: clamp(45px, 8vw, 55px);
      height: clamp(25px, 5vw, 31px);
      border-radius: 6px;
      overflow: hidden;
      flex-shrink: 0;
      background: #000;
    }
    
    .mini-thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    
    .mini-title {
      font-size: clamp(10px, 1.4vw, 11px);
      line-height: 1.3;
      overflow: hidden;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      flex: 1;
      color: var(--text-primary);
    }
    
    /* ==================== FOOTER ==================== */
    .player-footer {
      background: rgba(0, 0, 0, 0.95);
      border-top: 1px solid var(--border);
      padding: clamp(20px, 4vw, 32px);
      text-align: center;
      margin-top: auto;
    }
    
    .player-footer p {
      color: var(--text-secondary);
      font-size: clamp(11px, 1.5vw, 13px);
    }
    
    /* ==================== TOAST ==================== */
    .toast {
      position: fixed;
      bottom: 40px;
      left: 50%;
      transform: translateX(-50%) translateY(120px);
      background: linear-gradient(135deg, var(--accent) 0%, var(--accent-light) 100%);
      color: white;
      padding: clamp(12px, 2vw, 16px) clamp(20px, 4vw, 28px);
      border-radius: 12px;
      font-size: clamp(12px, 1.5vw, 13px);
      font-weight: 700;
      box-shadow: 0 20px 60px rgba(255, 107, 53, 0.3);
      z-index: 9999;
      opacity: 0;
      transition: all var(--transition);
      pointer-events: none;
      max-width: 90vw;
    }
    
    .toast.show {
      transform: translateX(-50%) translateY(0);
      opacity: 1;
    }
    
    /* ==================== DESKTOP ULTRA-WIDE ==================== */
    @media (min-width: 1400px) {
      .player-container {
        max-width: 2000px;
        grid-template-columns: 1fr 380px;
        padding: clamp(24px, 4vw, 60px);
        gap: clamp(24px, 4vw, 48px);
      }
    }

    @media (min-width: 2000px) {
      .player-container {
        max-width: 2400px;
        grid-template-columns: 3fr 2fr;
      }
    }

    @media (min-width: 2560px) {
      .player-container {
        max-width: 95vw;
        grid-template-columns: 1fr 22%;
        padding-left: 5vw;
        padding-right: 5vw;
      }
    }

    /* ==================== MOBILE STICKY VIDEO ==================== */
    @media (max-width: 1024px) {
      .video-wrapper {
        position: sticky;
        top: 80px;
        z-index: 100;
        margin-bottom: 20px;
      }
      
      .player-container {
        padding-top: 20px;
      }
    }

    /* ==================== TABLET RESPONSIVE ==================== */
    @media (max-width: 1200px) {
      .player-container {
        grid-template-columns: 1fr 280px;
        gap: clamp(20px, 3vw, 30px);
      }
      
      .recommended-grid {
        grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
      }
    }
    
    @media (max-width: 1024px) {
      .player-header-content {
        padding: 0 clamp(12px, 3vw, 24px);
      }
      
      .player-header-title h1 {
        font-size: clamp(13px, 2.5vw, 16px);
      }
      
      .back-link {
        font-size: 11px;
      }
      
      .back-link span {
        display: none;
      }
      
      .player-container {
        grid-template-columns: 1fr;
        gap: clamp(16px, 3vw, 24px);
        padding: clamp(12px, 3vw, 24px);
      }
      
      .player-video-section {
        grid-column: 1;
      }
      
      .player-sidebar {
        position: static;
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: clamp(12px, 2vw, 16px);
        top: auto;
        grid-column: 1;
      }
      
      .sidebar-card:first-child {
        grid-column: 1 / -1;
      }
      
      .recommended-grid {
        grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
      }
      
      .video-title {
        font-size: clamp(18px, 4vw, 26px);
      }
    }
    
    /* ==================== MOBILE RESPONSIVE ==================== */
@media (max-width: 768px) {
      .player-header {
        height: 60px;
      }
      
      .player-header-content {
        padding: 0 clamp(8px, 2vw, 16px);
        gap: 8px;
      }
      
      .player-header-title h1 {
        font-size: clamp(12px, 2vw, 14px);
      }
      
      .duration-badge {
        display: none;
      }
      
      .player-container {
        grid-template-columns: 1fr;
        gap: clamp(8px, 2vw, 12px);
        padding: clamp(8px, 2vw, 12px) clamp(4px, 1vw, 8px);
        padding-top: 4px;
      }
      
      .player-video-section {
        gap: 8px;
        margin-top: 0;
      }
      
      .video-wrapper {
        position: fixed;
        top: 60px;
        left: 0;
        right: 0;
        z-index: 99;
        border-radius: 0;
        margin: 0;
      }
      
      .video-info-card {
        padding: clamp(12px, 3vw, 16px);
        gap: 8px;
        margin-top: 4px;
      }
      
      .video-title {
        font-size: clamp(16px, 4vw, 22px);
      }
      
      .video-actions {
        grid-template-columns: 1fr;
        gap: 6px;
      }
      
      .action-btn {
        padding: clamp(10px, 2.5vw, 12px) clamp(14px, 3vw, 18px);
        font-size: clamp(12px, 2.5vw, 14px);
        min-height: 44px;
      }
      
      .recommended-grid {
        grid-template-columns: repeat(auto-fill, minmax(110px, 1fr));
        gap: clamp(8px, 2vw, 10px);
      }
      
      .player-sidebar {
        grid-template-columns: 1fr;
        gap: clamp(12px, 2vw, 14px);
        margin-top: 60vh;
      }
      
      .stats-grid {
        grid-template-columns: 1fr 1fr;
      }
    }
    
    /* ==================== SMALL MOBILE ==================== */
    @media (max-width: 480px) {
      .player-page {
        padding-top: safe-area-inset(top);
        padding-bottom: safe-area-inset(bottom);
      }
      
      .player-header-content {
        height: 56px;
        padding: 0 8px;
        gap: 6px;
      }
      
      .back-link {
        padding: 6px 8px;
        font-size: 10px;
      }
      
      .player-header-title h1 {
        font-size: 12px;
      }
      
      .player-container {
        padding: 10px;
        gap: 12px;
      }
      
      .video-wrapper {
        border-radius: 8px;
      }
      
      .video-info-card {
        padding: 12px;
        gap: 10px;
      }
      
      .video-title {
        font-size: 18px;
      }
      
      .video-meta-line {
        flex-direction: column;
        gap: 4px;
        align-items: flex-start;
      }
      
      .video-badges {
        gap: 6px;
      }
      
      .badge {
        padding: 4px 8px;
        font-size: 9px;
      }
      
      .nlp-tag {
        font-size: 8px;
        padding: 3px 6px;
      }
      
      .video-actions {
        grid-template-columns: 1fr 1fr;
        gap: 8px;
      }
      
      .action-btn {
        padding: 8px 10px;
        font-size: 10px;
        gap: 4px;
      }
      
      .action-btn span:first-child {
        display: none;
      }
      
      .section-title {
        font-size: 13px;
      }
      
      .recommended-grid {
        grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
        gap: 10px;
      }
      
      .video-card-mini-info {
        padding: 8px;
      }
      
      .video-card-mini-title {
        font-size: 10px;
      }
      
      .player-sidebar {
        grid-template-columns: 1fr;
        gap: 12px;
      }
      
      .sidebar-card {
        padding: 12px;
      }
      
      .card-title {
        font-size: 10px;
        margin-bottom: 10px;
      }
      
      .stats-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 8px;
      }
      
      .stat-item {
        padding: 10px 6px;
      }
      
      .stat-icon {
        font-size: 18px;
      }
      
      .stat-label {
        font-size: 8px;
      }
      
      .stat-value {
        font-size: 11px;
      }
      
      .mini-video {
        padding: 8px;
        gap: 8px;
      }
      
      .mini-thumb {
        width: 45px;
        height: 25px;
      }
      
      .mini-title {
        font-size: 10px;
      }
      
      .toast {
        bottom: 20px;
        font-size: 12px;
        padding: 10px 16px;
      }
      
      .player-footer {
        padding: 16px 10px;
      }
    }
    
    /* ==================== ULTRA SMALL ==================== */
    @media (max-width: 360px) {
      .player-container {
        padding: 8px;
      }
      
      .video-info-card {
        padding: 10px;
      }
      
      .video-title {
        font-size: 16px;
      }
      
      .video-actions {
        grid-template-columns: 1fr;
      }
      
      .recommended-grid {
        grid-template-columns: 1fr;
      }
      
      .stats-grid {
        grid-template-columns: 1fr;
      }
    }
    
    /* ==================== LANDSCAPE MOBILE ==================== */
    @media (max-width: 900px) and (orientation: landscape) {
      .player-header {
        height: 56px;
      }
      
      .player-container {
        grid-template-columns: 1fr;
        gap: 12px;
        padding: 10px;
      }
      
      .video-wrapper {
        aspect-ratio: 16 / 9;
        max-height: 50vh;
      }
      
      .player-sidebar {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 12px;
        max-height: fit-content;
      }
      
      .sidebar-card:first-child {
        grid-column: 1;
      }
    }
    
    /* ==================== HIGH DPI SCREENS ==================== */
    @media (-webkit-min-device-pixel-ratio: 2), (min-resolution: 192dpi) {
      .video-card-mini-title,
      .stat-value,
      .section-title {
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }
    }
    </style>
</head>
<body class="player-page">
    <div class="toast" role="status" aria-live="polite"></div>
    
    <header class="player-header">
        <div class="player-header-content">
            <a href="/" class="back-link">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
                    <path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/>
                </svg>
                <span>Back</span>
            </a>
            <div class="player-header-title">
                <h1><%= video.name %></h1>
            </div>
            <div class="header-info">
                <span class="duration-badge" id="header-duration">--:--</span>
            </div>
        </div>
    </header>
    
    <main class="player-main">
        <div class="player-container">
            <div class="player-video-section">
                <div class="video-wrapper">
                    <div class="video-container">
                        <video 
                            id="main-player"
                            class="video-player"
                            controls
                            preload="metadata"
                            poster="<%= video.thumbnail %>?w=1920&q=90"
                            playsinline>
                            <source src="<%= video.video %>" type="video/mp4">
                        </video>
                        <div class="player-overlay" id="loading-overlay">
                            <div class="loading-spinner"></div>
                            <p>Loading video...</p>
                        </div>
                    </div>
                </div>
                
                <div class="video-info-card">
                    <div class="video-title-section">
                        <h1 class="video-title" id="video-title-main"><%= video.name %></h1>
                        <div class="video-meta-line" id="meta-line">
                            <span class="meta-item">
                                <span id="view-count-meta">0</span> views
                            </span>
                        </div>
                        <div class="video-badges">
                            <span class="badge">🎬 HD Video</span>
                            <span class="badge">MP4</span>
                        </div>
                        <div class="nlp-tags-container">
                            <div class="nlp-tags-label">Related Tags</div>
                            <div class="nlp-tags" id="nlp-tags"></div>
                        </div>
                    </div>
                    <div class="video-actions">
                        <button class="action-btn action-btn-primary" id="like-btn" data-action="like">
                            <span>❤️</span>
                            <span>Like</span>
                        </button>
                        <button class="action-btn action-btn-secondary" id="share-btn" data-action="share">
                            <span>📤</span>
                            <span>Share</span>
                        </button>
                        <button class="action-btn action-btn-secondary" id="save-btn" data-action="save">
                            <span>💾</span>
                            <span>Save</span>
                        </button>
                        <button class="action-btn action-btn-secondary" id="report-btn" data-action="report">
                            <span>⚠️</span>
                            <span>Report</span>
                        </button>
                    </div>
                </div>
                
                <div class="recommended-section">
                    <h2 class="section-title">
                        🎯 Recommended For You
                        <span class="section-subtitle"> based on content</span>
                    </h2>
                    <div class="recommended-grid" id="recommended-grid">
                        <% relatedVideos.slice(0, 8).forEach((relVideo, idx) => { %>
                        <a href="/<%= encodeURIComponent(relVideo.name) %>" class="video-card-mini" data-index="<%= idx %>">
                            <div class="video-card-mini-thumb">
                                <img src="<%= relVideo.thumbnail %>?w=240&q=75" alt="<%= relVideo.name %>" loading="lazy">
                                <div class="video-card-mini-play">▶</div>
                            </div>
                            <div class="video-card-mini-info">
                                <h3 class="video-card-mini-title"><%= relVideo.name %></h3>
                                <div class="video-card-mini-meta">Click to watch</div>
                            </div>
                        </a>
                        <% }); %>
                    </div>
                </div>
            </div>
            
            <aside class="player-sidebar">
                <div class="sidebar-card">
                    <h3 class="card-title">📊 Video Stats</h3>
                    <div class="stats-grid">
                        <div class="stat-item">
                            <span class="stat-icon">👁️</span>
                            <span class="stat-label">Views</span>
                            <span class="stat-value" id="viewCount">0</span>
                        </div>
                        <div class="stat-item">
                            <span class="stat-icon">⏱️</span>
                            <span class="stat-label">Duration</span>
                            <span class="stat-value" id="duration">--:--</span>
                        </div>
                        <div class="stat-item">
                            <span class="stat-icon">✨</span>
                            <span class="stat-label">Quality</span>
                            <span class="stat-value">HD</span>
                        </div>
                        <div class="stat-item">
                            <span class="stat-icon">⚡</span>
                            <span class="stat-label">Status</span>
                            <span class="stat-value" style="color: #4ade80;">Ready</span>
                        </div>
                    </div>
                </div>
                
                <div class="sidebar-card">
                    <h3 class="card-title">⚡ Quick Actions</h3>
                    <div class="action-buttons">
                        <button class="sidebar-btn" id="like-btn-side" data-action="like">
                            ❤️ Like
                        </button>
                        <button class="sidebar-btn" id="save-btn-side" data-action="save">
                            💾 Save
                        </button>
                        <button class="sidebar-btn" id="report-btn-side" data-action="report">
                            ⚠️ Report
                        </button>
                    </div>
                </div>
                
                <div class="sidebar-card">
                    <h3 class="card-title">🔥 More Videos</h3>
                    <div class="mini-videos">
                        <% relatedVideos.slice(8, 11).forEach((relVideo) => { %>
                        <a href="/<%= encodeURIComponent(relVideo.name) %>" class="mini-video">
                            <div class="mini-thumb">
                                <img src="<%= relVideo.thumbnail %>?w=80&q=60" alt="">
                            </div>
                            <div class="mini-title"><%= relVideo.name.substring(0, 30) %>...</div>
                        </a>
                        <% }); %>
                    </div>
                </div>
            </aside>
        </div>
    </main>
    
    <!-- Professional SEO Footer Menu -->
    <%- include('footer-component') %>
    
    <script>
    class VideoPlayerApp {
        constructor() {
            this.video = document.getElementById('main-player');
            this.overlay = document.getElementById('loading-overlay');
            this.state = {
                liked: false,
                saved: false,
                views: this.getViews(),
            };
            this.init();
        }
        
        init() {
            this.setupVideoEvents();
            this.setupActionButtons();
            this.setupNLP();
            this.updateStats();
        }
        
        setupVideoEvents() {
            this.video.addEventListener('canplay', () => {
                this.overlay.classList.add('hidden');
            });
            
            this.video.addEventListener('waiting', () => {
                this.overlay.classList.remove('hidden');
            });
            
            this.video.addEventListener('loadedmetadata', () => {
                this.updateDuration();
                this.overlay.classList.add('hidden');
            });
            
            this.video.muted = true;
            this.video.play().then(() => {
                setTimeout(() => this.video.muted = false, 100);
            }).catch(() => {});
        }
        
        updateDuration() {
            const m = Math.floor(this.video.duration / 60);
            const s = Math.floor(this.video.duration % 60).toString().padStart(2, '0');
            const time = `${m}:${s}`;
            document.getElementById('duration').textContent = time;
            document.getElementById('header-duration').textContent = time;
        }
        
        setupActionButtons() {
            const actions = {
                like: { id: 'like-btn', sideId: 'like-btn-side', emoji: '❤️' },
                save: { id: 'save-btn', sideId: 'save-btn-side', emoji: '💾' },
                share: { id: 'share-btn', emoji: '📤' },
                report: { id: 'report-btn', sideId: 'report-btn-side', emoji: '⚠️' }
            };
            
            Object.entries(actions).forEach(([action, ids]) => {
                [document.getElementById(ids.id), document.getElementById(ids.sideId)].forEach(btn => {
                    if (!btn) return;
                    btn.addEventListener('click', () => this.handleAction(action, btn));
                });
            });
        }
        
        handleAction(action, btn) {
            const messages = {
                like: ['❤️ Liked!', '❤️ Removed'],
                save: ['💾 Saved!', '💾 Removed'],
                share: ['📋 Link copied!'],
                report: ['⚠️ Report submitted']
            };
            
            if (action === 'like' || action === 'save') {
                this.state[action] = !this.state[action];
                btn.classList.toggle('active', this.state[action]);
                const sideBtn = document.getElementById(action === 'like' ? 'like-btn-side' : 'save-btn-side');
                if (sideBtn) sideBtn.classList.toggle('active', this.state[action]);
                this.showToast(messages[action][this.state[action] ? 0 : 1]);
            } else if (action === 'share') {
                const data = { title: document.getElementById('video-title-main').textContent, url: window.location.href };
                navigator.share ? navigator.share(data).catch(() => {}) : (navigator.clipboard.writeText(data.url), this.showToast(messages[action][0]));
            } else if (action === 'report') {
                this.showToast(messages[action][0]);
            }
        }
        
        getViews() {
            const views = JSON.parse(localStorage.getItem('viewCounts') || '{}');
            const name = '<%= video.name %>';
            views[name] = (views[name] || 0) + 1;
            localStorage.setItem('viewCounts', JSON.stringify(views));
            return views[name];
        }
        
        updateStats() {
            document.getElementById('viewCount').textContent = this.state.views.toLocaleString();
            document.getElementById('view-count-meta').textContent = this.state.views.toLocaleString();
        }
        
        setupNLP() {
            const title = '<%= video.name %>'.toLowerCase();
            const keywords = this.extractKeywords(title);
            const tagsContainer = document.getElementById('nlp-tags');
            keywords.forEach(kw => {
                const tag = document.createElement('a');
                tag.className = 'nlp-tag';
                tag.href = `/?search=${encodeURIComponent(kw)}`;
                tag.textContent = kw;
                tag.title = `Search for ${kw}`;
                tagsContainer.appendChild(tag);
            });
        }
        
        extractKeywords(text) {
            const common = ['the', 'a', 'an', 'and', 'or', 'but', 'in', 'on', 'at', 'to', 'for', 'of', 'with', 'by', 'from'];
            return text.split(/[\s\-_]+/)
                .filter(w => w.length > 2 && !common.includes(w))
                .slice(0, 4)
                .map(w => w.replace(/[^a-z0-9]/g, ''));
        }
        
        showToast(msg) {
            const toast = document.querySelector('.toast');
            toast.textContent = msg;
            toast.classList.add('show');
            setTimeout(() => toast.classList.remove('show'), 3000);
        }
    }
    
    new VideoPlayerApp();
    </script>
</body>
</html>